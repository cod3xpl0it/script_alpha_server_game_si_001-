.sidebar{position:fixed;inset:0 auto 0 0;width:218px;background:linear-gradient(180deg,#050b16,#060d19 65%,#040914);border-right:1px solid #10243a;z-index:30;display:flex;flex-direction:column;box-shadow:10px 0 35px rgba(0,0,0,.2)}
.brand{height:72px;display:flex;align-items:center;gap:12px;padding:0 17px;border-bottom:1px solid #10243a}.brand-shield{width:38px;height:44px;display:grid;place-items:center;position:relative}.brand-shield svg{width:38px;height:44px;filter:drop-shadow(0 0 8px rgba(29,216,255,.26))}.brand-title{font-weight:800;letter-spacing:.8px;font-size:16px}.brand-sub{color:#70839a;font-size:9px;letter-spacing:.8px;margin-top:2px}
.nav-scroll{padding:12px 8px 90px;overflow:auto;scrollbar-width:thin;scrollbar-color:#163650 transparent}.nav-section{margin:11px 9px 6px;color:#536a83;font-size:9px;text-transform:uppercase;letter-spacing:1.1px}.nav-item{width:100%;border:0;background:transparent;border-radius:6px;padding:9px 10px;display:flex;align-items:center;gap:10px;color:#90a3b8;cursor:pointer;text-align:left;position:relative}.nav-item:hover{color:#dce9f7;background:#0b1929}.nav-item.active{color:#eef7ff;background:linear-gradient(90deg,#102b4c,#0a1b30);box-shadow:inset 2px 0 0 var(--blue);border:1px solid #153858}.nav-icon{width:18px;text-align:center;color:#7d9ab7;font-size:15px}.nav-item.active .nav-icon{color:var(--cyan)}.nav-badge{margin-left:auto;min-width:20px;padding:1px 6px;border-radius:9px;background:#c70b1d;color:#fff;font-size:10px;font-weight:800;text-align:center}.sidebar-bottom{position:absolute;bottom:0;left:0;right:0;padding:12px;background:linear-gradient(0deg,#050b16 70%,transparent)}.quit-btn{width:100%;border:1px solid #7a2430;background:#1a0e17;color:#ff697a;padding:10px;border-radius:6px;cursor:pointer}.quit-btn:hover{background:#2c111b}
.topbar{position:fixed;left:218px;right:0;top:0;height:72px;z-index:25;background:rgba(3,9,19,.94);backdrop-filter:blur(14px);border-bottom:1px solid #10243a;display:flex;align-items:center;gap:12px;padding:10px 14px}.menu-toggle{display:none;border:1px solid var(--line);background:#0a1727;border-radius:6px;width:38px;height:38px;cursor:pointer}.server-select{height:44px;min-width:210px;border:1px solid #17334e;background:#091526;border-radius:6px;display:flex;align-items:center;gap:8px;padding:0 12px;color:#a8bad0}.server-select strong{color:#e6f2ff;font-weight:600}.status-dot{width:8px;height:8px;background:var(--green);border-radius:50%;box-shadow:0 0 10px var(--green);margin-left:auto}.attack-status{height:48px;min-width:208px;border:1px solid #d8283e;border-radius:6px;background:linear-gradient(90deg,rgba(126,12,29,.38),rgba(49,6,15,.45));display:flex;align-items:center;gap:11px;padding:0 14px;box-shadow:inset 0 0 20px rgba(255,64,87,.08)}.attack-icon{width:31px;height:31px;border-radius:50%;display:grid;place-items:center;border:2px solid var(--red);color:var(--red);font-size:17px}.attack-title{color:#ff6577;font-weight:800;font-size:13px}.attack-sub{font-size:10px;color:#e53f54;margin-top:2px}.top-stats{height:48px;flex:1;border:1px solid #17334e;background:#071322;border-radius:6px;display:grid;grid-template-columns:repeat(3,minmax(145px,1fr));overflow:hidden}.top-stat{display:flex;align-items:center;gap:10px;padding:0 15px;position:relative}.top-stat+.top-stat:before{content:"";position:absolute;left:0;top:9px;bottom:9px;width:1px;background:#17334e}.top-stat-icon{font-size:22px;color:var(--blue)}.top-stat small{display:block;color:#8395aa;font-size:9px;text-transform:uppercase}.top-stat strong{font-size:16px;font-weight:650}.delta{font-size:10px;color:var(--green);background:#0a3425;padding:2px 5px;border-radius:4px;margin-left:6px}.progress-mini{height:4px;border-radius:4px;background:#12253a;margin-top:5px;overflow:hidden}.progress-mini span{display:block;height:100%;background:var(--blue);width:0;transition:width .35s}.notify{width:42px;height:44px;border:1px solid #17334e;background:#071322;border-radius:6px;display:grid;place-items:center;position:relative;color:#8ca2b9}.notify-badge{position:absolute;right:-4px;top:-5px;background:#d80b20;color:#fff;border-radius:10px;padding:1px 5px;font-size:9px;font-weight:800}.profile{height:44px;min-width:175px;border:1px solid #17334e;background:#071322;border-radius:6px;display:flex;align-items:center;gap:9px;padding:0 10px}.avatar{width:30px;height:30px;border:1px solid #46627f;border-radius:50%;display:grid;place-items:center;color:#9eb2c8}.profile strong{display:block;font-size:11px}.profile small{display:block;color:#7087a1;font-size:9px;margin-top:2px}
.app{margin-left:218px;padding:84px 10px 18px;min-width:0}.dashboard-grid{display:grid;grid-template-columns:260px minmax(430px,1.65fr) minmax(330px,1fr);gap:10px;align-items:stretch}.panel{background:linear-gradient(180deg,rgba(8,20,35,.96),rgba(5,14,26,.96));border:1px solid #17334d;border-radius:5px;box-shadow:var(--shadow);min-width:0;overflow:hidden}.panel-head{height:42px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;border-bottom:1px solid #17334d;background:rgba(7,17,31,.72)}.panel-title{font-size:11px;font-weight:750;letter-spacing:.35px;text-transform:uppercase}.panel-title.red{color:#ff566a}.panel-actions{display:flex;gap:5px}.icon-btn{height:25px;min-width:27px;border:1px solid #1b3955;background:#081625;border-radius:4px;color:#7e94aa;cursor:pointer;padding:0 7px}.icon-btn:hover{color:#fff;border-color:#2c5d86}.count-pill{background:#c80b1f;color:#fff;border-radius:4px;min-width:23px;text-align:center;font-weight:800;padding:2px 5px;font-size:10px}
.alerts-panel{grid-column:1;grid-row:1}.alerts-list{padding:8px;min-height:328px}.alert-card{border:1px solid #532334;background:linear-gradient(90deg,rgba(79,19,31,.65),rgba(38,12,20,.55));border-radius:6px;margin-bottom:7px;padding:9px 9px 9px 38px;position:relative;min-height:54px}.alert-card.warning{border-color:#67491d;background:linear-gradient(90deg,rgba(87,55,14,.55),rgba(40,27,10,.5))}.alert-card.resolved{border-color:#194933;background:rgba(8,48,31,.32);opacity:.68}.alert-symbol{position:absolute;left:10px;top:12px;width:19px;height:22px;display:grid;place-items:center;color:var(--red)}.alert-card.warning .alert-symbol{color:var(--yellow)}.alert-card.resolved .alert-symbol{color:var(--green)}.alert-name{color:#ff6575;font-size:11px;font-weight:700;padding-right:42px}.alert-card.warning .alert-name{color:#ffc24e}.alert-card.resolved .alert-name{color:#61d996}.alert-time{position:absolute;right:8px;top:9px;color:#9b8b94;font-size:8px}.alert-desc{color:#ac8791;font-size:9px;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.alert-card.warning .alert-desc{color:#aa9678}.alert-card.resolved .alert-desc{color:#7b9d8e}.alerts-footer{text-align:right;color:#8fa4b9;font-size:9px;padding:4px 5px 2px;cursor:pointer}
.terminal-panel{grid-column:2;grid-row:1}.terminal-shell{height:328px;background:#02070e;display:block;overflow-y:auto;overflow-x:hidden;scrollbar-width:thin;scrollbar-color:#1c4567 #030a12;cursor:text}.terminal-output{padding:10px 12px 0;color:#c8d6e5;font:11px/1.47 "SFMono-Regular",Consolas,"Liberation Mono",monospace;white-space:pre-wrap;overflow:visible;min-height:0}.term-entry{margin:0 0 5px;overflow-wrap:anywhere}.term-entry.system{color:var(--cyan)}.term-entry.info{color:#d5ba5b}.term-entry.danger{color:#ff6273}.term-entry.success{color:#58df92}.term-entry.command{color:#c6d4e2}.term-time{color:#4e6d89;margin-right:6px}.term-prompt{color:#31d07d}.term-path{color:#4da2ff}.terminal-input-row{display:flex;align-items:flex-start;padding:1px 12px 10px;color:#c8d6e5;font:11px/1.47 "SFMono-Regular",Consolas,"Liberation Mono",monospace}.terminal-input-row span{flex:0 0 auto}.terminal-input{flex:1;min-width:1px;border:0;outline:0;background:transparent;color:#e6f3ff;font:inherit;line-height:inherit;padding:0;margin:0;caret-color:#4cff9b}.completion-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:0 12px;color:#7fa0bd;margin:0 0 6px}.terminal-max{position:fixed!important;inset:12px!important;z-index:100!important}.terminal-max .terminal-shell{height:calc(100vh - 56px)!important}
.resources-panel{grid-column:3;grid-row:1}.gauges{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;padding:13px 9px 8px}.gauge{text-align:center;min-width:0}.gauge-label{font-size:9px;color:#a8bacb;margin-bottom:6px}.gauge-ring{--value:0deg;--gauge-color:var(--blue);width:66px;height:66px;border-radius:50%;margin:auto;background:conic-gradient(var(--gauge-color) 0 var(--value),#102339 var(--value) 360deg);display:grid;place-items:center;position:relative;transition:background .4s}.gauge-ring:after{content:"";width:49px;height:49px;border-radius:50%;background:#071321;position:absolute;box-shadow:inset 0 0 9px #000}.gauge-ring strong{position:relative;z-index:1;font-size:14px}.gauge-sub{font-size:8px;color:#7e93aa;margin-top:6px;white-space:nowrap}.chart-wrap{height:122px;margin:7px 10px 10px;border:1px solid #1b3955;border-radius:4px;background:#06111f;padding:4px;position:relative}.chart-wrap canvas{width:100%;height:91px;display:block}.chart-legend{display:flex;justify-content:center;gap:18px;color:#7f94aa;font-size:8px}.legend-dot{width:13px;height:2px;display:inline-block;vertical-align:middle;margin-right:4px}.dot-cpu{background:#2d72ff}.dot-ram{background:#e42a78}.dot-net{background:#3bd471}
.timeline-panel{grid-column:1 / span 1;grid-row:2}.timeline{padding:9px 12px 11px}.timeline-item{display:grid;grid-template-columns:46px 18px 1fr;min-height:46px;position:relative}.timeline-item:not(:last-child) .timeline-node:after{content:"";position:absolute;left:8px;top:17px;bottom:-29px;width:1px;background:#813142}.timeline-time{color:#8599af;font-size:9px;padding-top:4px}.timeline-node{position:relative}.timeline-node:before{content:"";position:absolute;left:3px;top:4px;width:10px;height:10px;border:2px solid #ff485e;background:#0b1725;border-radius:50%;box-shadow:0 0 9px rgba(255,64,87,.35)}.timeline-item.pending .timeline-node:before{border-color:#334a60;box-shadow:none}.timeline-item.done .timeline-node:before{border-color:var(--green);background:#0b2f23}.timeline-copy strong{font-size:10px;font-weight:650}.timeline-copy p{margin:3px 0 0;color:#758aa1;font-size:9px;line-height:1.35}
.network-panel{grid-column:2;grid-row:2}.network-map{height:263px;position:relative;display:grid;grid-template-columns:1fr 1fr 1fr;grid-template-rows:54px 54px 62px 62px;align-items:center;justify-items:center;padding:7px 16px 9px}.net-node{position:relative;z-index:2;border:1px solid #264762;background:#081625;border-radius:7px;padding:6px 10px;min-width:112px;text-align:center;font-size:9px;color:#9eb3c7}.net-node strong{display:block;color:#d5e6f5;font-size:10px;margin-bottom:2px}.net-icon{font-size:17px;color:#2d95ff}.net-node.attacker{border-color:#892a3a;color:#ff6678;background:#260d17}.net-node.attacker .net-icon,.net-node.attacker strong{color:#ff5166}.net-node.server{border-color:#11778c;background:#06202b}.net-node.server .net-icon,.net-node.server strong{color:#21dcff}.net-node.blocked{border-color:#1e6946;background:#09251a}.net-node.blocked .net-icon,.net-node.blocked strong{color:#43df8c}.internet{grid-column:2;grid-row:1}.attacker{grid-column:2;grid-row:2}.firewall{grid-column:2;grid-row:3}.server{grid-column:2;grid-row:4}.admin-node{grid-column:1;grid-row:4}.db-node{grid-column:3;grid-row:4}.net-line{position:absolute;background:#446681;opacity:.75;z-index:1}.line-v1{width:1px;height:31px;left:50%;top:43px}.line-v2{width:1px;height:31px;left:50%;top:96px}.line-v3{width:1px;height:30px;left:50%;top:155px}.line-left{height:1px;width:26%;left:24%;top:222px;transform:rotate(-13deg);transform-origin:right}.line-right{height:1px;width:26%;right:24%;top:222px;transform:rotate(13deg);transform-origin:left}.net-pulse{position:absolute;width:6px;height:6px;border-radius:50%;background:var(--red);left:calc(50% - 3px);top:68px;z-index:3;box-shadow:0 0 8px var(--red);animation:pulseMove 2s linear infinite}@keyframes pulseMove{0%{transform:translateY(0);opacity:1}100%{transform:translateY(80px);opacity:0}}.net-pulse.safe{background:var(--green);box-shadow:0 0 8px var(--green)}
.process-panel{grid-column:3;grid-row:2}.process-table{padding:9px}.process-head,.process-row{display:grid;grid-template-columns:1fr 48px 58px 48px;gap:7px;align-items:center}.process-head{color:#748aa1;font-size:8px;padding:0 8px 7px;text-transform:uppercase}.process-row{min-height:35px;border:1px solid #102a42;border-radius:4px;margin-bottom:4px;padding:0 8px;color:#9fb2c5;font-size:9px;background:#081523}.process-row.danger{border-color:#5e2030;background:#39121d;color:#ff6c7c}.process-name{display:flex;align-items:center;gap:7px}.proc-dot{width:13px;height:13px;border-radius:3px;border:1px solid #3b5b77;display:grid;place-items:center;font-size:8px;color:#84a4c1}.process-row.danger .proc-dot{border-color:#ff4057;color:#ff4057}.process-footer{text-align:right;color:#8fa4ba;font-size:9px;padding:6px 2px;cursor:pointer}
.logs-panel{grid-column:1 / span 2;grid-row:3}.log-filters{display:flex;gap:5px;align-items:center}.filter-chip{border:1px solid #203a52;background:#081625;color:#71879d;border-radius:10px;padding:2px 7px;font-size:8px;cursor:pointer}.filter-chip.active{color:#d5e5f4;border-color:#315a7d}.log-list{padding:8px 10px;max-height:174px;overflow:auto}.log-row{display:grid;grid-template-columns:52px 48px 1fr;gap:8px;align-items:center;border:1px solid #142b41;background:#081523;border-radius:3px;min-height:28px;margin-bottom:4px;padding:0 7px;font:9px "SFMono-Regular",Consolas,monospace}.log-row.critical{background:#34131d;border-color:#51202c;color:#ff6b78}.log-row.warning{background:#322511;border-color:#4c391b;color:#ffca5a}.log-row.success{background:#0c291c;border-color:#15442f;color:#69dc9d}.log-level{font-family:Inter,system-ui,sans-serif;font-size:7px;font-weight:800;border-radius:3px;padding:2px 4px;text-align:center;background:#20354a;color:#b7cada}.log-row.critical .log-level{background:#df223b;color:#fff}.log-row.warning .log-level{background:#f1b92d;color:#221600}.log-row.success .log-level{background:#1eae64;color:#fff}
.intel-panel{grid-column:3;grid-row:3}.intel-table{padding:8px}.intel-head,.intel-row{display:grid;grid-template-columns:1.2fr .55fr 1fr .52fr .62fr;gap:5px;align-items:center}.intel-head{color:#72889e;font-size:7px;padding:0 5px 6px}.intel-row{min-height:29px;border-bottom:1px solid #102940;padding:0 5px;font-size:8px;color:#a5b8cb}.ioc{display:flex;align-items:center;gap:5px}.ioc-icon{color:var(--red)}.action-dot{width:6px;height:6px;border-radius:50%;display:inline-block;margin-right:4px;background:var(--red)}.action-dot.green{background:var(--green)}
.missions-panel{grid-column:1 / -1;grid-row:4}.mission-layout{display:grid;grid-template-columns:minmax(310px,.8fr) minmax(520px,1.4fr);gap:0}.mission-list{padding:10px 12px;border-right:1px solid #17334d}.mission-item{display:flex;align-items:center;gap:8px;margin:7px 0;color:#899db2;font-size:10px}.mission-check{width:14px;height:14px;border:1px solid #556e86;border-radius:50%;display:grid;place-items:center;font-size:9px}.mission-item.done{color:#73dca1}.mission-item.done .mission-check{border-color:var(--green);background:var(--green);color:#03160d}.mission-item.active{color:#edf6ff}.mission-item.active .mission-check{border-color:var(--blue);box-shadow:0 0 7px rgba(22,140,255,.45)}.mission-progress{margin-top:12px}.mission-progress-label{display:flex;justify-content:space-between;color:#8095aa;font-size:8px}.mission-progress-bar{height:6px;background:#10243a;border-radius:5px;margin-top:6px;overflow:hidden}.mission-progress-bar span{display:block;height:100%;width:0;background:linear-gradient(90deg,#21c66e,#7ee22d);transition:width .4s}.quick-runbook{padding:10px 12px}.runbook-title{font-size:10px;color:#d7e7f5;margin-bottom:7px}.quick-steps{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.quick-step{border:1px solid #1b3955;background:#081625;border-radius:5px;padding:8px;min-height:69px}.quick-step strong{display:block;color:#ffbf35;font-size:8px;text-transform:uppercase;margin-bottom:5px}.quick-step p{font-size:8px;line-height:1.35;color:#8297ad;margin:0 0 5px}.command-chip{display:block;width:100%;border:1px solid #24516f;background:#06121e;border-radius:4px;color:#9ec2db;padding:4px 6px;text-align:left;font:8px "SFMono-Regular",Consolas,monospace;cursor:pointer;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.command-chip:before{content:"$ ";color:var(--green)}.command-chip:hover{color:#fff;border-color:#1dd8ff}
.drawer{position:fixed;top:0;right:0;width:min(620px,94vw);height:100vh;background:#06101d;border-left:1px solid #235174;z-index:120;box-shadow:-22px 0 60px rgba(0,0,0,.55);transform:translateX(102%);transition:transform .25s;display:flex;flex-direction:column}.drawer.open{transform:translateX(0)}.drawer-head{height:62px;border-bottom:1px solid #17334d;display:flex;align-items:center;justify-content:space-between;padding:0 16px}.drawer-head h2{font-size:14px;margin:0;color:#e4f2ff}.drawer-body{padding:12px 14px 30px;overflow:auto}.runbook-intro{border:1px solid #1b3955;background:#081625;border-radius:6px;padding:10px;color:#93a9be;font-size:10px;line-height:1.5;margin-bottom:10px}.method{border:1px solid #1b3955;border-radius:6px;background:#071522;margin-bottom:8px;overflow:hidden}.method summary{cursor:pointer;padding:10px 11px;color:#d8e7f5;font-size:10px;font-weight:700;list-style:none;display:flex;justify-content:space-between}.method summary:after{content:"+";color:var(--green);font-size:15px}.method[open] summary:after{content:"−"}.method-body{border-top:1px solid #17334d;padding:9px}.method-when{color:#8da3b8;font-size:9px;line-height:1.45;margin-bottom:8px}.method-step{border-left:2px solid #275579;padding-left:8px;margin:8px 0}.method-step strong{display:block;font-size:8px;text-transform:uppercase;color:#ffc048;margin-bottom:4px}.method-step p{color:#7e94aa;font-size:8px;line-height:1.4;margin:4px 0}.overlay{position:fixed;inset:0;background:rgba(0,4,10,.7);z-index:110;opacity:0;pointer-events:none;transition:opacity .2s}.overlay.open{opacity:1;pointer-events:auto}
.modal{position:fixed;inset:0;background:radial-gradient(circle at 50% 22%,rgba(16,58,94,.38),transparent 35%),rgba(1,5,11,.94);z-index:200;display:grid;place-items:center;padding:18px}.modal-card{width:min(490px,100%);border:1px solid #245174;background:linear-gradient(180deg,#09182a,#050d18);border-radius:9px;box-shadow:0 25px 90px #000;padding:24px}.modal-logo{display:flex;align-items:center;gap:12px;margin-bottom:15px}.modal-logo .brand-shield{width:48px;height:55px}.modal-card h1{font-size:21px;margin:0;letter-spacing:.8px}.modal-card h2{font-size:18px;margin:0 0 8px}.modal-card p{color:#91a6bb;line-height:1.55;font-size:11px}.modal-card label{display:block;color:#b7c9d9;font-size:10px;margin:16px 0 6px}.modal-card input{width:100%;border:1px solid #254b69;background:#030914;color:#edf7ff;border-radius:5px;padding:11px 12px;outline:0}.modal-card input:focus{border-color:#1ba4e9;box-shadow:0 0 0 2px rgba(27,164,233,.12)}.primary-btn{width:100%;border:0;border-radius:5px;background:linear-gradient(90deg,#0d7ee8,#18b3e8);color:#fff;padding:11px;font-weight:750;cursor:pointer;margin-top:12px}.primary-btn:hover{filter:brightness(1.08)}.modal-notes{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:14px}.modal-note{border:1px solid #17334d;background:#071321;border-radius:5px;text-align:center;padding:7px;color:#758da5;font-size:8px}.result-score{font-size:28px;color:#fff;font-weight:800;margin:15px 0 5px}.ranking-list{max-height:280px;overflow:auto;margin-top:12px}.rank-row{display:grid;grid-template-columns:30px 1fr 75px;gap:7px;padding:8px;border-bottom:1px solid #163048;font-size:10px}.rank-row span:last-child{text-align:right;color:#ffbf35}
.toast{position:fixed;right:18px;bottom:18px;z-index:180;background:#0a1a2b;border:1px solid #2b5777;border-radius:5px;padding:10px 13px;box-shadow:var(--shadow);color:#c8d9e9;font-size:10px;transform:translateY(25px);opacity:0;pointer-events:none;transition:.2s}.toast.show{transform:none;opacity:1}
@media(max-width:1320px){.topbar{gap:8px}.profile{min-width:45px}.profile-copy{display:none}.dashboard-grid{grid-template-columns:245px minmax(400px,1.4fr) minmax(300px,.95fr)}.gauges{grid-template-columns:repeat(2,1fr)}.gauge:nth-child(n+3){margin-top:6px}.chart-wrap{height:100px}.chart-wrap canvas{height:69px}}

/* Primeira fase: caixa de entrada corporativa */
.mail-stage{min-height:100vh;background:radial-gradient(circle at 75% -10%,rgba(20,112,180,.2),transparent 34%),linear-gradient(145deg,#020610,#07101d 58%,#020711);padding:18px;display:flex;flex-direction:column}.mail-topbar{height:62px;border:1px solid #17334d;background:rgba(5,14,26,.96);border-radius:8px 8px 0 0;display:flex;align-items:center;gap:14px;padding:0 16px;box-shadow:var(--shadow)}.mail-logo{display:flex;align-items:center;gap:10px;min-width:210px}.mail-logo-mark{width:34px;height:34px;border-radius:8px;background:linear-gradient(145deg,#0d74d9,#18c2e9);display:grid;place-items:center;font-size:18px;font-weight:900;box-shadow:0 0 18px rgba(29,216,255,.22)}.mail-search{flex:1;max-width:620px;height:38px;border:1px solid #1b3955;background:#061221;border-radius:6px;color:#8197ad;display:flex;align-items:center;padding:0 12px;gap:8px}.mail-day{margin-left:auto;text-align:right}.mail-day small{display:block;color:#7087a1;font-size:9px;text-transform:uppercase;letter-spacing:.8px}.mail-day strong{font:700 18px/1 "SFMono-Regular",Consolas,monospace;color:#eaf7ff}.mail-shell{flex:1;min-height:620px;border:1px solid #17334d;border-top:0;background:rgba(4,12,22,.97);display:grid;grid-template-columns:210px 340px minmax(420px,1fr);overflow:hidden;border-radius:0 0 8px 8px}.mail-nav{border-right:1px solid #17334d;padding:14px 10px;background:#050d19}.compose-btn{width:100%;height:39px;border:0;border-radius:6px;background:linear-gradient(90deg,#0d7ee8,#18b3e8);font-weight:800;cursor:pointer;margin-bottom:14px}.mail-folder{display:flex;align-items:center;gap:9px;padding:9px 10px;border-radius:5px;color:#8ca2b9;font-size:11px}.mail-folder.active{background:#0d2742;color:#eaf6ff;border:1px solid #17466c}.mail-folder b{margin-left:auto;background:#c80b1f;border-radius:10px;min-width:21px;text-align:center;padding:1px 5px;color:#fff;font-size:9px}.mail-onboard{margin-top:22px;border:1px solid #183650;background:#071625;border-radius:6px;padding:11px}.mail-onboard strong{display:block;font-size:10px;color:#dbeafa}.mail-onboard p{font-size:9px;color:#7088a0;line-height:1.5;margin:6px 0 0}.mail-list-pane{border-right:1px solid #17334d;min-width:0;background:#06101d}.mail-list-head{height:54px;border-bottom:1px solid #17334d;padding:9px 12px;display:flex;align-items:center;justify-content:space-between}.mail-list-head strong{display:block;font-size:12px}.mail-list-head span{font-size:9px;color:#7087a1}.mail-items{height:calc(100% - 54px);overflow:auto}.mail-item{position:relative;border-bottom:1px solid #132a40;padding:12px 12px 12px 48px;cursor:pointer;min-height:79px}.mail-item:hover{background:#09192a}.mail-item.selected{background:linear-gradient(90deg,#0d2947,#091a2d);box-shadow:inset 3px 0 0 #168cff}.mail-item.unread:after{content:"";position:absolute;right:10px;top:15px;width:7px;height:7px;border-radius:50%;background:#168cff;box-shadow:0 0 8px #168cff}.mail-item.unread{background:rgba(13,42,72,.34)}.mail-item:not(.unread){opacity:.66}.mail-item.selected{opacity:1}.mail-item.new-arrival{animation:mailArrive .55s ease-out}.mail-item.reported{box-shadow:inset 3px 0 0 #33d17a}.mail-item-status{display:inline-flex;margin-top:5px;border:1px solid #23425c;border-radius:10px;padding:2px 6px;color:#6f8ca4;font-size:8px}.mail-item-status.done{border-color:#1c5c40;color:#54d991;background:#08271d}.mail-item-status.reported{border-color:#30598a;color:#77b8ff;background:#0a2038}.mail-reader-empty{height:100%;display:grid;place-items:center;text-align:center;color:#658098;padding:30px}.mail-reader-empty strong{display:block;color:#b8ccdd;margin-bottom:8px}.mail-secondary:disabled,.mail-action:disabled{opacity:.45;cursor:not-allowed}.mail-progress{margin-top:12px;border-top:1px solid #183650;padding-top:10px}.mail-progress-row{display:flex;justify-content:space-between;gap:8px;font-size:8px;color:#738da5;margin:6px 0}.mail-progress-row b{color:#d8e8f6}.mail-progress-bar{height:5px;background:#10273a;border-radius:5px;overflow:hidden;margin:7px 0}.mail-progress-bar span{display:block;height:100%;width:0;background:linear-gradient(90deg,#128bff,#20d3ed);transition:width .3s}@keyframes mailArrive{from{transform:translateY(-8px);opacity:0}to{transform:none;opacity:1}}.mail-avatar{position:absolute;left:12px;top:14px;width:27px;height:27px;border-radius:50%;display:grid;place-items:center;background:#102b45;border:1px solid #28506e;color:#a9c4db;font-weight:800;font-size:10px}.mail-item-from{font-size:10px;font-weight:750;color:#d9e8f7;padding-right:18px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mail-item-subject{font-size:10px;color:#a9bbcc;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mail-item-preview{font-size:9px;color:#627990;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mail-item-time{position:absolute;right:11px;bottom:9px;color:#617990;font-size:8px}.mail-reader{min-width:0;background:linear-gradient(180deg,#071321,#050d18);display:flex;flex-direction:column}.mail-reader-head{border-bottom:1px solid #17334d;padding:17px 20px 14px}.mail-reader-head h2{font-size:17px;line-height:1.35;margin:0 0 12px}.mail-sender-row{display:flex;align-items:center;gap:10px}.mail-sender-avatar{width:35px;height:35px;border-radius:50%;display:grid;place-items:center;background:#102c48;border:1px solid #2a5a7f;font-weight:800}.mail-sender-copy{min-width:0}.mail-sender-copy strong{font-size:10px;display:block}.mail-address{font:9px/1.4 "SFMono-Regular",Consolas,monospace;color:#7690a8;overflow-wrap:anywhere}.mail-reader-body{padding:22px;overflow:auto;color:#b9c9d8;line-height:1.68;font-size:11px;max-width:900px}.mail-reader-body p{margin:0 0 14px}.mail-reader-body .mail-callout{border:1px solid #24435f;background:#081827;border-radius:6px;padding:12px 14px;color:#d5e4f2}.mail-action{display:inline-flex;align-items:center;justify-content:center;min-height:38px;border:0;border-radius:5px;background:linear-gradient(90deg,#0d7ee8,#18b3e8);color:#fff;padding:0 18px;font-weight:800;cursor:pointer;margin:6px 0 8px}.mail-action:hover{filter:brightness(1.08)}.mail-url{display:block;font:9px/1.5 "SFMono-Regular",Consolas,monospace;color:#59748d;overflow-wrap:anywhere}.mail-reader-actions{margin-top:auto;border-top:1px solid #17334d;padding:12px 20px;display:flex;gap:8px}.mail-secondary{border:1px solid #244663;background:#071625;color:#9db2c7;border-radius:5px;padding:8px 12px;cursor:pointer}.mail-secondary:hover{border-color:#39729c;color:#e5f1fc}.mail-hint{margin-left:auto;color:#617990;font-size:9px;align-self:center}.portal-overlay{position:fixed;inset:0;z-index:460;background:rgba(1,5,11,.78);backdrop-filter:blur(7px);display:grid;place-items:center;padding:18px}.portal-window{width:min(1040px,96vw);max-height:92vh;background:linear-gradient(180deg,#081625,#050d18);border:1px solid #245178;border-radius:9px;box-shadow:0 26px 90px rgba(0,0,0,.62);overflow:hidden;display:flex;flex-direction:column}.portal-bar{min-height:58px;border-bottom:1px solid #1b3a56;background:#071321;display:flex;align-items:center;gap:12px;padding:10px 14px}.portal-app-icon{width:36px;height:36px;border-radius:8px;background:linear-gradient(145deg,#0d74d9,#19b9e6);display:grid;place-items:center;font-weight:900;color:#fff;box-shadow:0 0 17px rgba(29,216,255,.2)}.portal-bar-copy{min-width:0}.portal-bar-copy strong{display:block;font-size:12px}.portal-location{font:9px/1.45 'SFMono-Regular',Consolas,monospace;color:#6888a3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:650px}.portal-verified{margin-left:auto;border:1px solid #1d6849;background:#082a20;color:#57dc95;border-radius:12px;padding:4px 9px;font-size:9px;font-weight:800;white-space:nowrap}.portal-close{width:32px;height:32px;border:1px solid #284963;background:#081522;border-radius:5px;color:#91a8bd;cursor:pointer;font-size:18px}.portal-close:hover{color:#fff;border-color:#3f7197}.portal-content{overflow:auto;padding:22px;background:radial-gradient(circle at 85% 0,rgba(22,140,255,.08),transparent 30%)}.portal-hero{border:1px solid #1d405e;background:linear-gradient(120deg,#0a2036,#081522);border-radius:8px;padding:20px;margin-bottom:14px;display:flex;align-items:flex-start;gap:18px}.portal-hero-copy{flex:1}.portal-eyebrow{font-size:9px;letter-spacing:1.1px;text-transform:uppercase;color:#36cbed;font-weight:800}.portal-hero h2{font-size:22px;line-height:1.25;margin:6px 0 7px;color:#edf7ff}.portal-hero p{margin:0;color:#8fa7bc;line-height:1.55;font-size:11px}.portal-status-card{min-width:190px;border:1px solid #24506f;background:#061321;border-radius:7px;padding:12px}.portal-status-card small{display:block;color:#6c879e;font-size:8px;text-transform:uppercase;letter-spacing:.8px}.portal-status-card strong{display:block;font-size:13px;margin-top:4px;color:#58dc95}.portal-status-card span{display:block;color:#7992a8;font-size:9px;margin-top:7px}.portal-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.portal-card{border:1px solid #183954;background:#071522;border-radius:7px;padding:14px;min-width:0}.portal-card.full{grid-column:1/-1}.portal-card h3{font-size:10px;text-transform:uppercase;letter-spacing:.65px;color:#cfe3f5;margin:0 0 10px}.portal-card p{font-size:10px;line-height:1.6;color:#8da5ba;margin:0 0 9px}.portal-card p:last-child{margin-bottom:0}.portal-list{list-style:none;margin:0;padding:0}.portal-list li{position:relative;padding:9px 8px 9px 28px;border-top:1px solid #132e44;color:#a9bdce;font-size:10px;line-height:1.45}.portal-list li:first-child{border-top:0}.portal-list li:before{content:'✓';position:absolute;left:7px;top:9px;color:#42d78a;font-weight:900}.agenda-row{display:grid;grid-template-columns:72px 1fr auto;gap:12px;align-items:center;padding:10px 0;border-top:1px solid #17354f}.agenda-row:first-child{border-top:0}.agenda-time{font:700 11px/1 'SFMono-Regular',Consolas,monospace;color:#44cbed}.agenda-title strong{display:block;font-size:10px;color:#d6e7f5}.agenda-title span{display:block;font-size:9px;color:#708aa0;margin-top:3px}.agenda-tag{border:1px solid #28506d;background:#0a1d2e;border-radius:11px;padding:3px 8px;color:#90aec6;font-size:8px;white-space:nowrap}.portal-table{width:100%;border-collapse:collapse;font-size:9px}.portal-table th{text-align:left;color:#66839c;font-weight:650;text-transform:uppercase;letter-spacing:.5px;padding:8px;border-bottom:1px solid #24435e}.portal-table td{padding:9px 8px;border-bottom:1px solid #142f45;color:#a9bdce;vertical-align:top}.portal-table tr:last-child td{border-bottom:0}.status-ok{color:#51d991;font-weight:800}.status-wait{color:#ffbf35;font-weight:800}.portal-progress{height:7px;background:#10283b;border-radius:8px;overflow:hidden;margin:10px 0 6px}.portal-progress span{display:block;height:100%;background:linear-gradient(90deg,#128bff,#20d3ed);border-radius:8px}.module-row{display:grid;grid-template-columns:34px 1fr auto;align-items:center;gap:10px;padding:10px 0;border-top:1px solid #153149}.module-row:first-child{border-top:0}.module-number{width:28px;height:28px;border-radius:50%;border:1px solid #285370;background:#0b2033;display:grid;place-items:center;color:#77a7ca;font-weight:800}.module-copy strong{display:block;color:#cfe1ef;font-size:10px}.module-copy span{display:block;color:#718ba1;font-size:8px;margin-top:3px}.portal-button{border:1px solid #21628f;background:#0d3657;color:#bfe9ff;border-radius:5px;padding:7px 10px;font-size:9px;font-weight:800;cursor:pointer}.portal-button:hover{background:#12466d}.portal-button.secondary{border-color:#29475e;background:#0a1825;color:#8fa7bb}.portal-footer{border-top:1px solid #1b3a56;background:#06111e;padding:10px 14px;display:flex;align-items:center;gap:9px}.portal-footer-note{color:#668198;font-size:9px}.portal-footer .portal-button{margin-left:auto}.breach-transition{position:fixed;inset:0;z-index:500;background:radial-gradient(circle at center,rgba(120,0,18,.32),rgba(1,3,8,.98) 46%);display:grid;place-items:center;text-align:center}.breach-card{border:1px solid #bc263d;background:rgba(38,5,13,.84);box-shadow:0 0 70px rgba(255,32,62,.26);border-radius:9px;padding:30px 36px;max-width:520px}.breach-symbol{font-size:46px;color:#ff4057;animation:breachPulse .6s infinite alternate}.breach-card h2{color:#ff6577;letter-spacing:1px}.breach-card p{color:#bd8e99;font:11px/1.6 "SFMono-Regular",Consolas,monospace}@keyframes breachPulse{from{transform:scale(.94);opacity:.65}to{transform:scale(1.06);opacity:1}}

@media(max-width:1080px){.sidebar{transform:translateX(-100%);transition:transform .2s}.sidebar.open{transform:none}.topbar{left:0}.menu-toggle{display:block}.app{margin-left:0}.server-select{min-width:175px}.attack-status{min-width:170px}.dashboard-grid{grid-template-columns:260px minmax(420px,1fr)}.resources-panel{grid-column:1 / -1;grid-row:2}.gauges{grid-template-columns:repeat(4,1fr)}.timeline-panel{grid-column:1;grid-row:3}.network-panel{grid-column:2;grid-row:3}.process-panel{grid-column:1 / -1;grid-row:4}.logs-panel{grid-column:1 / -1;grid-row:5}.intel-panel{grid-column:1 / -1;grid-row:6}.missions-panel{grid-row:7}}
@media(max-width:760px){.topbar{height:auto;min-height:64px;flex-wrap:wrap;padding:8px}.server-select{flex:1;min-width:150px}.attack-status{order:3;width:100%}.top-stats{order:4;width:100%;flex:none}.notify,.profile{display:none}.app{padding-top:181px}.dashboard-grid{display:block}.panel{margin-bottom:9px}.terminal-shell{height:380px}.alerts-list{min-height:0}.mission-layout{grid-template-columns:1fr}.mission-list{border-right:0;border-bottom:1px solid #17334d}.quick-steps{grid-template-columns:1fr}.network-map{height:250px}.logs-panel .panel-head{height:auto;min-height:42px;flex-wrap:wrap;padding:7px 10px}.log-row{grid-template-columns:44px 42px 1fr}.intel-head,.intel-row{grid-template-columns:1.15fr .55fr 1fr .55fr}.intel-head>*:nth-child(5),.intel-row>*:nth-child(5){display:none}}
@media(max-width:470px){.top-stats{grid-template-columns:1fr 1fr}.top-stat:nth-child(3){display:none}.brand-title{font-size:14px}.gauges{grid-template-columns:repeat(2,1fr)}.profile{display:none}.app{padding-left:6px;padding-right:6px}.terminal-output,.terminal-input-row{font-size:10px}.modal-notes{grid-template-columns:1fr}.process-head,.process-row{grid-template-columns:1fr 40px 45px}.process-head>*:last-child,.process-row>*:last-child{display:none}}

@media(max-width:980px){.mail-shell{grid-template-columns:170px 300px minmax(360px,1fr)}.mail-logo{min-width:170px}}
@media(max-width:760px){.mail-stage{padding:6px}.mail-topbar{height:auto;min-height:62px;flex-wrap:wrap;padding:9px}.mail-logo{min-width:150px}.mail-search{order:3;width:100%;max-width:none}.mail-day{margin-left:auto}.mail-shell{display:block;min-height:0}.mail-nav{display:none}.mail-list-pane{border-right:0;height:280px;border-bottom:1px solid #17334d}.mail-reader{min-height:520px}.mail-hint{display:none}.portal-overlay{padding:5px}.portal-window{width:100%;max-height:98vh}.portal-bar{gap:8px}.portal-location{max-width:190px}.portal-verified{display:none}.portal-content{padding:10px}.portal-hero{display:block;padding:14px}.portal-status-card{margin-top:12px;min-width:0}.portal-grid{grid-template-columns:1fr}.portal-card.full{grid-column:auto}.agenda-row{grid-template-columns:58px 1fr}.agenda-tag{display:none}.portal-footer-note{display:none}}
</style>
</head>
<body>
<section class="mail-stage hidden" id="mailStage">
 <header class="mail-topbar">
  <div class="mail-logo"><div class="mail-logo-mark">SI</div><div><strong>Linux.d Mail</strong><div class="brand-sub">CORPORATE WORKSPACE</div></div></div>
  <div class="mail-search">⌕ &nbsp; Pesquisar e-mails, pessoas e tickets</div>
  <div class="mail-day"><small>Janela de onboarding</small><strong id="inboxTimer">05:00</strong></div>
 </header>
 <div class="mail-shell">
  <aside class="mail-nav"><button class="compose-btn">＋ Nova mensagem</button><div class="mail-folder active">▤ Caixa de entrada <b id="mailUnread">0</b></div><div class="mail-folder">☆ Favoritos</div><div class="mail-folder">⌁ Enviados</div><div class="mail-folder">◷ Rascunhos</div><div class="mail-folder">⚑ Quarentena</div><div class="mail-onboard"><strong>Primeiro dia na Linux.d</strong><p>As mensagens chegam gradualmente. Abra todas, acesse os conteúdos legítimos e reporte apenas o que for realmente suspeito.</p><div class="mail-progress"><div class="mail-progress-row"><span>Recebidos</span><b id="progressDelivered">0 / 12</b></div><div class="mail-progress-row"><span>Lidos</span><b id="progressRead">0 / 12</b></div><div class="mail-progress-row"><span>Conteúdos acessados</span><b id="progressActions">0 / 9</b></div><div class="mail-progress-row"><span>Reportes incorretos</span><b id="progressFalse">0 / 3</b></div><div class="mail-progress-bar"><span id="mailProgressBar"></span></div></div></div></aside>
  <section class="mail-list-pane"><div class="mail-list-head"><div><strong>Caixa de entrada</strong><span id="mailCountLabel">Aguardando mensagens...</span></div><span>Hoje ▾</span></div><div class="mail-items" id="mailItems"></div></section>
  <article class="mail-reader"><div class="mail-reader-head" id="mailReaderHead"></div><div class="mail-reader-body" id="mailReaderBody"><div class="mail-reader-empty"><div><strong>Selecione uma mensagem</strong>Novos e-mails aparecerão nesta caixa ao longo da simulação.</div></div></div><div class="mail-reader-actions"><button class="mail-secondary" id="replyMail" disabled>↩ Responder</button><button class="mail-secondary" id="reportMail" disabled>⚑ Reportar suspeita</button><span class="mail-hint">Ambiente educacional · nenhum link externo é aberto</span></div></article>
 </div>
</section>
<div class="portal-overlay hidden" id="safePortal" role="dialog" aria-modal="true" aria-labelledby="safePortalTitle">
 <section class="portal-window">
  <header class="portal-bar"><div class="portal-app-icon" id="safePortalIcon">SI</div><div class="portal-bar-copy"><strong id="safePortalApp">Portal Linux.d</strong><div class="portal-location" id="safePortalUrl">https://intranet.linux.d</div></div><span class="portal-verified">✓ SESSÃO CORPORATIVA ATIVA</span><button class="portal-close" id="closeSafePortal" aria-label="Fechar">×</button></header>
  <main class="portal-content" id="safePortalBody"></main>
  <footer class="portal-footer"><span class="portal-footer-note">Conteúdo interno simulado · nenhum dado real é enviado</span><button class="portal-button secondary" id="backToMail">Voltar para o e-mail</button></footer>
 </section>
</div>
<div class="breach-transition hidden" id="breachTransition"><div class="breach-card"><div class="breach-symbol">◉</div><h2>CREDENCIAL ADMINISTRATIVA COMPROMETIDA</h2><p>Token SSO reutilizado · sessão remota aberta · carregando console de resposta...</p></div></div>
<aside class="sidebar hidden" id="sidebar">
 <div class="brand">
  <div class="brand-shield" aria-hidden="true"><svg viewBox="0 0 48 56" fill="none"><path d="M24 2L43 9v15c0 13-7.7 23.7-19 29C12.7 47.7 5 37 5 24V9L24 2Z" stroke="#1bb9ff" stroke-width="3"/><path d="M24 13v29M16 25l8-7 8 7M17 34h14" stroke="#34d5ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
  <div><div class="brand-title">GAME SI</div><div class="brand-sub">CYBER DEFENSE LAB</div></div>
 </div>
 <div class="nav-scroll">
  <div class="nav-section">Principal</div>
  <button class="nav-item active" data-scroll="dashboardTop"><span class="nav-icon">▦</span>Dashboard</button>
  <button class="nav-item" id="openRunbookNav"><span class="nav-icon">△</span>Centro de Incidentes</button>
  <button class="nav-item" data-scroll="alertsPanel"><span class="nav-icon">♢</span>Alertas <span class="nav-badge" id="sideAlertCount">0</span></button>
  <button class="nav-item" data-scroll="timelinePanel"><span class="nav-icon">⌁</span>Timeline</button>
  <button class="nav-item" data-scroll="missionsPanel"><span class="nav-icon">✓</span>Missões</button>
  <button class="nav-item" id="rankingNav"><span class="nav-icon">♕</span>Score & Ranking</button>
  <div class="nav-section">Monitoramento</div>
  <button class="nav-item" data-scroll="networkPanel"><span class="nav-icon">▣</span>Hosts</button>
  <button class="nav-item" data-scroll="networkPanel"><span class="nav-icon">⌘</span>Rede</button>
  <button class="nav-item" data-scroll="logsPanel"><span class="nav-icon">▤</span>Logs</button>
  <button class="nav-item" data-scroll="processPanel"><span class="nav-icon">⌬</span>Processos</button>
  <button class="nav-item" data-command="services"><span class="nav-icon">⚙</span>Serviços</button>
  <button class="nav-item" data-command="ss -tulpn"><span class="nav-icon">⌁</span>Conexões</button>
  <div class="nav-section">Segurança</div>
  <button class="nav-item" data-scroll="intelPanel"><span class="nav-icon">◎</span>Threat Intelligence</button>
  <button class="nav-item" data-command="scan"><span class="nav-icon">◉</span>Vulnerabilidades</button>
  <button class="nav-item" data-command="nft list ruleset"><span class="nav-icon">♧</span>Firewall</button>
  <button class="nav-item" data-command="alerts"><span class="nav-icon">◈</span>IDS / IPS</button>
  <button class="nav-item" data-command="find / -name suspicious"><span class="nav-icon">⌕</span>Malware Analysis</button>
  <div class="nav-section">Sistema</div>
  <button class="nav-item" id="reportNav"><span class="nav-icon">▥</span>Relatório</button>
  <button class="nav-item" data-command="status"><span class="nav-icon">⚙</span>Configurações</button>
