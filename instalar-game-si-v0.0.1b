<main class="app hidden" id="dashboardApp">
 <div class="dashboard-grid">
  <section class="panel alerts-panel" id="alertsPanel"><div class="panel-head"><span class="panel-title red">Alertas ativos</span><span class="count-pill" id="alertCount">0</span></div><div class="alerts-list" id="alertsList"></div></section>
  <section class="panel terminal-panel" id="terminalPanel"><div class="panel-head"><span class="panel-title">▣ &nbsp; Terminal Linux</span><div class="panel-actions"><button class="icon-btn" id="runbookBtn">Runbook</button><button class="icon-btn" id="clearBtn">Limpar</button><button class="icon-btn" id="maxBtn">□</button></div></div><div class="terminal-shell" id="terminal" tabindex="0"><div class="terminal-output" id="terminalOutput"></div><div class="terminal-input-row"><span><span class="term-prompt">root@ubuntu-prod-01</span>:<span class="term-path" id="currentPath">~</span>#&nbsp;</span><input class="terminal-input" id="commandInput" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Comando do terminal"></div></div></section>
  <section class="panel resources-panel"><div class="panel-head"><span class="panel-title">Recursos do sistema</span><span class="muted" style="font-size:8px">TEMPO REAL SIMULADO</span></div><div class="gauges">
   <div class="gauge"><div class="gauge-label">CPU</div><div class="gauge-ring" id="cpuGauge" style="--gauge-color:var(--orange)"><strong id="cpuValue">12%</strong></div><div class="gauge-sub">1 Core</div></div>
   <div class="gauge"><div class="gauge-label">RAM</div><div class="gauge-ring" id="ramGauge" style="--gauge-color:var(--orange)"><strong id="ramValue">42%</strong></div><div class="gauge-sub" id="ramSub">214 / 512 MB</div></div>
   <div class="gauge"><div class="gauge-label">Disco</div><div class="gauge-ring" id="diskGauge" style="--gauge-color:var(--green)"><strong id="diskValue">23%</strong></div><div class="gauge-sub">2.1 / 9.8 GB</div></div>
   <div class="gauge"><div class="gauge-label">Rede</div><div class="gauge-ring" id="netGauge" style="--gauge-color:var(--lime)"><strong id="netValue">18%</strong></div><div class="gauge-sub" id="netSub">120 Mbps</div></div>
  </div><div class="chart-wrap"><canvas id="resourceChart" width="440" height="100"></canvas><div class="chart-legend"><span><i class="legend-dot dot-cpu"></i>CPU</span><span><i class="legend-dot dot-ram"></i>RAM</span><span><i class="legend-dot dot-net"></i>REDE</span></div></div></section>
  <section class="panel timeline-panel" id="timelinePanel"><div class="panel-head"><span class="panel-title red">Timeline do ataque</span></div><div class="timeline" id="timeline"></div></section>
  <section class="panel network-panel" id="networkPanel"><div class="panel-head"><span class="panel-title">Mapa de rede</span><button class="icon-btn" data-command="ss -tulpn">Ver detalhes →</button></div><div class="network-map">
   <div class="net-node internet"><span class="net-icon">◎</span><strong>INTERNET</strong></div>
   <div class="net-node attacker" id="attackerNode"><span class="net-icon">◉</span><strong id="attackerIp">203.0.113.77</strong><span id="attackerState">ATACANTE</span></div>
   <div class="net-node firewall" id="firewallNode"><span class="net-icon">▦</span><strong>FIREWALL</strong><span id="firewallState">MONITORANDO</span></div>
   <div class="net-node server"><span class="net-icon">▣</span><strong>ubuntu-prod-01</strong><span>10.0.0.15</span></div>
   <div class="net-node admin-node"><span class="net-icon">▱</span><strong>192.0.2.10</strong><span>ADMIN</span></div>
   <div class="net-node db-node"><span class="net-icon">◫</span><strong>10.0.0.20</strong><span>DATABASE</span></div>
   <span class="net-line line-v1"></span><span class="net-line line-v2"></span><span class="net-line line-v3"></span><span class="net-line line-left"></span><span class="net-line line-right"></span><span class="net-pulse" id="netPulse"></span>
  </div></section>
  <section class="panel process-panel" id="processPanel"><div class="panel-head"><span class="panel-title red">Top processos</span><button class="icon-btn" data-command="ps aux --sort=-%cpu">Atualizar</button></div><div class="process-table" id="processTable"></div></section>
  <section class="panel logs-panel" id="logsPanel"><div class="panel-head"><span class="panel-title">Logs recentes</span><div class="log-filters"><button class="filter-chip active" data-filter="all">● Todos</button><button class="filter-chip" data-filter="critical">● Críticos</button><button class="filter-chip" data-filter="warning">● Avisos</button><button class="filter-chip" data-filter="success">● Sucesso</button></div></div><div class="log-list" id="recentLogs"></div></section>
  <section class="panel intel-panel" id="intelPanel"><div class="panel-head"><span class="panel-title">Threat intelligence</span><button class="icon-btn" data-command="alerts">Ver IOCs →</button></div><div class="intel-table" id="intelTable"></div></section>
  <section class="panel missions-panel" id="missionsPanel"><div class="panel-head"><span class="panel-title">Missões e resposta ao incidente</span><button class="icon-btn" id="fullRunbookBtn">Abrir tutorial completo</button></div><div class="mission-layout"><div class="mission-list"><div id="missionList"></div><div class="mission-progress"><div class="mission-progress-label"><span>Progresso geral</span><strong id="progressText">0%</strong></div><div class="mission-progress-bar"><span id="missionProgress"></span></div></div></div><div class="quick-runbook"><div class="runbook-title" id="quickTitle">Checklist inicial de triagem</div><div class="quick-steps" id="quickSteps"></div></div></div></section>
 </div>
</main>
<div class="overlay" id="overlay"></div>
<aside class="drawer" id="runbookDrawer"><div class="drawer-head"><div><h2>Central de Incidentes</h2><div class="muted" style="font-size:9px;margin-top:3px">Runbook interativo — comandos clicáveis</div></div><button class="icon-btn" id="closeRunbook">✕</button></div><div class="drawer-body" id="runbookBody"></div></aside>
<div class="modal" id="startModal"><div class="modal-card"><div class="modal-logo"><div class="brand-shield"><svg viewBox="0 0 48 56" fill="none"><path d="M24 2L43 9v15c0 13-7.7 23.7-19 29C12.7 47.7 5 37 5 24V9L24 2Z" stroke="#1bb9ff" stroke-width="3"/><path d="M24 13v29M16 25l8-7 8 7M17 34h14" stroke="#34d5ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></div><div><h1>GAME SI</h1><div class="brand-sub">GAME SI · v10.0</div></div></div><h2>Seu primeiro dia na Linux.d</h2><p>Você acaba de assumir como administrador Linux. A primeira etapa acontece na caixa de entrada corporativa. Os e-mails chegam aos poucos e em ordem variável: abra todas as mensagens, acesse os conteúdos legítimos e reporte somente as suspeitas. Três falsos positivos encerram a missão; clicar em um link malicioso libera a fase de resposta ao incidente.</p><label for="nick">Seu nome</label><input id="nick" maxlength="24" placeholder="Ex.: Carlos" autocomplete="off"><button class="primary-btn" id="startBtn">ABRIR CAIXA DE ENTRADA</button><div class="modal-notes"><div class="modal-note">Engenharia social<br>interativa</div><div class="modal-note">Terminal Linux<br>navegável</div><div class="modal-note">5 + 5 minutos<br>de simulação</div></div></div></div>
<div class="modal hidden" id="resultModal"><div class="modal-card" style="text-align:center"><div class="attack-icon" style="margin:0 auto 13px;width:45px;height:45px" id="resultIcon">✓</div><h2 id="resultTitle">Servidor protegido</h2><p id="resultText"></p><div class="result-score" id="resultScore">0 pts</div><button class="primary-btn" id="restartBtn">NOVA SIMULAÇÃO</button><button class="icon-btn" id="resultRanking" style="width:100%;height:35px;margin-top:7px">Ver ranking</button></div></div>
<div class="modal hidden" id="rankingModal"><div class="modal-card"><div style="display:flex;justify-content:space-between;align-items:center"><h2>Ranking SOC</h2><button class="icon-btn" id="closeRanking">✕</button></div><p>Melhores respostas registradas neste servidor.</p><div class="ranking-list" id="rankingList"></div></div></div>
<div class="toast" id="toast"></div>
<script>
(function(){
'use strict';
var state=null,started=false,busy=false,completeBusy=false,mailBusy=false,ended=false,avoidanceShown=false,lastHistory=0,lastScore=0,history=[],historyIndex=0,historyDraft='',lastTabKey='',lastTabAt=0,logFilter='all',selectedMail='',knownDelivered={};
var command=document.getElementById('commandInput'),terminal=document.getElementById('terminal'),output=document.getElementById('terminalOutput');
var COMMANDS=('help man apropos which type command sudo w who whoami id groups last lastlog hostname hostnamectl uname uptime date timedatectl pwd cd realpath readlink basename dirname env printenv history echo printf clear reset ls dir tree cat less more head tail grep egrep fgrep find locate stat file wc du df mount lsblk sha256sum md5sum mkdir touch rm rmdir mv chmod chown nano vi vim processes ps top htop pstree pgrep pidof free vmstat lsof fuser nice renice kill pkill killall connections netstat ss ip ifconfig route arp ping traceroute tracepath dig nslookup host curl wget tcpdump nft iptables ufw fail2ban-client services service systemctl journalctl dmesg logs users getent passwd usermod faillog dpkg apt apt-get nproc ulimit status alerts files scan block lock restore cp patch sed sshd diff cmp install rsync chage userdel loginctl tar version selftest').split(' ');
var CATEGORIES=['sistema','arquivos','processos','rede','servicos','seguranca'];
var PATHS=['/var/log/auth.log','/var/log/secure','/etc/passwd','/etc/group','/etc/ssh/sshd_config','/root/backups/sshd_config.clean','/var/backups/sshd_config.clean','/proc/meminfo','/proc/loadavg'];
var USERS=['root','student','system-update'];var IPS=['203.0.113.77','198.51.100.42','10.0.0.15'];
var MAILS=[
 {id:"welcome",from:"Ana Martins · Pessoas",email:"ana.martins@linux.d",subject:"Bem-vindo à Linux.d — informações do seu primeiro dia",preview:"Sua agenda, acessos iniciais e contatos da equipe.",avatar:"AM",body:["Olá, {{nick}}! Seja bem-vindo à Linux.d.","Seu gestor é Gabriel Souza e sua primeira atividade será acompanhar o ambiente ubuntu-prod-01. O crachá virtual e o calendário já foram provisionados.","Os sistemas oficiais usam endereços terminados exatamente em @linux.d. Em caso de dúvida, use o diretório interno ou reporte a mensagem ao SOC."],action:"Abrir agenda do primeiro dia",url:"https://people.linux.d/onboarding"},
 {id:"manager",from:"Gabriel Souza · Infraestrutura",email:"gabriel.souza@linux.d",subject:"Checklist do primeiro turno — ubuntu-prod-01",preview:"Não faça mudanças antes de revisar a linha de base do host.",avatar:"GS",body:["Bom dia, {{nick}}.","Você ficará responsável pelo ubuntu-prod-01, endereço 10.0.0.15. Hoje é apenas observação: revise processos, conexões, logs de autenticação e a configuração do SSH.","Ticket de acompanhamento: INFRA-2048. Não envie senhas ou tokens por e-mail."],action:"Abrir ticket INFRA-2048",url:"https://tickets.linux.d/INFRA-2048"},
 {id:"access-expiration",from:"Central de Identidade Linux.d",email:"onboarding@linuxd-access.test",reply:"helpdesk@linuxd-reset.test",subject:"Ação necessária: vínculo do acesso root expira hoje às 15:30",preview:"Conclua o MFA do ticket LD-8841 para não perder o acesso ao servidor.",avatar:"ID",body:["Olá, {{nick}}.","O vínculo temporário de administrador criado para o seu primeiro dia ainda não foi associado ao MFA corporativo. Sem a conclusão, o acesso ao ubuntu-prod-01 será revogado automaticamente às 15:30.","A solicitação foi aberta por Gabriel Souza e registrada como LD-8841. Use o botão abaixo enquanto a janela de ativação estiver disponível.","Por segurança, o portal solicitará uma nova autenticação e a confirmação do token temporário."],action:"Vincular MFA e manter acesso",url:"https://sso.linuxd-access.test/activate/LD-8841"},
 {id:"training",from:"Academia Linux.d",email:"academia@linux.d",subject:"Curso obrigatório: resposta a incidentes para administradores",preview:"Treinamento de 35 minutos disponível no portal interno.",avatar:"AL",body:["Olá, {{nick}}.","O curso de resposta a incidentes já foi atribuído ao seu perfil. O prazo é de sete dias; não é necessário concluir hoje.","O acesso usa a sessão corporativa existente e nunca solicita que você digite a senha novamente a partir de um link de e-mail."],action:"Abrir portal de aprendizagem",url:"https://learn.linux.d/course/ir-linux"},
 {id:"noc",from:"NOC Linux.d",email:"noc@linux.d",subject:"Janela de manutenção desta noite — nenhuma ação agora",preview:"Atualização da rede entre 23:00 e 23:30.",avatar:"NO",body:["Equipe de Infraestrutura,","Hoje haverá manutenção nos switches de borda entre 23:00 e 23:30. O ubuntu-prod-01 poderá perder conectividade por até dois minutos.","Esta mensagem é somente informativa. Mudanças devem ser executadas exclusivamente pelo change CHG-7712."],action:"Consultar CHG-7712",url:"https://changes.linux.d/CHG-7712"},
 {id:"benefits",from:"Marina Lima · Benefícios",email:"marina.lima@linux.d",subject:"Cadastro de benefícios disponível no portal de pessoas",preview:"Prazo de dez dias para escolher as opções.",avatar:"ML",body:["Bem-vindo, {{nick}}.","Seu cadastro de benefícios já está disponível. O prazo é de dez dias e não existe urgência para concluir no primeiro dia.","Acesse também pelo menu Pessoas na intranet; não envie documentos em resposta a este e-mail."],action:"Abrir Pessoas",url:"https://people.linux.d/benefits"},
 {id:"soc-guide",from:"SOC Linux.d",email:"soc@linux.d",subject:"Como reconhecer e reportar mensagens suspeitas",preview:"Domínios parecidos, urgência e reautenticação são sinais de risco.",avatar:"SC",body:["Olá, {{nick}}.","Ataques de onboarding exploram contexto real do primeiro dia: nome do gestor, servidor, ticket e prazo curto. Essas informações podem ter vazado de calendários ou redes profissionais.","Confirme o domínio completo. Os portais oficiais terminam em .linux.d; nomes como linuxd-acesso, linuxd-sso ou linuxd-suporte não são equivalentes.","Use o botão Reportar suspeita na própria caixa de entrada. O SOC fará a análise sem abrir o link."],action:"Abrir guia do SOC",url:"https://soc.linux.d/awareness/onboarding"},
 {id:"payroll-info",from:"Folha de Pagamento Linux.d",email:"folha@linux.d",subject:"Calendário do seu primeiro pagamento",preview:"Datas de fechamento, crédito e orientações para novos colaboradores.",avatar:"FP",body:["Olá, {{nick}}.","Seu primeiro pagamento seguirá o ciclo normal da empresa. Dados bancários são cadastrados apenas no portal Pessoas aberto pela intranet.","Este e-mail contém somente o calendário e as regras do fechamento; nenhuma confirmação bancária é necessária por mensagem."],action:"Consultar calendário da folha",url:"https://people.linux.d/payroll/calendar"},
 {id:"vpn-guide",from:"Equipe de Redes Linux.d",email:"redes@linux.d",subject:"Guia oficial de acesso remoto e VPN",preview:"Pré-requisitos e procedimento para acessar a rede corporativa.",avatar:"ER",body:["Olá, {{nick}}.","O perfil de VPN será liberado após a conclusão do onboarding. A instalação deve ser feita pelo catálogo de software corporativo.","O cliente oficial não é enviado como anexo e o suporte nunca solicita códigos MFA por chat ou e-mail."],action:"Abrir guia de acesso remoto",url:"https://network.linux.d/remote-access"},
 {id:"backup-policy",from:"Governança de TI",email:"governanca@linux.d",subject:"Política de backup e recuperação — leitura obrigatória",preview:"RPO, RTO e responsabilidades do administrador de sistemas.",avatar:"GT",body:["Bem-vindo à equipe de Infraestrutura.","Antes de operar os ambientes, leia a política de backup, retenção e restauração. Ela define os objetivos de recuperação e os canais de escalonamento.","A política está publicada no repositório oficial de governança e usa sua sessão corporativa atual."],action:"Abrir política de backup",url:"https://governance.linux.d/policies/backup"},
 {id:"payroll-update",from:"Equipe de Pagamentos Linux.d",email:"payroll@linuxd-people.test",reply:"validation@linuxd-pay.test",subject:"Primeiro salário: confirme a conta antes do fechamento de hoje",preview:"Seu cadastro bancário está incompleto e pode atrasar o pagamento.",avatar:"PG",body:["Olá, {{nick}}.","Detectamos uma divergência entre o cadastro de admissão e o sistema da folha. Para evitar atraso no primeiro pagamento, confirme a conta antes das 14:00.","O formulário solicitará autenticação corporativa e uma validação de identidade. O protocolo é PAY-1904."],action:"Confirmar dados de pagamento",url:"https://people-linuxd.test/payroll/PAY-1904"},
 {id:"shared-document",from:"Gabriel Souza via Linux.d Docs",email:"notifications@linuxd-docs.test",reply:"gabriel.souza@linuxd-share.test",subject:"Gabriel compartilhou “Acessos administrativos — primeiro dia”",preview:"Documento protegido disponível por tempo limitado.",avatar:"GD",body:["Gabriel Souza compartilhou um documento com você.","O arquivo contém o checklist de acessos administrativos do ubuntu-prod-01 e expira em 30 minutos.","Para abrir, confirme sua conta Linux.d e permita a sincronização do documento com seu perfil."],action:"Abrir documento compartilhado",url:"https://docs-linuxd.test/share/admin-first-day"}
];
var SAFE_PORTALS={
 welcome:{app:'Pessoas · Onboarding',icon:'P',url:'https://people.linux.d/onboarding',title:'Agenda do primeiro dia',eyebrow:'Bem-vindo à Linux.d',summary:'Sua agenda foi preparada para apresentar a equipe, os processos internos e o ambiente que você acompanhará hoje.',status:'Agenda confirmada',statusNote:'6 compromissos · 08:30 às 16:30',html:function(){return '<div class="portal-grid"><section class="portal-card full"><h3>Agenda de hoje</h3><div class="agenda-row"><span class="agenda-time">08:30</span><div class="agenda-title"><strong>Boas-vindas com Pessoas</strong><span>Ana Martins · Sala virtual Pessoas 1</span></div><span class="agenda-tag">30 min</span></div><div class="agenda-row"><span class="agenda-time">09:00</span><div class="agenda-title"><strong>Apresentação da equipe de Infraestrutura</strong><span>Gabriel Souza · War Room 2</span></div><span class="agenda-tag">45 min</span></div><div class="agenda-row"><span class="agenda-time">10:00</span><div class="agenda-title"><strong>Tour pelo ubuntu-prod-01</strong><span>Somente observação · nenhuma mudança autorizada</span></div><span class="agenda-tag">60 min</span></div><div class="agenda-row"><span class="agenda-time">11:30</span><div class="agenda-title"><strong>Configuração da estação e MFA</strong><span>Use apenas o portal sso.linux.d aberto pela intranet</span></div><span class="agenda-tag">30 min</span></div><div class="agenda-row"><span class="agenda-time">14:00</span><div class="agenda-title"><strong>Treinamento de segurança</strong><span>Módulo introdutório da Academia Linux.d</span></div><span class="agenda-tag">35 min</span></div><div class="agenda-row"><span class="agenda-time">16:00</span><div class="agenda-title"><strong>Checkpoint com o gestor</strong><span>Dúvidas, acessos pendentes e próximos passos</span></div><span class="agenda-tag">30 min</span></div></section><section class="portal-card"><h3>Contatos principais</h3><table class="portal-table"><tr><td>Gestor</td><td>Gabriel Souza</td><td>gabriel.souza@linux.d</td></tr><tr><td>Pessoas</td><td>Ana Martins</td><td>ana.martins@linux.d</td></tr><tr><td>SOC</td><td>Plantão 24×7</td><td>soc@linux.d · ramal 7711</td></tr></table></section><section class="portal-card"><h3>Acessos do primeiro dia</h3><ul class="portal-list"><li>E-mail corporativo e calendário provisionados.</li><li>Leitura no painel de monitoramento liberada.</li><li>Acesso administrativo depende de aprovação no ticket oficial.</li><li>Senhas e tokens nunca são solicitados por e-mail.</li></ul></section></div>'}},
 manager:{app:'Service Desk · Infraestrutura',icon:'T',url:'https://tickets.linux.d/INFRA-2048',title:'Ticket INFRA-2048',eyebrow:'Checklist do primeiro turno',summary:'Acompanhamento de onboarding para o host ubuntu-prod-01. O escopo de hoje é coleta de linha de base e observação assistida.',status:'Em andamento',statusNote:function(){return 'Responsável: '+(state&&state.nick||'Novo administrador')},html:function(){return '<div class="portal-grid"><section class="portal-card"><h3>Dados do ativo</h3><table class="portal-table"><tr><td>Hostname</td><td class="mono">ubuntu-prod-01</td></tr><tr><td>Endereço</td><td class="mono">10.0.0.15</td></tr><tr><td>Sistema</td><td>Debian GNU/Linux 12</td></tr><tr><td>Criticidade</td><td>Alta · produção</td></tr><tr><td>Janela autorizada</td><td>Somente leitura hoje</td></tr></table></section><section class="portal-card"><h3>Responsabilidades</h3><ul class="portal-list"><li>Registrar uma linha de base de processos, memória e rede.</li><li>Revisar eventos recentes de autenticação.</li><li>Comparar a configuração SSH com o padrão aprovado.</li><li>Escalar anomalias ao SOC antes de alterar o host.</li></ul></section><section class="portal-card full"><h3>Checklist operacional</h3><table class="portal-table"><thead><tr><th>Etapa</th><th>Procedimento</th><th>Situação</th></tr></thead><tbody><tr><td>1</td><td>Confirmar identidade, escopo e janela de mudança</td><td class="status-ok">Concluído</td></tr><tr><td>2</td><td>Executar comandos somente de leitura: w, ps aux, ss -tulpn e journalctl</td><td class="status-wait">Pendente</td></tr><tr><td>3</td><td>Salvar observações no ticket sem incluir segredos</td><td class="status-wait">Pendente</td></tr><tr><td>4</td><td>Checkpoint com Gabriel Souza às 16:00</td><td class="status-wait">Agendado</td></tr></tbody></table></section><section class="portal-card full"><h3>Nota do gestor</h3><p>Não reinicie serviços, não aplique pacotes e não altere regras de firewall sem um incidente confirmado ou uma mudança aprovada. Em caso de alerta crítico, o painel GAME SI será a fonte oficial de coordenação.</p></section></div>'}},
 training:{app:'Academia Linux.d',icon:'A',url:'https://learn.linux.d/course/ir-linux',title:'Resposta a incidentes para administradores Linux',eyebrow:'Curso obrigatório · 35 minutos',summary:'Treinamento introdutório sobre triagem, contenção, preservação de evidências e comunicação durante incidentes.',status:'Não iniciado',statusNote:'Prazo: 7 dias · sessão SSO reconhecida',html:function(){return '<div class="portal-grid"><section class="portal-card"><h3>Seu progresso</h3><p>0 de 4 módulos concluídos</p><div class="portal-progress"><span style="width:0%"></span></div><p>O curso pode ser interrompido e retomado sem perda de progresso.</p><button class="portal-button" data-safe-action="training">Iniciar primeiro módulo</button></section><section class="portal-card"><h3>Objetivos de aprendizagem</h3><ul class="portal-list"><li>Diferenciar evento, alerta e incidente.</li><li>Priorizar contenção sem destruir evidências.</li><li>Usar logs, processos e conexões para construir uma timeline.</li><li>Comunicar impacto e ações com precisão.</li></ul></section><section class="portal-card full"><h3>Conteúdo do curso</h3><div class="module-row"><span class="module-number">1</span><div class="module-copy"><strong>Triagem e severidade</strong><span>8 min · conceitos e exercício rápido</span></div><span class="status-wait">Não iniciado</span></div><div class="module-row"><span class="module-number">2</span><div class="module-copy"><strong>Investigação no Linux</strong><span>10 min · autenticação, processos e rede</span></div><span class="status-wait">Bloqueado</span></div><div class="module-row"><span class="module-number">3</span><div class="module-copy"><strong>Contenção segura</strong><span>9 min · contas, firewall e serviços</span></div><span class="status-wait">Bloqueado</span></div><div class="module-row"><span class="module-number">4</span><div class="module-copy"><strong>Relatório pós-incidente</strong><span>8 min · evidências e comunicação</span></div><span class="status-wait">Bloqueado</span></div></section></div>'}},
 noc:{app:'Change Management',icon:'C',url:'https://changes.linux.d/CHG-7712',title:'CHG-7712 · Atualização dos switches de borda',eyebrow:'Mudança aprovada',summary:'Atualização de firmware e reinício controlado dos switches de borda do datacenter principal.',status:'Agendada',statusNote:'Hoje · 23:00–23:30 · risco moderado',html:function(){return '<div class="portal-grid"><section class="portal-card"><h3>Escopo</h3><table class="portal-table"><tr><td>Solicitante</td><td>NOC Linux.d</td></tr><tr><td>Executor</td><td>Equipe de Redes</td></tr><tr><td>Ativos</td><td>edge-sw-01 e edge-sw-02</td></tr><tr><td>Impacto previsto</td><td>Até 2 minutos de perda de conectividade</td></tr><tr><td>Servidores afetados</td><td>ubuntu-prod-01 e serviços internos</td></tr></table></section><section class="portal-card"><h3>Aprovações</h3><ul class="portal-list"><li>Gestão de Redes · aprovado às 17:12.</li><li>Gestão de Infraestrutura · aprovado às 17:31.</li><li>CAB emergencial · não necessário.</li><li>Comunicação aos times · concluída.</li></ul></section><section class="portal-card full"><h3>Plano de execução e retorno</h3><table class="portal-table"><thead><tr><th>Horário</th><th>Ação</th><th>Responsável</th></tr></thead><tbody><tr><td>22:55</td><td>Validar redundância, sessões e telemetria</td><td>NOC</td></tr><tr><td>23:00</td><td>Atualizar nó secundário e validar tráfego</td><td>Redes</td></tr><tr><td>23:12</td><td>Atualizar nó primário e restaurar HA</td><td>Redes</td></tr><tr><td>23:25</td><td>Testes de conectividade e encerramento</td><td>NOC + Infra</td></tr></tbody></table><p style="margin-top:10px"><strong>Rollback:</strong> restaurar a imagem anterior do firmware e devolver o tráfego ao nó validado. Nenhuma ação é exigida do novo administrador neste momento.</p></section></div>'}},
 benefits:{app:'Pessoas · Benefícios',icon:'B',url:'https://people.linux.d/benefits',title:'Escolha de benefícios',eyebrow:'Cadastro disponível',summary:'Revise as opções oferecidas pela Linux.d. Você tem dez dias para confirmar suas escolhas e pode salvar um rascunho.',status:'Rascunho',statusNote:'Prazo: 10 dias · nenhuma urgência',html:function(){return '<div class="portal-grid"><section class="portal-card full"><h3>Opções disponíveis</h3><table class="portal-table"><thead><tr><th>Benefício</th><th>Plano padrão</th><th>Início</th><th>Situação</th></tr></thead><tbody><tr><td>Assistência médica</td><td>Plano Nacional</td><td>1º dia do mês seguinte</td><td class="status-wait">Escolher</td></tr><tr><td>Assistência odontológica</td><td>Plano Essencial</td><td>1º dia do mês seguinte</td><td class="status-wait">Escolher</td></tr><tr><td>Vale alimentação/refeição</td><td>Flexível</td><td>Próximo ciclo</td><td class="status-wait">Configurar</td></tr><tr><td>Auxílio home office</td><td>Reembolso mensal</td><td>Após cadastro</td><td class="status-ok">Elegível</td></tr></tbody></table></section><section class="portal-card"><h3>Documentos</h3><ul class="portal-list"><li>Guia de benefícios 2026.</li><li>Política de coparticipação.</li><li>Calendário de crédito.</li><li>Perguntas frequentes.</li></ul></section><section class="portal-card"><h3>Privacidade</h3><p>Documentos pessoais são enviados somente dentro deste portal autenticado. A equipe de Pessoas não solicita anexos por resposta de e-mail nem envia formulários por domínios externos.</p><button class="portal-button secondary" data-safe-action="draft">Salvar rascunho</button></section></div>'}},
 'soc-guide':{app:'GAME SI · Awareness',icon:'S',url:'https://soc.linux.d/awareness/onboarding',title:'Engenharia social no primeiro dia',eyebrow:'Guia rápido do SOC',summary:'Ataques de onboarding combinam informações verdadeiras com um pedido falso para criar confiança e urgência.',status:'Material oficial',statusNote:'Atualizado pelo SOC · leitura de 4 minutos',html:function(){return '<div class="portal-grid"><section class="portal-card"><h3>Sinais de alerta</h3><ul class="portal-list"><li>Domínio visualmente parecido, mas diferente de <span class="mono">linux.d</span>.</li><li>Prazo curto com ameaça de perda de acesso.</li><li>Pedido para autenticar novamente após abrir um link.</li><li>Solicitação de senha, token temporário ou código MFA.</li><li>Remetente e endereço de resposta apontando para domínios diferentes.</li></ul></section><section class="portal-card"><h3>Como validar</h3><ul class="portal-list"><li>Abra o portal pela intranet ou por um favorito conhecido.</li><li>Confirme a solicitação no sistema de tickets.</li><li>Procure o contato no diretório corporativo, não no próprio e-mail.</li><li>Use Reportar suspeita sem abrir o link.</li></ul></section><section class="portal-card full"><h3>Exemplo de análise</h3><table class="portal-table"><thead><tr><th>Elemento</th><th>Legítimo</th><th>Suspeito</th></tr></thead><tbody><tr><td>Portal SSO</td><td class="mono">sso.linux.d</td><td class="mono">sso.linuxd-access.test</td></tr><tr><td>Suporte</td><td class="mono">helpdesk@linux.d</td><td class="mono">helpdesk@linuxd-reset.test</td></tr><tr><td>Fluxo normal</td><td>Acesso pela intranet, sessão já ativa</td><td>Reautenticação e pedido de token</td></tr><tr><td>Prazo</td><td>Informado no ticket oficial</td><td>Urgência criada apenas no e-mail</td></tr></tbody></table></section><section class="portal-card full"><h3>Regra de ouro</h3><p>Contexto correto não prova legitimidade. Nome do gestor, servidor e número de ticket podem ser obtidos por vazamentos, calendários públicos ou pesquisa em redes profissionais. Valide o canal e o domínio antes de confiar no conteúdo.</p><button class="portal-button" data-safe-action="guide">Marcar guia como lido</button></section></div>'}},
 'payroll-info':{app:'Pessoas · Folha',icon:'F',url:'https://people.linux.d/payroll/calendar',title:'Calendário da folha de pagamento',eyebrow:'Ciclo oficial da Linux.d',summary:'Datas do processamento mensal e orientações para o primeiro pagamento de novos colaboradores.',status:'Cadastro recebido',statusNote:'Nenhuma ação bancária pendente',html:function(){return '<div class="portal-grid"><section class="portal-card full"><h3>Calendário do próximo ciclo</h3><table class="portal-table"><thead><tr><th>Etapa</th><th>Data</th><th>Responsável</th></tr></thead><tbody><tr><td>Fechamento de admissões</td><td>Dia 20</td><td>Pessoas</td></tr><tr><td>Validação da folha</td><td>Dia 23</td><td>Finanças</td></tr><tr><td>Crédito em conta</td><td>Último dia útil</td><td>Banco conveniado</td></tr></tbody></table></section><section class="portal-card"><h3>Orientações</h3><ul class="portal-list"><li>Dados bancários são alterados somente dentro do portal Pessoas.</li><li>Nenhum prazo é comunicado apenas por e-mail.</li><li>O suporte não solicita senha ou token MFA.</li></ul></section><section class="portal-card"><h3>Situação</h3><p>Seu registro de admissão foi recebido e está dentro do prazo do ciclo atual.</p></section></div>'}},
 'vpn-guide':{app:'Network Hub',icon:'N',url:'https://network.linux.d/remote-access',title:'Acesso remoto e VPN corporativa',eyebrow:'Procedimento oficial',summary:'Pré-requisitos, instalação e suporte para acesso seguro à rede Linux.d.',status:'Aguardando liberação',statusNote:'Perfil previsto após o onboarding',html:function(){return '<div class="portal-grid"><section class="portal-card"><h3>Pré-requisitos</h3><ul class="portal-list"><li>Estação gerenciada e atualizada.</li><li>MFA corporativo já configurado pela intranet.</li><li>Cliente instalado pelo catálogo de software.</li><li>Aprovação do gestor registrada no Service Desk.</li></ul></section><section class="portal-card"><h3>Fluxo de instalação</h3><table class="portal-table"><tr><td>1</td><td>Abrir Catálogo de Software</td></tr><tr><td>2</td><td>Selecionar Linux.d Secure VPN</td></tr><tr><td>3</td><td>Autenticar pelo SSO já aberto</td></tr><tr><td>4</td><td>Validar o perfil no Network Hub</td></tr></table></section><section class="portal-card full"><h3>Canal de suporte</h3><p>Use o ticket NET-ACCESS pelo Service Desk ou o ramal 7740. Arquivos executáveis não são enviados por e-mail e códigos MFA nunca são solicitados pelo suporte.</p></section></div>'}},
 'backup-policy':{app:'Governança · Políticas',icon:'G',url:'https://governance.linux.d/policies/backup',title:'Política de backup e recuperação',eyebrow:'Documento controlado',summary:'Diretrizes de retenção, testes de restauração, RPO, RTO e responsabilidades operacionais.',status:'Versão vigente',statusNote:'POL-BCP-004 · revisão 2026.2',html:function(){return '<div class="portal-grid"><section class="portal-card"><h3>Objetivos de recuperação</h3><table class="portal-table"><tr><td>Serviços críticos</td><td>RPO 15 min · RTO 1 h</td></tr><tr><td>Serviços internos</td><td>RPO 4 h · RTO 8 h</td></tr><tr><td>Arquivos de usuário</td><td>RPO 24 h · RTO 48 h</td></tr></table></section><section class="portal-card"><h3>Controles obrigatórios</h3><ul class="portal-list"><li>Cópia imutável fora do domínio de produção.</li><li>Teste de restauração trimestral.</li><li>Criptografia em trânsito e repouso.</li><li>Registro de evidências e aprovação das exceções.</li></ul></section><section class="portal-card full"><h3>Responsabilidade do administrador</h3><p>Monitorar falhas, validar jobs, preservar logs e escalar desvios. Uma tarefa marcada como concluída não substitui o teste periódico de restauração.</p></section></div>'}}
};
var THREATS=[
 {start:15,title:'Brute Force SSH',desc:'Múltiplas tentativas de login falharam',timeline:'Força Bruta SSH',detail:'37 falhas de autenticação vindas de 203.0.113.77',indices:[0,1],severity:'critical'},
 {start:50,title:'Novo Usuário Criado',desc:'Conta system-update adicionada ao sudo',timeline:'Persistência',detail:'Nova conta privilegiada system-update',indices:[2],severity:'warning'},
 {start:85,title:'Malware Detectado',desc:'Processo unknown-worker em /var/tmp',timeline:'Execução',detail:'PID 731 iniciou consumo anormal de CPU',indices:[3],severity:'critical'},
 {start:125,title:'Configuração Alterada',desc:'sshd_config perdeu integridade',timeline:'Defesa Evasion',detail:'Política do SSH modificada pelo atacante',indices:[4],severity:'warning'},
 {start:170,title:'Conexão Reverse Shell',desc:'Tráfego persistente para destino externo',timeline:'Exfiltração',detail:'Canal de saída para 198.51.100.42:443',indices:[5],severity:'critical'}
];
var RUNBOOKS=[
 {title:'Triagem inicial',problem:'Antes do primeiro alerta, crie uma linha de base do host. Isso reduz falsos positivos e ajuda a comparar o comportamento normal com a atividade maliciosa.',methods:[
  {name:'Linha de base rápida',when:'Use nos primeiros segundos da missão.',steps:[['Identidade e sessões','w','Verifique usuários, origens e comandos em execução.'],['Processos','ps aux --sort=-%cpu','Identifique consumos anormais de CPU e memória.'],['Rede','ss -tulpn','Liste sockets, portas e processos associados.']]},
  {name:'Triagem orientada a logs',when:'Use quando a cronologia for mais importante.',steps:[['Erros recentes','journalctl -p err -n 20','Procure eventos críticos no journal.'],['Autenticação','tail -n 20 /var/log/auth.log','Leia os eventos recentes do SSH.'],['Histórico','last','Compare sessões atuais e anteriores.']]}
 ]},
 {title:'Força bruta e correção do SSH',problem:'Há dois objetivos separados: bloquear 203.0.113.77 e corrigir o serviço SSH. Complete ambos.',methods:[
  {name:'iptables + atualização',when:'Método clássico e explícito.',steps:[['Investigar','grep Failed /var/log/auth.log','Confirme o padrão de falhas e a origem repetida.'],['Bloquear','iptables -I INPUT -s 203.0.113.77 -p tcp --dport 22 -j DROP','Insira a regra no início da cadeia INPUT.'],['Corrigir','apt install --only-upgrade openssh-server','Atualize o pacote do servidor SSH.'],['Validar','iptables -L -n -v','Confirme que a regra foi aplicada.']]},
  {name:'nftables + atualização',when:'Recomendado para Debian moderno.',steps:[['Inspecionar','nft list ruleset','Conheça a política atual.'],['Bloquear','nft add rule inet filter input ip saddr 203.0.113.77 tcp dport 22 drop','Adicione uma regra nativa nftables.'],['Corrigir','apt-get install --only-upgrade openssh-server','Aplique a atualização do OpenSSH.']]},
  {name:'UFW + endurecimento',when:'Use quando o UFW é a interface administrativa.',steps:[['Estado','ufw status','Confira regras existentes.'],['Bloquear','ufw deny from 203.0.113.77 to any port 22 proto tcp','Negue a origem apenas na porta SSH.'],['Endurecer','sed -i s/PasswordAuthentication.*/PasswordAuthentication no/ /etc/ssh/sshd_config','Desative autenticação por senha.'],['Validar','sshd -t','Teste a sintaxe da configuração.']]},
  {name:'Fail2Ban + correção',when:'Automatiza o banimento de novas origens.',steps:[['Estado','fail2ban-client status sshd','Verifique a jail sshd.'],['Banir','fail2ban-client set sshd banip 203.0.113.77','Bana imediatamente o endereço.'],['Corrigir','patch ssh','Aplique a correção educacional do serviço.']]},
  {name:'Atalhos do simulador',when:'Forma mais simples para iniciantes.',steps:[['Bloquear','block 203.0.113.77','Neutralize a origem.'],['Corrigir','patch ssh','Corrija a política do SSH.']]}
 ]},
 {title:'Conta administrativa suspeita',problem:'Bloqueie system-update e encerre suas sessões. Preserve evidências antes de qualquer remoção destrutiva.',methods:[
  {name:'passwd + loginctl',when:'Reversível e recomendado.',steps:[['Confirmar','id system-update','Verifique UID, grupo e privilégios.'],['Bloquear','passwd -l system-update','Bloqueie a autenticação por senha.'],['Encerrar','loginctl terminate-user system-update','Finalize sessões abertas.'],['Validar','w','Confirme a ausência da sessão.']]},
  {name:'usermod',when:'Alternativa administrativa equivalente.',steps:[['Histórico','lastlog','Registre último acesso.'],['Bloquear','usermod -L system-update','Bloqueie o hash de senha.'],['Remover shell','usermod -s /usr/sbin/nologin system-update','Impeça sessões interativas.']]},
  {name:'Expiração imediata',when:'Útil para desativação por política.',steps:[['Coletar','getent passwd system-update','Preserve a entrada da conta.'],['Expirar','chage -E 0 system-update','Expire imediatamente a identidade.']]},
  {name:'Remoção após coleta',when:'Destrutivo; use somente com autorização.',steps:[['Arquivar','tar -czf /root/incident/system-update-home.tgz /var/tmp/.update','Preserve artefatos.'],['Remover','userdel -r system-update','Exclua a conta e o diretório.']]},
  {name:'Atalho do simulador',when:'Resposta simplificada.',steps:[['Bloquear','lock system-update','Bloqueie conta e sessões.']]}
 ]},
 {title:'Processo malicioso PID 731',problem:'Colete contexto e interrompa unknown-worker. SIGTERM é preferível; SIGKILL é o último recurso.',methods:[
  {name:'Por PID',when:'Mais preciso quando o PID é conhecido.',steps:[['Inspecionar','ps aux | grep unknown-worker','Confirme usuário, consumo e comando.'],['Sockets','lsof -p 731','Registre arquivos e conexões.'],['Encerrar','kill 731','Envie encerramento normal.'],['Forçar','kill -9 731','Use apenas se continuar ativo.']]},
  {name:'Por nome',when:'Útil quando o processo reinicia com outro PID.',steps:[['Localizar','pgrep unknown-worker','Encontre a instância.'],['Encerrar','pkill unknown-worker','Interrompa pelo nome.']]},
  {name:'Via serviço',when:'Use quando o processo foi implantado como unidade.',steps:[['Estado','systemctl status unknown-worker','Inspecione a unidade.'],['Parar','systemctl stop unknown-worker','Interrompa o serviço.']]}
 ]},
 {title:'Arquivo de configuração alterado',problem:'Compare /etc/ssh/sshd_config com a cópia íntegra e restaure o arquivo.',methods:[
  {name:'cp a partir do backup',when:'Método direto.',steps:[['Comparar','diff /root/backups/sshd_config.clean /etc/ssh/sshd_config','Confirme as alterações.'],['Restaurar','cp /root/backups/sshd_config.clean /etc/ssh/sshd_config','Substitua pelo arquivo íntegro.'],['Validar','sshd -t','Teste a configuração.']]},
  {name:'install preservando modo',when:'Útil para definir proprietário e permissões.',steps:[['Restaurar','install -m 0644 /root/backups/sshd_config.clean /etc/ssh/sshd_config','Instale a cópia íntegra.']]},
  {name:'rsync',when:'Bom para fluxos automatizados.',steps:[['Sincronizar','rsync /root/backups/sshd_config.clean /etc/ssh/sshd_config','Restaure por sincronização.']]},
  {name:'Atalho do simulador',when:'Forma educacional.',steps:[['Restaurar','restore /etc/ssh/sshd_config','Recupere a configuração segura.']]}
 ]},
 {title:'Exfiltração para 198.51.100.42',problem:'Interrompa o tráfego de saída para o destino malicioso sem bloquear serviços legítimos.',methods:[
  {name:'iptables OUTPUT',when:'Regra específica por destino.',steps:[['Confirmar','ss -tulpn','Identifique a conexão e o processo.'],['Bloquear','iptables -I OUTPUT -d 198.51.100.42 -j DROP','Interrompa pacotes para o destino.'],['Validar','iptables -L -n -v','Confirme a regra.']]},
  {name:'nftables OUTPUT',when:'Método moderno.',steps:[['Conexões','lsof -i','Relacione processo e socket.'],['Bloquear','nft add rule inet filter output ip daddr 198.51.100.42 drop','Bloqueie o destino na cadeia output.']]},
  {name:'UFW de saída',when:'Interface simples.',steps:[['Bloquear','ufw deny out to 198.51.100.42','Negue conexões de saída.']]},
  {name:'Blackhole route',when:'Contenção emergencial de roteamento.',steps:[['Descartar rota','ip route add blackhole 198.51.100.42','Envie tráfego ao blackhole.']]},
  {name:'Atalho do simulador',when:'Resposta simplificada.',steps:[['Bloquear','block 198.51.100.42','Interrompa a exfiltração.']]}
 ]}
];
function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function request(url,opt){return fetch(url,opt).then(function(r){if(!r.ok)return r.text().then(function(t){throw new Error(t||('HTTP '+r.status))});return r.json()})}
function pad(n){return String(n).padStart(2,'0')}function formatTime(sec){sec=Math.max(0,sec||0);return pad(Math.floor(sec/60))+':'+pad(sec%60)}
function objectiveDone(i){return !!(state&&state.objectives&&state.objectives[i]&&state.objectives[i].done)}function objectiveActive(i){return !!(state&&state.objectives&&state.objectives[i]&&state.objectives[i].active)}
function threatResolved(t){for(var i=0;i<t.indices.length;i++)if(!objectiveDone(t.indices[i]))return false;return true}function threatActive(t){return state&&state.elapsed>=t.start&&!threatResolved(t)}
function activeCount(){var n=0;THREATS.forEach(function(t){if(threatActive(t))n++});return n}
function mailText(v){return String(v||'').replace(/\{\{nick\}\}/g,(state&&state.nick)||'novo administrador')}
function showInbox(){document.getElementById('mailStage').classList.remove('hidden');document.getElementById('sidebar').classList.add('hidden');document.getElementById('dashboardTop').classList.add('hidden');document.getElementById('dashboardApp').classList.add('hidden')}
function showDashboard(){document.getElementById('mailStage').classList.add('hidden');document.getElementById('sidebar').classList.remove('hidden');document.getElementById('dashboardTop').classList.remove('hidden');document.getElementById('dashboardApp').classList.remove('hidden')}
function getMail(id){for(var i=0;i<MAILS.length;i++)if(MAILS[i].id===id)return MAILS[i];return null}
function getEmailState(id){var rows=state&&state.inboxEmails||[];for(var i=0;i<rows.length;i++)if(rows[i].id===id)return rows[i];return null}
function arrivalLabel(es){var age=Math.max(0,(state&&state.elapsed||0)-(es.arrivedAt||0));if(age<8)return'agora';if(age<60)return'há '+age+'s';return'há '+Math.floor(age/60)+'min'}
function renderMailProgress(){var p=state&&state.inboxProgress||{};document.getElementById('progressDelivered').textContent=(p.delivered||0)+' / '+(p.total||MAILS.length);document.getElementById('progressRead').textContent=(p.read||0)+' / '+(p.total||MAILS.length);document.getElementById('progressActions').textContent=(p.safeActionsDone||0)+' / '+(p.safeActionsTotal||0);document.getElementById('progressFalse').textContent=(p.falseReports||0)+' / 3';var required=(p.total||0)+(p.safeActionsTotal||0)+(p.maliciousTotal||0),done=(p.read||0)+(p.safeActionsDone||0)+(p.maliciousReported||0);document.getElementById('mailProgressBar').style.width=(required?Math.round(done/required*100):0)+'%'}
function renderMailList(){var box=document.getElementById('mailItems'),html='',rows=state&&state.inboxEmails||[],unread=0;rows.slice().reverse().forEach(function(es){var m=getMail(es.id);if(!m)return;if(!es.read)unread++;var cls='mail-item'+(!es.read?' unread':'')+(m.id===selectedMail?' selected':'')+(es.reported?' reported':'')+(((state.elapsed||0)-es.arrivedAt)<7?' new-arrival':'');var status='';if(es.reported)status='<span class="mail-item-status reported">Reportado ao SOC</span>';else if(es.actionDone)status='<span class="mail-item-status done">Conteúdo acessado</span>';html+='<div class="'+cls+'" data-mail="'+esc(m.id)+'"><span class="mail-avatar">'+esc(m.avatar)+'</span><div class="mail-item-from">'+esc(m.from)+'</div><div class="mail-item-subject">'+esc(mailText(m.subject))+'</div><div class="mail-item-preview">'+esc(mailText(m.preview))+'</div>'+status+'<span class="mail-item-time">'+esc(arrivalLabel(es))+'</span></div>'});if(!html)html='<div style="padding:28px;text-align:center;color:#657f97;font-size:10px">Aguardando a chegada da primeira mensagem...</div>';box.innerHTML=html;document.getElementById('mailUnread').textContent=unread;var p=state&&state.inboxProgress||{};document.getElementById('mailCountLabel').textContent=(p.delivered||0)+' de '+(p.total||MAILS.length)+' recebidos · '+unread+' não lido'+(unread===1?'':'s');renderMailProgress()}
function renderSelectedMail(){var m=getMail(selectedMail),es=getEmailState(selectedMail),replyBtn=document.getElementById('replyMail'),reportBtn=document.getElementById('reportMail');if(!m||!es){document.getElementById('mailReaderHead').innerHTML='';document.getElementById('mailReaderBody').innerHTML='<div class="mail-reader-empty"><div><strong>Selecione uma mensagem</strong>Novos e-mails aparecem gradualmente. Mensagens não lidas ficam em destaque.</div></div>';replyBtn.disabled=true;reportBtn.disabled=true;return}replyBtn.disabled=false;reportBtn.disabled=!!es.reported;reportBtn.textContent=es.reported?'✓ Reportado ao SOC':'⚑ Reportar suspeita';var reply=m.reply?'<div class="mail-address">responder para: '+esc(m.reply)+'</div>':'';document.getElementById('mailReaderHead').innerHTML='<h2>'+esc(mailText(m.subject))+'</h2><div class="mail-sender-row"><div class="mail-sender-avatar">'+esc(m.avatar)+'</div><div class="mail-sender-copy"><strong>'+esc(m.from)+'</strong><div class="mail-address">'+esc(m.email)+'</div>'+reply+'</div></div>';var body=m.body.map(function(p,i){return i===1?'<div class="mail-callout">'+esc(mailText(p))+'</div>':'<p>'+esc(mailText(p))+'</p>'}).join('');var actionText=es.actionDone?'Abrir novamente — concluído ✓':m.action;body+='<button class="mail-action" id="mailAction" '+(es.reported&&!SAFE_PORTALS[m.id]?'disabled':'')+'>'+esc(actionText)+'</button><span class="mail-url">Destino exibido: '+esc(m.url)+'</span>';document.getElementById('mailReaderBody').innerHTML=body;var action=document.getElementById('mailAction');action.onclick=function(){clickMailAction(m.id)}}
function openMail(id){if(mailBusy)return;mailBusy=true;request('/api/phish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({emailId:id,action:'open'})}).then(function(r){selectedMail=id;routeState(r.state)}).catch(function(e){toast(e.message)}).finally(function(){mailBusy=false})}
function clickMailAction(id){if(mailBusy)return;mailBusy=true;request('/api/phish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({emailId:id,action:'click'})}).then(function(r){if(r.event==='incident'){closeSafePortal();document.getElementById('breachTransition').classList.remove('hidden');setTimeout(function(){document.getElementById('breachTransition').classList.add('hidden');output.innerHTML='';lastHistory=0;lastScore=0;ended=false;command.disabled=false;routeState(r.state)},1100);return}if(r.event==='already_reported'){toast('A mensagem já foi reportada e o link foi bloqueado.');routeState(r.state);return}routeState(r.state);if(SAFE_PORTALS[id]&&(r.state.phase==='inbox'||r.event.indexOf('safe_link')===0))openSafePortal(id)}).catch(function(e){toast(e.message)}).finally(function(){mailBusy=false})}
function openSafePortal(id){var p=SAFE_PORTALS[id];if(!p){toast('Conteúdo interno indisponível para esta mensagem.');return}document.getElementById('safePortalIcon').textContent=p.icon||'SI';document.getElementById('safePortalApp').textContent=p.app;document.getElementById('safePortalUrl').textContent=p.url;var note=typeof p.statusNote==='function'?p.statusNote():p.statusNote;document.getElementById('safePortalBody').innerHTML='<section class="portal-hero"><div class="portal-hero-copy"><div class="portal-eyebrow">'+esc(p.eyebrow)+'</div><h2 id="safePortalTitle">'+esc(p.title)+'</h2><p>'+esc(p.summary)+'</p></div><aside class="portal-status-card"><small>Situação</small><strong>'+esc(p.status)+'</strong><span>'+esc(note)+'</span></aside></section>'+p.html();document.getElementById('safePortal').classList.remove('hidden')}
function closeSafePortal(){document.getElementById('safePortal').classList.add('hidden')}
function safePortalAction(action){if(action==='training')toast('Módulo aberto no player interno. O progresso foi salvo na simulação.');else if(action==='draft')toast('Rascunho salvo no portal de Pessoas.');else if(action==='guide')toast('Guia marcado como lido no seu perfil.');else toast('Ação concluída no portal interno simulado.')}
function renderInbox(s){var previous=Object.keys(knownDelivered).length;state=s;started=true;showInbox();document.getElementById('inboxTimer').textContent=formatTime(s.inboxRemaining);(s.inboxEmails||[]).forEach(function(es){if(!knownDelivered[es.id]&&previous>0){var m=getMail(es.id);if(m)toast('Novo e-mail: '+mailText(m.subject))}knownDelivered[es.id]=true});if(selectedMail&&!getEmailState(selectedMail))selectedMail='';renderMailList();renderSelectedMail()}
function showMailResult(s){if(avoidanceShown)return;avoidanceShown=true;ended=true;var won=s.phase==='mail_won';document.getElementById('resultTitle').textContent=won?'TRIAGEM CONCLUÍDA':'FALHA NA TRIAGEM';document.getElementById('resultTitle').className=won?'green':'red';document.getElementById('resultText').textContent=s.inboxMessage||(won?'Todos os requisitos da caixa de entrada foram concluídos.':'O onboarding não foi concluído dentro das regras.');document.getElementById('resultScore').textContent=s.score.toLocaleString('pt-BR')+' pts · '+(won?'campanha bloqueada':'simulação encerrada');document.getElementById('resultIcon').textContent=won?'✓':'!';document.getElementById('resultModal').classList.remove('hidden')}
function routeState(s){state=s;started=true;if(s.phase==='inbox'){renderInbox(s);return}if(s.phase==='mail_won'||s.phase==='mail_failed'){showInbox();document.getElementById('inboxTimer').textContent='00:00';renderMailList();renderSelectedMail();showMailResult(s);return}showDashboard();render(s);setTimeout(function(){if(!ended)command.focus()},0)}
function reportSelectedMail(){var m=getMail(selectedMail);if(!m||mailBusy)return;mailBusy=true;request('/api/phish',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({emailId:m.id,action:'report'})}).then(function(r){routeState(r.state);if(r.event==='correct_report')toast('Indicadores confirmados. Mensagem enviada à quarentena.');else if(r.event==='false_report')toast('Falso positivo: mensagem legítima. '+r.state.inboxProgress.falseReports+'/3 erros.');else if(r.event==='already_reported')toast('Esta mensagem já foi reportada.');}).catch(function(e){toast(e.message)}).finally(function(){mailBusy=false})}
function promptPath(cwd){cwd=cwd||'/root';if(cwd==='/root')return'~';if(cwd.indexOf('/root/')===0)return'~'+cwd.slice(5);return cwd}
function addTerminalEntry(kind,text,at,cwd){var d=document.createElement('div');d.className='term-entry '+kind;var prefix=at?'<span class="term-time">['+esc(at)+']</span>':'';if(kind==='command'){var lines=String(text).split('\n');var first=lines.shift()||'';var cmd=first.replace(/^\$\s*/, '');d.innerHTML=prefix+'<span class="term-prompt">root@ubuntu-prod-01</span>:<span class="term-path">'+esc(promptPath(cwd||(state&&state.cwd)))+'</span># '+esc(cmd)+(lines.length?'\n'+esc(lines.join('\n')):'')}else d.innerHTML=prefix+esc(text);output.appendChild(d)}
function renderTerminalHistory(s){if(s.history.length<lastHistory){output.innerHTML='';lastHistory=0}for(var i=lastHistory;i<s.history.length;i++){var e=s.history[i];addTerminalEntry(e.kind,e.text,e.at,e.cwd)}lastHistory=s.history.length;terminal.scrollTop=terminal.scrollHeight}
function clearTerminal(){output.innerHTML='';if(state)lastHistory=state.history.length;terminal.scrollTop=terminal.scrollHeight}
function renderAlerts(){var box=document.getElementById('alertsList'),html='',count=0;var footholdDone=objectiveDone(0)&&objectiveDone(1);if(state.clickedEmail){if(!footholdDone)count++;html+='<div class="alert-card'+(footholdDone?' resolved':'')+'"><span class="alert-symbol">'+(footholdDone?'✓':'◆')+'</span><div class="alert-name">Credencial SSO comprometida</div><div class="alert-time">T+00:00</div><div class="alert-desc">Link de onboarding abriu a sessão inicial do atacante</div></div>'}THREATS.forEach(function(t){var active=threatActive(t),done=threatResolved(t),visible=state.elapsed>=t.start;if(!visible&&!done)return;if(active)count++;var cls=done?' resolved':(t.severity==='warning'?' warning':'');var status=done?'Neutralizado':(active?'Ativo':'Aguardando');var since=Math.max(0,state.elapsed-t.start);html+='<div class="alert-card'+cls+'"><span class="alert-symbol">'+(done?'✓':'◆')+'</span><div class="alert-name">'+esc(t.title)+'</div><div class="alert-time">'+(done?'resolvido':since+'s')+'</div><div class="alert-desc">'+esc(t.desc)+' · '+status+'</div></div>'});if(!html)html='<div style="padding:30px 8px;text-align:center;color:#637c94;font-size:10px">Nenhum alerta ativo.<br>A telemetria está sendo analisada.</div>';html+='<div class="alerts-footer" data-command="alerts">Ver todos os alertas →</div>';box.innerHTML=html;['alertCount','sideAlertCount','bellCount'].forEach(function(id){document.getElementById(id).textContent=count})}
function renderTimeline(){var html='<div class="timeline-item'+(state.completed?' done':'')+'"><div class="timeline-time">T+00:00</div><div class="timeline-node"></div><div class="timeline-copy"><strong>Initial Access · Phishing</strong><p>Token administrativo capturado pelo falso portal de onboarding</p></div></div>';THREATS.forEach(function(t){var startedNow=state.elapsed>=t.start,done=threatResolved(t),cls=done?' done':(!startedNow?' pending':'');html+='<div class="timeline-item'+cls+'"><div class="timeline-time">T+'+formatTime(t.start)+'</div><div class="timeline-node"></div><div class="timeline-copy"><strong>'+esc(t.timeline)+'</strong><p>'+esc(startedNow?t.detail:'Evento ainda não detectado')+'</p></div></div>'});document.getElementById('timeline').innerHTML=html}
function setGauge(id,value){value=Math.max(0,Math.min(100,Math.round(value)));var el=document.getElementById(id+'Gauge');el.style.setProperty('--value',(value*3.6)+'deg');document.getElementById(id+'Value').textContent=value+'%'}
var chartData={cpu:[],ram:[],net:[]};function pushChart(arr,v){arr.push(v);if(arr.length>42)arr.shift()}function renderResources(){var wobble=Math.sin(Date.now()/1400)*3;var cpu=objectiveActive(3)&&!objectiveDone(3)?78+wobble:15+wobble;var ram=objectiveActive(3)&&!objectiveDone(3)?64+wobble/2:42+wobble/3;var disk=objectiveActive(4)&&!objectiveDone(4)?45:23;var net=objectiveActive(5)&&!objectiveDone(5)?82+wobble:(objectiveActive(0)&&!objectiveDone(0)?56+wobble:18+wobble);setGauge('cpu',cpu);setGauge('ram',ram);setGauge('disk',disk);setGauge('net',net);document.getElementById('ramSub').textContent=Math.round(ram*5.12)+' / 512 MB';document.getElementById('netSub').textContent=Math.max(20,Math.round(net*2.1))+' Mbps';pushChart(chartData.cpu,cpu);pushChart(chartData.ram,ram);pushChart(chartData.net,net);drawChart()}
function drawChart(){var c=document.getElementById('resourceChart'),ctx=c.getContext('2d'),w=c.width,h=c.height;ctx.clearRect(0,0,w,h);ctx.strokeStyle='#132f49';ctx.lineWidth=1;for(var y=15;y<h;y+=22){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(w,y);ctx.stroke()}function line(data,color){if(data.length<2)return;ctx.beginPath();for(var i=0;i<data.length;i++){var x=i*(w/(Math.max(1,41))),y=h-(data[i]/100)*(h-8)-4;if(i===0)ctx.moveTo(x,y);else ctx.lineTo(x,y)}ctx.strokeStyle=color;ctx.lineWidth=1.4;ctx.stroke()}line(chartData.cpu,'#2d72ff');line(chartData.ram,'#e42a78');line(chartData.net,'#3bd471')}
function renderNetwork(){var exfil=objectiveActive(5)&&!objectiveDone(5),brute=objectiveActive(0)&&!objectiveDone(0);var attacker=document.getElementById('attackerNode'),fw=document.getElementById('firewallNode'),pulse=document.getElementById('netPulse');attacker.className='net-node attacker'+((state.elapsed>=15&&!brute&&!exfil)?' blocked':'');fw.className='net-node firewall'+((objectiveDone(0)||objectiveDone(5))?' blocked':'');document.getElementById('attackerIp').textContent=exfil?'198.51.100.42':'203.0.113.77';document.getElementById('attackerState').textContent=(brute||exfil)?'ATACANTE ATIVO':'ORIGEM CONTIDA';document.getElementById('firewallState').textContent=(objectiveDone(0)||objectiveDone(5))?'REGRA APLICADA':'MONITORANDO';pulse.className='net-pulse'+((brute||exfil)?'':' safe');pulse.style.display=state.elapsed>=15?'block':'none'}
function renderProcesses(){var malicious=objectiveActive(3)&&!objectiveDone(3);var rows=[malicious?['unknown-worker','731','48.2%','9.1%','danger']:['systemd-journald','312','0.8%','1.4%',''],['web-server','204','2.0%','4.8%',''],['sshd','101','0.3%','1.2%',''],['systemd','1','0.1%','0.7%','']];var h='<div class="process-head"><span>Processo</span><span>PID</span><span>CPU</span><span>MEM</span></div>';rows.forEach(function(r){h+='<div class="process-row '+r[4]+'" data-command="'+(r[0]==='unknown-worker'?'ps aux | grep unknown-worker':'ps aux')+'"><span class="process-name"><i class="proc-dot">'+(r[4]?'✕':'▣')+'</i>'+esc(r[0])+'</span><span>'+r[1]+'</span><span>'+r[2]+'</span><span>'+r[3]+'</span></div>'});h+='<div class="process-footer" data-command="ps aux --sort=-%cpu">Ver todos os processos →</div>';document.getElementById('processTable').innerHTML=h}
function levelForEntry(e){var t=(e.text||'').toLowerCase();if(e.kind==='danger'||t.indexOf('alerta:')>=0||t.indexOf('comprometido')>=0)return'critical';if(e.kind==='success'||t.indexOf('[ok]')>=0||t.indexOf('protegido')>=0)return'success';if(e.kind==='info'||t.indexOf('aviso')>=0||t.indexOf('failed')>=0)return'warning';return'normal'}
function renderLogs(){var rows=(state.history||[]).slice(-12).reverse(),html='';rows.forEach(function(e){var lvl=levelForEntry(e);if(logFilter!=='all'&&lvl!==logFilter)return;var text=(e.text||'').replace(/^\$\s*/,'').replace(/\n/g,' · ');if(text.length>120)text=text.slice(0,117)+'...';var label=lvl==='critical'?'CRÍTICO':lvl==='warning'?'AVISO':lvl==='success'?'OK':'INFO';html+='<div class="log-row '+lvl+'"><span>'+(e.at||'--:--')+'</span><span class="log-level">'+label+'</span><span>'+esc(text)+'</span></div>'});if(!html)html='<div style="padding:20px;text-align:center;color:#647d95;font-size:9px">Nenhum log nesta categoria.</div>';document.getElementById('recentLogs').innerHTML=html}
function renderIntel(){var bruteDone=objectiveDone(0),exfilDone=objectiveDone(5),procDone=objectiveDone(3);var rows=[['203.0.113.77','IP','Brute Force / SSH','98%',bruteDone?'Bloqueado':'Bloquear',bruteDone],['198.51.100.42','IP','C2 / Exfiltração','99%',exfilDone?'Bloqueado':'Bloquear',exfilDone],['unknown-worker','Arquivo','Backdoor Linux','99%',procDone?'Removido':'Remover',procDone],['system-update','Conta','Persistência','96%',objectiveDone(2)?'Bloqueada':'Conter',objectiveDone(2)]];var h='<div class="intel-head"><span>IOC / IP</span><span>Tipo</span><span>Ameaça</span><span>Conf.</span><span>Ação</span></div>';rows.forEach(function(r){h+='<div class="intel-row"><span class="ioc"><i class="ioc-icon">◎</i>'+esc(r[0])+'</span><span>'+r[1]+'</span><span>'+r[2]+'</span><span>'+r[3]+'</span><span><i class="action-dot '+(r[5]?'green':'')+'"></i>'+r[4]+'</span></div>'});document.getElementById('intelTable').innerHTML=h}
function currentRunbookIndex(){if(!state||state.elapsed<15)return 0;if(!objectiveDone(0)||!objectiveDone(1))return 1;if(!objectiveDone(2))return 2;if(!objectiveDone(3))return 3;if(!objectiveDone(4))return 4;if(!objectiveDone(5))return 5;return 5}
function renderMissions(){var done=0,h='';state.objectives.forEach(function(o,i){if(o.done)done++;var cls=o.done?' done':(o.active?' active':'');h+='<div class="mission-item'+cls+'"><span class="mission-check">'+(o.done?'✓':'')+'</span><span>'+esc(o.name)+'</span></div>'});document.getElementById('missionList').innerHTML=h;var pct=state.objectives.length?Math.round(done/state.objectives.length*100):0;document.getElementById('missionProgress').style.width=pct+'%';document.getElementById('topProgress').style.width=pct+'%';document.getElementById('progressText').textContent=pct+'%';document.getElementById('doneCount').textContent=done;var rb=RUNBOOKS[currentRunbookIndex()];document.getElementById('quickTitle').textContent=rb.title;var steps=[];rb.methods.forEach(function(m){m.steps.forEach(function(s){if(steps.length<3)steps.push(s)})});document.getElementById('quickSteps').innerHTML=steps.map(function(s){return'<div class="quick-step"><strong>'+esc(s[0])+'</strong><p>'+esc(s[2])+'</p><button class="command-chip" data-command="'+esc(s[1])+'">'+esc(s[1])+'</button></div>'}).join('')}
function renderRunbook(){var idx=currentRunbookIndex(),rb=RUNBOOKS[idx];var h='<div class="runbook-intro"><strong style="display:block;color:#dceaf6;margin-bottom:5px">'+esc(rb.title)+'</strong>'+esc(rb.problem)+'</div>';rb.methods.forEach(function(m,i){h+='<details class="method" '+(i===0?'open':'')+'><summary>'+esc(m.name)+'</summary><div class="method-body"><div class="method-when">'+esc(m.when)+'</div>';m.steps.forEach(function(s,n){h+='<div class="method-step"><strong>Passo '+(n+1)+' — '+esc(s[0])+'</strong><button class="command-chip" data-command="'+esc(s[1])+'">'+esc(s[1])+'</button><p>'+esc(s[2])+'</p></div>'});h+='</div></details>'});document.getElementById('runbookBody').innerHTML=h}
function renderHeader(){document.getElementById('missionTimer').textContent=formatTime(state.timeRemaining);document.getElementById('scoreValue').textContent=state.score.toLocaleString('pt-BR');var delta=state.score-lastScore;document.getElementById('scoreDelta').textContent=(delta>=0?'+':'')+delta;lastScore=state.score;var count=activeCount();var title=document.getElementById('attackTitle'),sub=document.getElementById('attackSub');if(state.completed){title.textContent='SEGURO';sub.textContent='INCIDENTE ENCERRADO'}else if(count>=3||state.threatLevel==='CRÍTICO'){title.textContent='CRÍTICO';sub.textContent='SERVIDOR SOB ATAQUE'}else if(count){title.textContent=state.threatLevel;sub.textContent=count+' AMEAÇA(S) ATIVA(S)'}else{title.textContent='MONITORANDO';sub.textContent='SEM AMEAÇAS ATIVAS'}document.getElementById('nickLabel').textContent=state.nick}
function render(s){state=s;started=true;document.getElementById('currentPath').textContent=promptPath(s.cwd);renderHeader();renderAlerts();renderTimeline();renderResources();renderNetwork();renderProcesses();renderLogs();renderIntel();renderMissions();renderRunbook();renderTerminalHistory(s);if(!ended&&(s.completed||s.failed)){ended=true;command.disabled=true;document.getElementById('resultTitle').textContent=s.completed?'SERVIDOR PROTEGIDO':'SISTEMA COMPROMETIDO';document.getElementById('resultTitle').className=s.completed?'green':'red';document.getElementById('resultText').textContent=s.completed?'Todas as ameaças foram neutralizadas com sucesso.':'O tempo ou a integridade do host chegou ao limite.';document.getElementById('resultScore').textContent=s.score.toLocaleString('pt-BR')+' pts · '+s.integrity+'% integridade';document.getElementById('resultIcon').textContent=s.completed?'✓':'!';document.getElementById('resultModal').classList.remove('hidden')}}
function send(cmd){cmd=String(cmd||'').trim();if(!cmd||busy||ended)return;if(history[history.length-1]!==cmd)history.push(cmd);if(history.length>100)history.shift();historyIndex=history.length;historyDraft='';busy=true;command.disabled=true;request('/api/command',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({command:cmd})}).then(function(r){if(r.output==='__CLEAR__'){output.innerHTML='';lastHistory=r.state.history.length}routeState(r.state)}).catch(function(e){addTerminalEntry('danger','Erro: '+e.message,'local')}).finally(function(){busy=false;if(!ended){command.disabled=false;command.focus()}terminal.scrollTop=terminal.scrollHeight})}
function toast(msg){var t=document.getElementById('toast');t.textContent=msg;t.classList.add('show');setTimeout(function(){t.classList.remove('show')},1800)}
function fillAndFocus(cmd){command.value=cmd;command.focus();command.setSelectionRange(command.value.length,command.value.length);terminal.scrollTop=terminal.scrollHeight;toast('Comando carregado no terminal')}
function openRunbook(){renderRunbook();document.getElementById('overlay').classList.add('open');document.getElementById('runbookDrawer').classList.add('open')}function closeRunbook(){document.getElementById('overlay').classList.remove('open');document.getElementById('runbookDrawer').classList.remove('open')}
function openRanking(){request('/api/ranking').then(function(rows){var h='';if(!rows.length)h='<div style="padding:25px;text-align:center;color:#6f879e">Nenhuma partida concluída.</div>';rows.forEach(function(r,i){h+='<div class="rank-row"><span>'+(i+1)+'</span><span>'+esc(r.nick)+'</span><span>'+r.score+' pts</span></div>'});document.getElementById('rankingList').innerHTML=h;document.getElementById('rankingModal').classList.remove('hidden')})}
function startGame(){var nick=document.getElementById('nick').value;request('/api/start',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({nick:nick})}).then(function(){document.getElementById('startModal').classList.add('hidden');output.innerHTML='';lastHistory=0;lastScore=0;ended=false;avoidanceShown=false;knownDelivered={};selectedMail='';command.disabled=true;return request('/api/state')}).then(routeState).catch(function(e){toast(e.message)})}
function commonPrefix(items){if(!items.length)return'';var p=items[0];for(var i=1;i<items.length;i++){while(items[i].slice(0,p.length)!==p&&p.length)p=p.slice(0,-1)}return p}
function candidates(before,tokens){var first=tokens[0]||'';if(first==='sudo')first=tokens[1]||'';if(tokens.length===1&&!/\s$/.test(before))return COMMANDS;if(first==='help')return CATEGORIES;if(first==='man'||first==='which'||first==='type')return COMMANDS;if(first==='systemctl')return ['status','list-units','is-active','restart','stop','start','ssh','unknown-worker'];if(first==='service')return ['--status-all','ssh','web'];if(first==='id'||first==='groups'||first==='passwd'||first==='usermod'||first==='lock'||first==='chage'||first==='userdel')return USERS;if(first==='block'||first==='ping'||first==='traceroute')return IPS;if(first==='kill')return ['731','101','204','-9'];if(first==='pkill'||first==='killall'||first==='pgrep'||first==='pidof')return ['unknown-worker','sshd','web-server'];if(['cat','less','more','head','tail','stat','file','sha256sum','md5sum','restore','cp','grep','diff','cmp','install','rsync'].indexOf(first)>=0)return PATHS;if(first==='patch')return ['ssh'];if(first==='ip')return ['addr','route','neigh','route add blackhole 198.51.100.42'];if(first==='iptables')return ['-L -n -v','-I INPUT -s 203.0.113.77 -j DROP','-I OUTPUT -d 198.51.100.42 -j DROP'];if(first==='ufw')return ['status','deny from 203.0.113.77','deny out to 198.51.100.42'];if(first==='apt'||first==='apt-get')return ['update','list','install --only-upgrade openssh-server'];return COMMANDS}
function complete(){
 var value=command.value,cursor=command.selectionStart==null?value.length:command.selectionStart;
 if(!started||!state||state.phase!=='incident'||completeBusy)return;
 completeBusy=true;
 request('/api/complete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({line:value,cursor:cursor})}).then(function(r){
  if(command.value!==value||(command.selectionStart==null?command.value.length:command.selectionStart)!==cursor)return;
  var items=r.items||[],matches=items.map(function(x){return x.value});
  if(!matches.length){lastTabKey='';return}
  function replace(v,space){command.value=value.slice(0,r.start)+v+(space?' ':'')+value.slice(r.end);var p=r.start+v.length+(space?1:0);command.setSelectionRange(p,p)}
  if(items.length===1){replace(items[0].value,!items[0].dir);lastTabKey='';return}
  var prefix=commonPrefix(matches);
  if(prefix.length>(r.current||'').length){replace(prefix,false);lastTabKey='';return}
  var key=value+'|'+cursor,now=Date.now();
  if(lastTabKey===key&&now-lastTabAt<1500){var grid=document.createElement('div');grid.className='completion-grid';items.forEach(function(item){var el=document.createElement('span');el.textContent=item.value;grid.appendChild(el)});output.appendChild(grid);terminal.scrollTop=terminal.scrollHeight;lastTabKey=''}else{lastTabKey=key;lastTabAt=now}
 }).catch(function(){lastTabKey=''}).finally(function(){completeBusy=false;command.focus()})
}
function handleDelegatedClick(e){var mail=e.target.closest('[data-mail]');if(mail){openMail(mail.getAttribute('data-mail'));return}var cmd=e.target.closest('[data-command]');if(cmd){fillAndFocus(cmd.getAttribute('data-command'));return}var scroll=e.target.closest('[data-scroll]');if(scroll){var el=document.getElementById(scroll.getAttribute('data-scroll'));if(el)el.scrollIntoView({block:'start'});document.getElementById('sidebar').classList.remove('open')}}
document.addEventListener('click',handleDelegatedClick);document.addEventListener('click',function(e){var action=e.target.closest('[data-safe-action]');if(action)safePortalAction(action.getAttribute('data-safe-action'))});document.getElementById('closeSafePortal').onclick=closeSafePortal;document.getElementById('backToMail').onclick=closeSafePortal;document.getElementById('safePortal').onclick=function(e){if(e.target===this)closeSafePortal()};document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!document.getElementById('safePortal').classList.contains('hidden'))closeSafePortal()});document.getElementById('reportMail').onclick=reportSelectedMail;document.getElementById('replyMail').onclick=function(){toast('Resposta simulada: nenhuma mensagem foi enviada.')};document.getElementById('startBtn').onclick=startGame;document.getElementById('nick').onkeydown=function(e){if(e.key==='Enter')startGame()};document.getElementById('clearBtn').onclick=function(){send('clear')};document.getElementById('maxBtn').onclick=function(){document.getElementById('terminalPanel').classList.toggle('terminal-max');command.focus()};document.getElementById('runbookBtn').onclick=openRunbook;document.getElementById('fullRunbookBtn').onclick=openRunbook;document.getElementById('openRunbookNav').onclick=openRunbook;document.getElementById('closeRunbook').onclick=closeRunbook;document.getElementById('overlay').onclick=closeRunbook;document.getElementById('rankingNav').onclick=openRanking;document.getElementById('resultRanking').onclick=function(){document.getElementById('resultModal').classList.add('hidden');openRanking()};document.getElementById('closeRanking').onclick=function(){document.getElementById('rankingModal').classList.add('hidden')};document.getElementById('restartBtn').onclick=function(){location.reload()};document.getElementById('quitGame').onclick=function(){location.reload()};document.getElementById('menuToggle').onclick=function(){document.getElementById('sidebar').classList.toggle('open')};document.getElementById('reportNav').onclick=function(){if(!state)return;var done=state.objectives.filter(function(o){return o.done}).length;toast('Relatório: '+done+'/6 objetivos, '+state.score+' pontos, '+state.integrity+'% de integridade')};
document.querySelectorAll('.filter-chip').forEach(function(b){b.onclick=function(){document.querySelectorAll('.filter-chip').forEach(function(x){x.classList.remove('active')});b.classList.add('active');logFilter=b.getAttribute('data-filter');if(state)renderLogs()}});
command.addEventListener('input',function(){lastTabKey=''});command.addEventListener('keydown',function(e){if(e.key==='Enter'){e.preventDefault();var v=command.value;command.value='';send(v)}else if(e.key==='Tab'){e.preventDefault();complete()}else if(e.key==='ArrowUp'){e.preventDefault();if(!history.length)return;if(historyIndex===history.length)historyDraft=command.value;if(historyIndex>0)historyIndex--;command.value=history[historyIndex]||'';command.setSelectionRange(command.value.length,command.value.length)}else if(e.key==='ArrowDown'){e.preventDefault();if(!history.length)return;if(historyIndex<history.length-1){historyIndex++;command.value=history[historyIndex]}else{historyIndex=history.length;command.value=historyDraft}command.setSelectionRange(command.value.length,command.value.length)}else if(e.ctrlKey&&(e.key==='l'||e.key==='L')){e.preventDefault();command.value='';send('clear')}else if(e.ctrlKey&&(e.key==='c'||e.key==='C')){e.preventDefault();command.value='';addTerminalEntry('command','$ ^C','local',state&&state.cwd)}});terminal.onclick=function(e){if(e.target!==command&&!window.getSelection().toString())command.focus()};
function poll(){if(started&&!ended)request('/api/state').then(routeState).catch(function(){});setTimeout(poll,1000)}
request('/api/state').then(function(s){document.getElementById('startModal').classList.add('hidden');routeState(s)}).catch(function(){});poll();
})();
</script>
</body>
</html>`
EOF_GO

# Aplica a identidade e a versão centralizadas.
# Os domínios linux.d e os domínios .test são endereços fictícios usados
# pela simulação de phishing; permanecem intactos para não quebrar o cenário.
sed -i \
  -e "s|GAME SI|${GAME_NAME}|g" \
  -e "s|Linux.d|${COMPANY_NAME}|g" \
  -e "s|v10.0|v${GAME_VERSION}|g" \
  -e "s|appVersion    = \"10.0.0\"|appVersion    = \"${GAME_VERSION}\"|" \
  -e "s|addr = \"127.0.0.1:8080\"|addr = \"127.0.0.1:${APP_PORT}\"|" \
  "${SRC_DIR}/main.go"

# Uma compilação simples de Go costuma caber, mas em VPS de 512 MB a instalação de
# pacotes e o compilador podem disputar memória. A swap abaixo é somente temporária.
if [[ "${CREATE_TEMP_SWAP}" == "1" ]] && [[ "$(awk '/SwapTotal/ {print $2}' /proc/meminfo)" -eq 0 ]]; then
  AVAILABLE_KB="$(df -Pk / | awk 'NR==2 {print $4}')"
  if (( AVAILABLE_KB > 750000 )) && command -v mkswap >/dev/null 2>&1 && command -v swapon >/dev/null 2>&1; then
    log "Sem swap detectada; tentando criar 384 MB temporários para a compilação..."
    rm -f "${TEMP_SWAP_FILE}"
    if command -v fallocate >/dev/null 2>&1; then
      fallocate -l 384M "${TEMP_SWAP_FILE}" || true
    fi
    if [[ ! -s "${TEMP_SWAP_FILE}" ]]; then
      dd if=/dev/zero of="${TEMP_SWAP_FILE}" bs=1M count=384 status=none || true
    fi
    if [[ -s "${TEMP_SWAP_FILE}" ]]; then
      chmod 600 "${TEMP_SWAP_FILE}"
      if mkswap "${TEMP_SWAP_FILE}" >/dev/null 2>&1 && swapon "${TEMP_SWAP_FILE}" 2>/dev/null; then
        TEMP_SWAP_CREATED=1
        ok "Swap temporária ativada."
      else
        rm -f "${TEMP_SWAP_FILE}"
        warn "O provedor não permitiu ativar swap; continuando sem ela."
      fi
    fi
  fi
fi

log "Compilando o jogo com baixo consumo de memória..."
(
  cd "${SRC_DIR}"
  GOMAXPROCS=1 GOGC=20 GO111MODULE=off CGO_ENABLED=0 \
    go build -trimpath -ldflags="-s -w" -o "${BIN_PATH}" main.go
)
chmod 0755 "${BIN_PATH}"
chown root:root "${BIN_PATH}"

log "Executando autoteste obrigatório do motor virtual..."
"${BIN_PATH}" --self-test || die "O binário falhou no autoteste e não será instalado."
ok "Autoteste do terminal virtual aprovado."

# Remove binários antigos somente após o novo binário ter sido validado.
find "${APP_DIR}" -maxdepth 1 -type f -name "${APP_NAME}" -delete 2>/dev/null || true
find "${APP_DIR}" -maxdepth 1 -type f -name "${APP_NAME}-v[0-9]*" ! -name "$(basename "${BIN_PATH}")" -delete 2>/dev/null || true

cat > "${SERVICE_FILE}" <<EOF_SERVICE
[Unit]
Description=${GAME_NAME} - simulador educacional de defesa Linux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_GROUP}
WorkingDirectory=${APP_DIR}
ExecStart=${BIN_PATH}
Environment=LISTEN_ADDR=127.0.0.1:${APP_PORT}
Environment=DATA_DIR=/var/lib/${APP_NAME}
Environment=GOMEMLIMIT=96MiB
Environment=GOGC=50
Restart=on-failure
RestartSec=3

# Limites apropriados para VPS de 512 MB
MemoryHigh=96M
MemoryMax=128M
TasksMax=64
LimitNOFILE=1024

# Isolamento do serviço
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
StateDirectory=${APP_NAME}
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
EOF_SERVICE

cat > "/usr/local/sbin/uninstall-${APP_NAME}" <<EOF_UNINSTALL
#!/usr/bin/env bash
set -e
systemctl disable --now ${APP_NAME}.service 2>/dev/null || true
rm -f ${SERVICE_FILE}
rm -f /etc/nginx/sites-enabled/${APP_NAME} /etc/nginx/sites-available/${APP_NAME}
systemctl reload nginx 2>/dev/null || true
systemctl daemon-reload
rm -rf ${APP_DIR}
userdel ${APP_USER} 2>/dev/null || true
groupdel ${APP_GROUP} 2>/dev/null || true
echo "Aplicação removida. O ranking foi preservado em /var/lib/${APP_NAME}."
echo "Para apagá-lo: rm -rf /var/lib/${APP_NAME}"
EOF_UNINSTALL
chmod 0755 "/usr/local/sbin/uninstall-${APP_NAME}"

# Configura o Nginx como proxy reverso: Internet:${PUBLIC_PORT} -> aplicação local:${APP_PORT}.
NGINX_SITE="/etc/nginx/sites-available/${APP_NAME}"
NGINX_LINK="/etc/nginx/sites-enabled/${APP_NAME}"
# Desativa somente o site padrão empacotado pelo Debian, se ainda estiver habilitado.
if [[ -L /etc/nginx/sites-enabled/default ]] && [[ "$(readlink -f /etc/nginx/sites-enabled/default 2>/dev/null || true)" == "/etc/nginx/sites-available/default" ]]; then
  rm -f /etc/nginx/sites-enabled/default
fi
if grep -RqsE "listen[[:space:]].*${PUBLIC_PORT}.*default_server" \
    --exclude="${APP_NAME}" /etc/nginx/sites-enabled /etc/nginx/conf.d 2>/dev/null; then
  die "Já existe um site Nginx configurado como default_server na porta 80. Ajuste esse site antes de continuar."
fi

cat > "${NGINX_SITE}" <<EOF_NGINX
server {
    listen ${PUBLIC_PORT} default_server;
    listen [::]:${PUBLIC_PORT} default_server;
    server_name ${GAME_DOMAIN};

    server_tokens off;
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:${APP_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:${APP_PORT}/healthz;
        access_log off;
    }
}
EOF_NGINX

ln -sfn "${NGINX_SITE}" "${NGINX_LINK}"
nginx -t || die "A configuração do Nginx é inválida."

systemctl daemon-reload
systemctl enable --now "${APP_NAME}.service"
systemctl enable --now nginx
systemctl reload nginx
sleep 2

if ! systemctl is-active --quiet "${APP_NAME}.service"; then
  systemctl status "${APP_NAME}.service" --no-pager || true
  journalctl -u "${APP_NAME}.service" -n 50 --no-pager || true
  die "O serviço do jogo não iniciou. Veja os logs acima."
fi
if ! systemctl is-active --quiet nginx; then
  systemctl status nginx --no-pager || true
  journalctl -u nginx -n 50 --no-pager || true
  die "O Nginx não iniciou. Veja os logs acima."
fi

# Libera HTTP e HTTPS no UFW quando ele estiver instalado e ativo.
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
  ufw allow 80/tcp || warn "Não foi possível liberar TCP/80 no UFW."
  ufw allow 443/tcp || warn "Não foi possível liberar TCP/443 no UFW."
fi

if ! curl --fail --silent --show-error --max-time 8 http://127.0.0.1:${PUBLIC_PORT}/healthz >/dev/null; then
  die "O teste HTTP pela porta ${PUBLIC_PORT} falhou. Verifique: journalctl -u nginx -u ${APP_NAME} -n 80."
fi

log "Solicitando certificado TLS gratuito à Let's Encrypt para ${GAME_DOMAIN}..."
if [[ -n "${CERTBOT_EMAIL}" ]]; then
  certbot --nginx --non-interactive --agree-tos --redirect --email "${CERTBOT_EMAIL}" -d "${GAME_DOMAIN}" || die "Não foi possível emitir o certificado. Confira DNS, portas 80/443 e tente novamente."
else
  certbot --nginx --non-interactive --agree-tos --redirect --register-unsafely-without-email -d "${GAME_DOMAIN}" || die "Não foi possível emitir o certificado. Confira DNS, portas 80/443 e tente novamente."
fi

nginx -t || die "A configuração HTTPS do Nginx é inválida."
systemctl reload nginx
systemctl enable --now certbot.timer 2>/dev/null || true

log "Validando renovação automática dos certificados..."
certbot renew --dry-run || warn "O teste de renovação falhou; confira systemctl status certbot.timer e certbot renew --dry-run."

if ! curl --fail --silent --show-error --max-time 10 "https://${GAME_DOMAIN}/healthz" >/dev/null; then
  die "O teste HTTPS falhou. Verifique DNS, firewall e: journalctl -u nginx -n 80."
fi

IP_LIST="$(hostname -I 2>/dev/null | xargs || true)"
ok "${GAME_NAME} v${GAME_VERSION} instalado com HTTPS e renovação automática."
printf '\nAcesse pelo navegador:\n'
printf '  https://%s\n' "${GAME_DOMAIN}"
printf '  HTTP será redirecionado automaticamente para HTTPS.\n'
printf '\nA aplicação escuta apenas em 127.0.0.1:%s; o Nginx recebe conexões públicas nas portas 80 e 443.\n' "${APP_PORT}"
printf '\nComandos úteis:\n'
printf '  systemctl status %s\n' "${APP_NAME}"
printf '  systemctl status nginx\n'
printf '  %s --self-test\n' "${BIN_PATH}"
printf '  journalctl -u %s -f\n' "${APP_NAME}"
printf '  journalctl -u nginx -f\n'
printf '  systemd-cgtop\n'
printf '  /usr/local/sbin/uninstall-%s\n\n' "${APP_NAME}"
printf 'Se houver firewall externo no painel da VPS, libere TCP/80 e TCP/443.\n'
printf 'Renovação automática: systemctl status certbot.timer\n'
printf 'Teste manual de renovação: certbot renew --dry-run\n'
