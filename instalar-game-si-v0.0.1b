 <div class="top-stats">
  <div class="top-stat"><div class="top-stat-icon">◴</div><div><small>Tempo da missão</small><strong id="missionTimer">05:00</strong></div></div>
  <div class="top-stat"><div class="top-stat-icon green">♨</div><div><small>Score atual</small><strong><span id="scoreValue">0</span> <span style="font-size:10px;color:#8599ae">pts</span></strong><span class="delta" id="scoreDelta">+0</span></div></div>
  <div class="top-stat"><div class="top-stat-icon">✓</div><div style="width:100%"><small>Missões concluídas</small><strong><span id="doneCount">0</span> / 6</strong><div class="progress-mini"><span id="topProgress"></span></div></div></div>
